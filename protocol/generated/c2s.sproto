req_cheat_duck_market_gacha 14218 { 	# 黄鸭集市作弊抽取
    request {
        act_id 0 : integer              # 活动id
        gacha_type 1 : integer          # 抽取类型: 1-普通抽取 2-道具抽取
    }

    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        effect 1 : integer      # 楼层升降效果: 1-升1层 2-升2层 3-升3层 4-降1层 5-降2层
        floor 2 : integer       # 当前楼层
        is_down 3 : boolean     # 是否触发过降层效果
        is_protect 4 : boolean  # 是否触发降层保护
        protect_num 5 : integer # 降层保护次数
        star 6 : integer        # 获得的星星数（普通奖池登顶时才有）
        cost_item_cnt 7 : integer # 累计消耗的道具数量
    }
}

