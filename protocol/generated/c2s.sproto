req_brawl_war_player_record 17503 {                 # 玩家历史排名数据
    request {
        index 0 : integer                           # 请求的起始索引(从1开始，每次下发10条，历史总条数)
        overview 1: boolean                         # 是否需要总览数据
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        total_count 1: integer                      # 对局次数， overview = true时会下发
        first_count 2: integer                      # 第一名次数 overview = true时会下发
        total_rank 3: integer                       # 名次总和 overview = true时会下发

        .record_cell {
            enter_ts 0: integer         # 进入战场的时间
            self_rank 1 : integer       # 自己的排名
            self_score 2 : integer(0)   # 自己的积分

            .rank_cell {              # 排行榜数据
                uid 0 : integer       # 玩家uid
                hero_gen 1: integer   # 英雄代数
                score_detail 2: *pair_int_int()  # 积分详情 1-总分 3-占领 4-采集 5-空投

            }
            rank_data 3 : *rank_cell    # 排名列表
            mode 4: integer       # 匹配模式 1.随机匹配 2.匹配同代数
        }
        records 4 : *record_cell                    # 历史数据
    }
}

