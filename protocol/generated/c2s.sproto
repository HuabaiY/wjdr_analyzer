loginauth 1 {
    request {
        sdkToken 0 : string         # sdkToken
        account 1 : string          # 账号
        serverid 2 : integer        # 服务器ID
        version 3 : string          # 游戏版本号, 需要服务器返回版本信息时填写
        uid 4 : integer             # 游戏角色ID
        is_create 5: boolean        # 是否创建新角色， 新建角色时打开此标记 serverid 需填写
        group 6: integer            # 用户组 ( 0: debug 1: diandain_sdk )
        device 7 : string           # 设备名称
        device_os 8 : string        # 操作系统
        ip 9 : string               # IP
        country_code 10 : string    # 国家地区代码
        distinct_id 11 : string     # TA 访客ID
        origin_serverid 12: integer # 该account下第一个角色服务器ID（废弃）
        lan 13 : string             # 语言，如果游戏内未设置过语言就使用这个语言
        is_simulator 14 : boolean   # 是否模拟器
        source_player_info 15 : source_player_info  # 创建新角色时的来源玩家信息
        operator_type 16 : integer  # 登录方式
        h5_device_type 17 : string  # h5设备类型 非h5传nil
        package_tag 18 : string     # tag
        ts 19 : integer(0)          # 时间戳(秒)
        sign 20 : string            # 签名
        scene_value 21 : string     # 场景值
        ad_source 22 : string       # adgame渠道
        device_id 23 : string       # 设备唯一id(字符串, 可能为空)
        dy_content_id 24 : string   # 抖音feed直流登录的content_id， 可以为空
        inner_permission_account  25 : string     # 内网权限用户名(仅内网环境使用)
        inner_permission_password 26 : string     # 内网权限用户密码(仅内网环境使用)
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer                    # 返回码
        serverid 1 : integer                # 服务器ID
        block_endtime 2 : integer           # 角色封停结束时间
        uid 3 : integer                     # 游戏角色ID
        is_new 4: boolean                   # 是否新角色
        is_first_role 5 : boolean           # 是否第一个角色
        role_list 6 : *role_info            # 如果被封角色，会返回角色列表
        server_list 7 : *server_info(id)    # 如果被封角色，会返回王国列表

        del_account_ts 8 : integer          # 删除账号时间戳

        .client_version {
            appVersion 0 : string
            resVersion 1 : string
        }

        version_info 9 : client_version #填写device_os，version后返回
        block_reason 10 : integer # 封号原因
        block_create_role_endtime 11 : integer(0)
        show_privacy_policy 12 : integer # 显示隐私政策类型 0-不显示 1-新号 2-旧号

        server_ts 13 : integer              # 服务器当前时间
        secret_key 14 : binary   # 秘钥
        first_role_ts 15 : integer          # 首角色创建时间
        crypt_method 16 : integer           # nil: 不加密, 1: XOR, 2: RC4
        is_create_by_old_role 17 : boolean  # 是否旧角色创建的新角色

        .inner_permission {
            watermark     0 : boolean # 是否允许去水印 
            cheat_allowed 1 : boolean # 是否允许作弊
            watermark_state 2 : boolean # 当前是否去水印
        }
        inner_permissions 18 : inner_permission # 内网权限
    }
}



