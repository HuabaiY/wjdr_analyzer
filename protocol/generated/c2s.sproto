req_alliance_triangle_war_get_history 15943 { 	# 获取历史数据
	request {
		start 0 : integer # 开始编号(nil默认从最新一条开始发送)
		count 1 : integer # 条数(nil默认20条)
	}

	response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0 : integer
		.history {
			index 0 : integer # 编号
            .camp_data { #  三个阵营数据
                aid 0 : integer(0)
                kid 1 : integer
                camp 2 : integer # 阵营
				score 3 : integer # 积分
				legion 4 : integer # 军团编号
                abbr 5 : string # 简称
                aname 6 : string # 全称
                flag 7: integer # 旗帜
                flag_bg 8 : integer # 旗帜背景
            }
            camps 1 : *camp_data
			starttime 2 : integer(0) # 开始时间
            endtime 3 : integer(0) # 结束时间
			.mvp_data {
                uid 0 : integer
                aid 1 : integer(0)
                name 2 : string
                image 3 : integer
                upload_image 4 : string
                
            }
			mvp 4 : mvp_data # mvp数据
            .player_score {
				uid 0 : integer
				values 1 : *integer(0) # 玩家分数，格式:{分数, 是否替补}, 第二个值默认nil,1表示替补
			}
			score_map 5 : *player_score() # 玩家得分情况, 旧数据是nil
		}
		list 1 : *history # 历史数据列表
	}
}

