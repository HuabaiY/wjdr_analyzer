.world_extra_march {
    value 0 : integer #buff数值
}


.alliance_situation_target { # 联盟军情目标点
    type 0 : integer # 地图对象类型

    .map_city {
        uid 0 : integer
        uids 1 : *integer
        lv 2 : integer
        equiped_skin 9 : *skin_slat_detail(skintype)	# 装扮列表
        soldier_count 5 : integer # 士兵数量
        soldier_max 6 : integer # 士兵上限
    }
    .map_resource {
        id 0 : integer # 资源配置的id
        uid 1 : integer # 占领者id
    }
    .map_camp {
        uid 0 : integer
    }
    .map_boss {
        id 0 : integer
    }
    .map_occupy {
        id 0 : integer      # 据点id
        aid 1 : integer(0)     # 联盟id
        uids 2 : *integer   # 驻防uid列表(无人驻防为nil)
        max 3 : integer     # 驻防上限(无人驻防为nil)
        soldier_count 5 : integer # 士兵数量
        soldier_max 6 : integer # 士兵上限
        abbr 7 : string     # 所属联盟简称
        side 8 : integer # 阵营
    }
    .map_alliance_building {
        id 0 : integer      # conf_id
        aid 1 : integer(0)     # 建造联盟
        uids 2 : *integer   # 驻防uid列表(无人驻防为nil)
        max 3 : integer     # 驻防上限(无人驻防为nil)
        abbr 4 : string     # 所属联盟简称
        soldier_count 5 : integer # 士兵数量
        soldier_max 6 : integer # 士兵上限
        occupy_aid 7 : integer(0) # 当前占领联盟(无人占领为nil)
        alliance_skin 8 : *alliance_skin(skin_type) # 联盟装扮
    }

    map_city 2 : map_city # type = 1
    map_resource 3 : map_resource # type = 2
    map_camp 4 : map_camp # type = 5
    map_boss 5 : map_boss # type = 4

    map_minor_fort 6 : map_occupy   # type = 23
    map_middle_fort 8 : map_occupy   # type = 22
    map_major_fort 9 : map_occupy   # type = 21
    map_alliance_hall 10 : map_alliance_building # type = 31
    map_alliance_flag 11 : map_alliance_building # type = 32
    map_alliance_trap 12 : map_boss    # type = 33
    map_icefield_hunter_boss 13 : map_boss # type = 101
    map_capital 14 : map_occupy # typpe = 20
    map_tower 15 : map_occupy  # typpe = 24
    map_mercenary_player_monster 16 : map_boss # type = 102

    map_arsenal_center 20 : map_occupy            #type = 201,    -- 中央
    map_arsenal_treatment_plant 21 : map_occupy   #type = 202,    -- 处理厂
    map_arsenal_factory 22 : map_occupy           #type = 203,    -- 加工厂
    map_arsenal_warehouse 23 : map_occupy         #type = 204,    -- 军火库
    map_arsenal_zombie_camp 24 : map_occupy       #type = 205,    -- 丧尸集中营
    map_arsenal_parking_apron 25 : map_occupy     #type = 206,    -- 停机坪
    map_arsenal_power_station 26 : map_occupy     #type = 207,    -- 发电站
    map_arsenal_weapon_workshop 27 : map_occupy #type = 208,    -- 武器车间

    map_supremacy_palace 28 : map_occupy #type = 501,    -- 霸主宫殿
    map_supremacy_guard 29 : map_occupy #type = 502,    -- 守护建筑

    owner_kid 30 : integer # 占领者kid
}

.alliance_situation {
    .mass_master {
        targetid 0 : integer 
        uids 1 : *integer # uid列表
        max 2 : integer # 上限(可能为nil)
        soldier_count 3 : integer # 士兵数量
        soldier_max 4 : integer # 士兵上限
    }

    .atk_city {
        targetid 0 : integer
    }

    .collect {
        targetid 0 : integer
    }

    .atk_alliance_building {
        aid 0 : integer(0)
        targetid 1 : integer
    }

    .mass_alliance_building {
        targetid 0 : integer 
        uids 1 : *integer # uid列表
        max 2 : integer # 上限(可能为nil)
        soldier_count 3 : integer # 士兵数量
        soldier_max 4 : integer # 士兵上限
        aid 5 : integer(0) # 建筑所属aid
    }

    id 0 : integer #出征id
    owner 1 : integer #部队拥有者
    startpoint 2 : point #起点
    endpoint 3 : point #终点
    starttime 4 : integer #出发时间
    endtime 5 : integer #到达时间
    state 7 : integer #状态
    type 8 : integer #出征类型
    target_type 9 : integer #目标类型
    aid 10 : integer(0) #联盟id

    target 12 : alliance_situation_target #目标点信息 (空地为nil)

    atk_city 14 : atk_city # 攻击城池
    mass_city 15 : mass_master #集结攻城
    mass_boss 18 : mass_master #集结boss
    mass_minor_fort 19 : mass_master #集结据点
    atk_minor_fort 20 : atk_city #攻击据点
    collect_resource 21 : collect   # 采集资源
    atk_camp 22 : atk_city # 攻击营地
    mass_middle_fort 23 : mass_master #集结中据点
    mass_major_fort 24 : mass_master #集结大据点
    atk_middle_fort 25 : atk_city #攻击中据点
    atk_major_fort 26 : atk_city #攻击大据点
    mass_alliance_flag 27 : mass_alliance_building # 集结联盟哨塔
    mass_alliance_hall 28 : mass_alliance_building # 集结联盟主殿
    atk_alliance_flag 29 : atk_alliance_building # 攻击旗帜
    atk_alliance_hall 30 : atk_alliance_building # 攻击主殿
    mass_alliance_trap 31 :mass_master # 联盟陷阱
    mass_icefield_hunter_boss 32 : mass_master # 冰原猎人
    monster_siege_atk_city 33 : atk_city # 黑骑士进攻城池
    monster_siege_atk_alliance_hall 34 : atk_alliance_building # 黑骑士进攻主殿

    atk_capital 35 : atk_city #攻击首都
    atk_tower 36 : atk_city #攻击炮台
    mass_capital 37 : mass_master #集结首都
    mass_tower 38 : mass_master #集结炮台

    mass_arsenal_building 39 : mass_master # 集结水源建筑
    mass_mercenary_player_monster 40 : mass_master # 集结佣兵荣耀个人怪

    supremacy_war_atk_palace 41 : atk_city #攻击宫殿
    supremacy_war_atk_guard 42 : atk_city #攻击守护建筑
    supremacy_war_mass_palace 43 : mass_master #集结宫殿
    supremacy_war_mass_guard 44 : mass_master #集结守护建筑

    kid 45 : integer                # 队列拥有者的kid
    world_kid 46 : integer          # 队列所在地图的kid
    lv 47 : integer # 发起者等级
    power 48 : integer(0) #
    skin 49 : skin	# 装扮
    side 50 : integer # 阵营
}



.world_boss_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer(0) #活动开启时间
    end_ts 2 : integer(0) #活动结束时间
    serial_no 3 : integer #活动序列号
    stage 4 : integer # 当前阶段, 3是结算阶段, 结算阶段需要隐藏活动界面
    atk_num 5 : integer # 攻击次数, 今天累计的攻击次数, 从0开始
    quests 6 :  *quest()    #未领奖且有进度的任务
    finishs 7 : *finishs()    #已领奖任务
    group 8 : integer # 奖励组ID
    atk_max_points 9 : integer(0) # 本期活动单次攻击达到的最大积分
}

.world_boss_last_attack {
    id 0 : integer # 记录id
    ts 1 : integer(0) # 尾刀时间
    name 2 : string # 玩家昵称
	abbr 3 : string # 联盟简称
    uid 4 : integer # 玩家ID
}



.world_march_detail{
    .pos_hero_pair {
        pos 0 : integer
        hero 1 : hero
    }

    owner 0 : integer #部队owner
    id 1 : integer #队列ID
    hero_map 2 : *pos_hero_pair() #英雄map
    soldier_map 3 : *battle_soldier(id)  # 士兵map


    state 4 : integer
    endtime 5 : integer #（行军中）结束时间
    starttime 6 : integer #（行军中）结束时间

    nickName 7: string  #玩家名字
    abbr 8 : string # 联盟简称
    aid 9 : integer(0) # 联盟id
    persons_max 10 : integer  # 可集结人数
    power 11 : integer(0)          # 战力
    troop_limit 12 : integer    # 带兵上限
    mass_soldier_max_num 13 : integer # 所有集结队伍的总士兵上限

    .truck_escort {
        quality 0 : integer                                         # 品质
        last_plundered_time 1 : integer(0)                          # 上次被掠夺的时间
        basis_reward_items 2 : *item                                # 剩下的基础奖励列表
        random_reward_items 3 : *item                               # 剩下的随机奖励物品列表
        plundered_basis_items 4 : *item                             # 被抢走的基础道具列表
        plundered_random_items 5 : *item                            # 被抢走的随机道具列表
        predator_infos 6 : *truck_escort_truck_record_predator_info # 掠夺者信息
        activity_id 7 : integer                                     # 活动id
        group_id 8 : integer                                        # 组id
        assist_uid 9 : integer                                      # 援助者uid
        extra_reward_items 10 : *truck_expert_item_info             # 额外奖励物品列表
        take_back_reward_items_array 11 : *truck_expert_item_info   # 被掠夺时夺回的奖励物品列表
        expert_items_array 12 : *truck_expert_item_info             # 专家奖励物品列表
        expert_quality_drop_id 13 : integer                         # 专家红车品质掉落id
    }
    truck 14 : truck_escort
    side 15 : integer    # 阵营 
}

.world_march {
    .move_split_segment { 
        p 0 : integer(4) # 线段比例
        t 1 : integer # 行军时间
    }
    .atk_city {
        target 0 : integer
        target_aid 1 : integer(0)
        target_side 2 : integer
    }
    .mass_slave {
        master_uid 0 : integer
        master_marchid 1 : integer
        master_type 2 : integer
        master_target_type 3 : integer # 随master部队到达目的地后返回
        master_targetid 4 : integer
        master_target_aid 5 : integer(0)
        target_occupied_aid 6 : integer(0)
    }
    .mass_master {
        slaves 0 : *world_march
        targetid 1 : integer
        invite_list 2: *integer #邀请过的玩家ID
        target_aid 3 : integer(0)
        target_side 4 : integer
    }
    .atk_fort {
        targetid 0 : integer
    }
    .collect {
        refresh_id 0 : integer      # 资源的配置id
        target 1 : integer
        target_aid 2 : integer(0)
        target_side 3 : integer
    }
    .recon_fort {
        targetid 0 : integer
        target_aid 1 : integer(0)
        target_side 2 : integer
    }
    .atk_monster {
        monster_id 0 : integer
    }
    .help_city {
        target 0 : integer
        target_aid 1 : integer(0)
        target_side 2 : integer
    }
    .atk_alliance_building {
        target_building_aid 0 : integer(0)
        target_occupied_aid 1 : integer(0)
        work_status 2 : integer # working时才有效，1.建造 2.破坏 3.驻防 4.修复
        targetid 3 : integer # 建筑id
    }
    .mass_alliance_building {
        slaves 0 : *world_march
        invite_list 1: *integer #邀请过的玩家ID
        target_building_aid 2 : integer(0)
        target_occupied_aid 3 : integer(0)
        targetid 4 : integer # 建筑id
    }
    .build_trap {
        targetid 0 : integer
    }

    .zombie_atk {
        wave 0 : integer
        targetid 1 : integer
    }

    .frostfire_war_collect {
        resource_id 0 : integer                 # 资源点配置id
        monster_dead 1 : boolean                # 怪是否死亡
        collect_speed 2 : integer               # 采集速度
        sit_begin_time 3 : integer(0)           # 坐下时间
    }

    .pet_catch {
        pet_id 0 : integer
    }

    .to_a_banquet {
        rewards 0 : *item()
    }

    .truck_escort {
        route_id 0 : integer        # 路线id
        quality 1 : integer         # 品质
        start_time 2 : integer      # 货车开始时间
        end_time 3 : integer        # 货车结束时间
        start_point 4 : point       # 货车起点
        be_plundered 5 : integer    # 被掠夺次数
        activity_id 6 : integer     # 活动id
        truck_id 7 : integer(0)     # 货车id
    }

    .alliance_collect_resource {
        target_id 0 : integer
        target_aid 1 : integer(0)
    }

    .atk_supremacy_guard {    # 攻击霸主战守护建筑
         targetid 0 : integer # 建筑id
    }

    .mass_supremacy_guard {    # 集结霸主战守护建筑
        slaves 0 : *world_march
        invite_list 1: *integer     # 邀请过的玩家ID
        targetid 2 : integer        # 建筑id
        target_aid 3 : integer(0)   # 建筑联盟id
    }

    .recon_supremacy_guard {    # 侦查霸主战守护建筑
        targetid 0 : integer        # 建筑id
        target_aid 1 : integer(0)   # 建筑联盟id
    }

    id 0 : integer #出征id
    owner 1 : integer #部队拥有者

    startpoint 2 : point #起点
    endpoint 3 : point #终点
    move_startpoint 4 : point_double
    move_endpoint 5 : point_double

    starttime 6 : integer #出发时间
    endtime 7 : integer #到达时间

    move_split_segment 8 : *move_split_segment

    state 9 : integer #状态

    type 10 : integer #出征类型
    recon_city 11 : atk_city #侦察城池 type = 1
    atk_city 12 : atk_city #攻击城池 type = 2

    squad_list 13 : formation   #出征小队信息
    formationid 14 : integer    #编队id

    target_type 15 : integer #目标类型
    aid 16 : integer(0) #联盟id

    battletime 17 : integer # 触发战斗时间戳(攻击方)

    mass_city 18 : mass_master #集结攻城
    mass_slave 19 : mass_slave #集结从属部队
    mass_boss 20 : mass_master #集结boss
    atk_camp 21 : atk_city # 攻击营地
    mass_minor_fort 22 : mass_master #集结小据点

    recon_camp 23 : atk_city # 侦查营地
    recon_resource 24 : collect # 城池资源点
    recon_minor_fort 25 : recon_fort # 侦查据点
    battleresult 26 : integer #战斗结果
    atk_minor_fort 27: atk_fort #攻击小据点
    supplement_fort 28 : atk_fort #士兵援助小据点

    equiped_skin 29 : *skin_slat_detail(skintype)	# 装扮列表
    collect_resource 30 : collect   # 采集资源

    def_battletime 31 : integer #触发战斗时间戳(防御方)
    atk_middle_fort 32 : atk_fort    # 攻击中据点
    recon_middle_fort 33 : recon_fort # 侦查中据点
    mass_middle_fort 34 : mass_master # 集结中据点
    atk_major_fort 35 : atk_fort    # 攻击大据点
    recon_major_fort 36 : recon_fort # 侦查大据点
    mass_major_fort 37 : mass_master # 集结大据点
    atk_monster 38 : atk_monster # 进攻怪物
    help_city 39 : help_city # 援助队列
    mass_icefield_hunter_boss 40 : mass_master # 冰原猎人集结

    monster_siege_atk_city 41: atk_city #怪物攻击城池
    recon_alliance_flag 42 : atk_alliance_building # 侦查联盟旗帜
    recon_alliance_hall 43 : atk_alliance_building # 侦查联盟主殿
    atk_alliance_flag 44 : atk_alliance_building # 攻击联盟旗帜
    atk_alliance_hall 45 : atk_alliance_building # 攻击联盟主殿
    mass_alliance_flag 46 : mass_alliance_building # 集结联盟旗帜
    mass_alliance_hall 47 : mass_alliance_building # 集结联盟主殿
    mass_alliance_trap 48 : mass_master # 集结联盟陷阱
    monster_siege_atk_alliance_hall 49 : atk_alliance_building # 怪物攻击主殿

    transaction_slg 50 : atk_monster   # 情报站slg战斗
    build_trap 51 : build_trap # 建造联盟陷阱

    atk_capital 52 : atk_fort #攻击首都
    mass_capital 53 : mass_master #集结首都
    recon_capital 54 : recon_fort #侦查首都

    atk_tower 55 : atk_fort #攻击炮台
    mass_tower 56 : mass_master #集结炮台
    recon_tower 57 : recon_fort #侦查炮台

    atk_arsenal_building 58 : atk_fort # 攻击水源建筑
    mass_arsenal_building 59 : mass_master # 集结水源建筑
    recon_arsenal_building 60 : recon_fort # 侦查水源建筑
    collect_weapon_workshop 61 : collect # 采集武器车间
    recon_weapon_workshop 62 : collect # 侦查武器车间

    zombie_atk_building 63 : zombie_atk # 怪物攻击

    atk_mercenary_player_monster 64 : atk_monster  # 攻击个人怪物
    mass_mercenary_player_monster 65 : mass_master # 集结个人怪物
    atk_mercenary_alliance_monster 66 : atk_monster # 攻击联盟怪物
    
    kid 67 : integer                # 队列拥有者的kid
    world_kid 68 : integer          # 队列所在地图的kid
    atk_monster_auto 69 : atk_monster # 进攻怪物

    frostfire_war_atk_monster 70 : atk_monster # 攻击怪物队列
    frostfire_war_collect 71 : frostfire_war_collect # 普通采集队列
    frostfire_war_burst_collect 72 : frostfire_war_collect # 迸发采集队列
    frostfire_war_atk_center 73 : atk_fort # 中心建筑队列

    map_expression 74 : map_expression # 地图表情

    pet_catch 75 : pet_catch # 宠物捕捉
    to_a_banquet 76 : to_a_banquet # 感恩节赴宴
    truck_escort 77 : truck_escort # 货车护送

    supremacy_war_atk_guard 78 : atk_supremacy_guard        # 攻击霸主守护建筑
    supremacy_war_mass_guard 79 : mass_supremacy_guard      # 集结霸主守护建筑
    supremacy_war_recon_guard 80 : recon_supremacy_guard    # 侦查霸主守护建筑

    supremacy_war_atk_palace 81 : atk_fort # 攻击主殿
    supremacy_war_mass_palace 82 : mass_master # 集结主殿
    supremacy_war_recon_palace 83 : atk_city # 侦查主殿

    to_a_supremacy_banquet 84 : to_a_banquet # 感恩节赴宴

    alliance_collect_resource 85 : alliance_collect_resource # 联盟资源采集
    atk_world_boss 86 : atk_monster # 攻击世界boss
    supremacy_war_collect_resource_1 87 : collect   # 攻击霸主战1级资源点
    supremacy_war_recon_resource_1 88 : collect # 侦查霸主战1级资源点
    supremacy_war_collect_resource_2 89 : collect   # 攻击霸主战2级资源点
    supremacy_war_recon_resource_2 90 : collect # 侦查霸主战2级资源点
    supremacy_war_atk_monster 91 : atk_monster # 攻击霸主战怪物
    side 92 : integer # 阵营
    brawl_war_collect_resource 93 : collect # 乱斗战场补给箱
    brawl_war_atk_building 94 : atk_fort # 乱斗战场攻击积分建筑
    brawl_war_recon_building 95 : recon_fort # 乱斗战场侦查积分建筑
    brawl_war_recon_resource 96 : collect # 乱斗战场侦查补给箱
    segment_x_aoi 1000:  *int_bool_map_item()#行军线经过的AOI序列SET
}

.march_detail_4_player_situation {
    owner 0 : integer #部队owner
    id 1 : integer #队列ID

    playerinfo 2 : recon_player_base        # 部队拥有者信息
    hero_list 3 : *recon_hero_info(idx)     # 英雄列表
    total_soldier 4 : integer               # 士兵数量
    soldier_info 5 : *battle_soldier(id)    # 士兵数量
}

.march_battle_info_4_alliance_situation { # 集结加成详情
    master_uid 0 : integer
    buff_map 1 : *pair_int_int() #来源master_uid

    .slave_skill {
        uid 0 : integer #来源
        skill 1 : pair_int_int
    }

    master_skill_list 2: *pair_int_int #来源master_uid
    slave_skill_list 3: *slave_skill

    master_nickName 4 : string

    .exclusive_skill {
        index 0 : integer # 位置
        id 1 : integer # 技能id
        lv 2 : integer # 技能等级
    }
    exclusive_skill_map 5 : *exclusive_skill(index) # 队长专属技能
}

.world_march_del_keys {
    .mass_master {
        slaves 0 : *integer #移除的下标
    }

    mass_city 0 : mass_master

    mass_boss 1 : mass_master
    mass_icefield_hunter_boss 2 : mass_master

    mass_minor_fort 3 : mass_master
    mass_middle_fort 4 : mass_master
    mass_major_fort 5 : mass_master

    mass_alliance_flag 6 : mass_master # 集结联盟旗帜
    mass_alliance_hall 7 : mass_master # 集结联盟主殿
    mass_alliance_trap 8 : mass_master # 集结联盟陷阱

    mass_capital 9: mass_master
    mass_tower 10: mass_master

    mass_arsenal_building 11 : mass_master # 集结水源建筑
}


.map_daily_count {
    key 0 : integer              # 数据标识
    count 1 : integer             # 数量
}



.wx_user_storage_info {
    open 0 : boolean
}



.source_player_info { # 来源玩家信息
    serverid 0 : integer  # 创建新角色时的来源服务器ID
    uid 1 : integer       # 创建新角色时的来源游戏角色ID
}







req_icebound_amazing_open_chest  13251 {     # 开启宝箱
    request {
        ids 0 : *integer
        activity_id 1 : integer     # 活动id
    }

    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        chest_progress 1 : integer              # 宝箱进度
