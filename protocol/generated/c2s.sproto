req_dig_treasure_click_brick 20653 {                    # 挖宝操作
    request {
        id 0 : integer                                  # 活动id
        key 1 : integer                                 # 坐标(1000*x+y)
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        update_brick 1 : brick_info                     # 更新的格子(目前点一次至多只会更新一个格子)
        moles 2 : *dig_treasure_mole                    # 触发鼹鼠事件(如有, 里面有鼹鼠挖出宝物的信息, 按顺序触发)
        rewards 3: *item()                              # 安慰奖
        treasure 4: dig_treasure_item                   # 铲子挖到的宝物(包含坐标，方便动画效果)
        find_treasure 5: dig_treasure_item              # 本次挖掘发现的宝物(未挖出)
        settlement 6: dig_treasure_settlement           # 结算结构(如有)
    }
}



