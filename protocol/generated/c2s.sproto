req_alliance_arsenal_league_get_history 30521 { 	# 获取历史数据
	request {
		id 0 : integer # 联赛活动ID
        aid 1 : integer(0) # 联盟id
		start 2 : integer # 开始编号(nil默认从最新一条开始发送)
		count 3 : integer # 条数(nil默认20条)
		legion_id 4 : integer # 军团编号
	}

	response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0 : integer
		.history {
			index 0 : integer # 编号
            result 1 : integer # 胜利方阵营
            .side_data { #  联盟数据
                aid 0 : integer(0)
                kid 1 : integer
                side 2 : integer # 阵营
                info 3 : alliance_brief_info
				score 4 : integer(0) # 积分
				count 5 : integer # 参战人数
				legion_id 6 : integer # 军团编号
            }
            sides 2 : *side_data(side)
			starttime 3 : integer(0) # 开始时间
			endtime 4 : integer(0)  # 结束时间
			side 5 : integer # 本盟所属方
			.mvp_data {
                uid 0 : integer
                side 2 : integer
                name 3 : string
                image 4 : integer
                upload_image 5 : string
            }
			mvp 6 : mvp_data # mvp数据
			.player_score {
				uid 0 : integer
				values 1 : *integer(0) # 玩家分数，格式:{分数, 是否替补, 分数时间}, 第二个0表示参战人员,1表示替补,第三个值为分数时间
			}
			score_map 7 : *player_score() # 玩家得分情况
			idle 8 : boolean # 是否轮空 true表示轮空
			match_id 9 : integer # 比赛ID
		}
		list 1 : *history # 历史数据列表
	}
}

