    reward 1 : *item()
}



.skintype{
    id 0 : integer #皮肤类型
    equip 1 : integer # 装备的id nil or 0 为默认
    skins 2 : *skin(id)
    max_skin_count 3 : integer  # 历史最高同时拥有装扮数量 目前就行军装扮统计
    equip_ids 4 : *integer    # 批量装备id列表
    select_type 5 : integer    # 选择类型 1.顺序 2.随机
}

.skin{
    id 0 : integer #皮肤id
    expire_ts 1 : integer   # 到期时间
}

.skin_slat_detail {
    skintype 0 : integer
    id 1 : integer
    expire_ts 2 : integer   # 到期时间
}

.skin_earth_update_skin_group_info { # 星球升级装扮组信息
    id 0 : integer                  # 组id
    last_skin_id 1 : integer        # 上一次选择的装扮id
    select_max_skin_id 2 : integer  # 选择过的最高等级装扮id
}



.slg_3_league_match { # 对决场次信息
    .side_info {
        side 0 : integer # 阵营 1-蓝方 2-红方
        uid 1 : integer
        power 2 : integer(0) # 部队战力
        rank 3 : integer # 排名 这场战斗结束后的排名
        score 4 : integer(0) # 这场战斗前的积分
        score_add 5 : integer(0) # 得分增加
        empty 6 : boolean # 是否未设置部队 true时表示没有设置编队
    }

    match_id 0 : integer    # 场次id 巅峰赛/淘汰赛(1-63), 海选赛(100起, 上限根据报名人数决定, 后两位为轮次, 如12303, 表示海选第123场比赛,第三轮)
    sides 1 : *side_info(side) # 对阵信息, 轮空时 side_info里只有自己
    win_side 2 : integer # 获胜方阵营
    win_his 3 : *integer # 海选赛最多1个回合的获胜方, 淘汰赛/巅峰赛最多3个. value=1表示蓝方胜利, value=2表示红方胜利
}

.slg_3_league_formation {
    formation_id 0 : integer                    # 编队id
    soldier_info 1 : *pair_int_int()            # 士兵剩余数量
}

.slg_3_league_round_result {
    ret 0 : integer                 # 1:蓝方胜利 2:红方胜利
    blue 1 : slg_3_league_formation    # 蓝方阵容
    red 2 : slg_3_league_formation    # 红方阵容
    round_ts 3 : integer(0)
}

.slg_3_league_battle_result {
    blue_power 0 : integer(0)                   # 蓝方总战力
    red_power 1 : integer(0)                    # 红方总战力
    round_result 2 : *slg_3_league_round_result   # 回合结果
    blue_power_end 3 : integer(0)                  # 蓝方结束时总战力
    red_power_end 4 : integer(0)                  # 红方结束时总战力
}

.slg_3_league_formation_power {
    id 0 : integer
    power 1 : integer(0)
}

.slg_3_league_formation_build {                  # 创建编队数据
    .hero_data {
        id 0 : integer
        star 1 : integer
        lv 2 : integer
        training_lv 3 : integer
    }
    .pos_hero_pair {
        pos 0 : integer
        hero 1 : hero_data
    }
    hero_map 0 : *pos_hero_pair()     # 英雄map {[位置] = 英雄数据}
    soldier 1 : *pair_int_int()     # 士兵map {[士兵id] = 数量}
}

.slg_3_league_formation_pair {
    id 0 : integer
    prefab 1 : slg_3_league_formation_build
}

.slg_3_league_battle_result_overview {
    battle_result 0 : slg_3_league_battle_result          # 战斗结果
    formation_blue 1 : *slg_3_league_formation_pair()            # 蓝方上阵的编队
    formation_red 2 : *slg_3_league_formation_pair()             # 红方上阵的编队
    formation_power_blue 3 : *slg_3_league_formation_power() # 蓝方编队战力
    formation_power_red 4 : *slg_3_league_formation_power() # 红方编队战力
}

.slg_3_league_qua_result {
    rank 0 : integer
    score 1 : integer(0)
}

.slg_3_league_formation_skill {
    id 0 : integer
    .soldier_skill_info {
        soldier_type 0 : integer # 士兵类型
        skill_map 1 : *pair_int_int()
    }
    soldier_skill_map 1 : *soldier_skill_info()
}


.slg_3_league_task {
    group_idx 0: integer    # 任务组id, 对应slg_3_league_task表的索引
    data 1: task_info       # 任务进度数据
}

.slg_3_league_guess {

}

.slg_3_league_guess_info {
    match_id 0 : integer # 场次id
    match 1 : slg_3_league_match
    attend_num 2 : integer # 参与人数
    sides 3 : *integer # [1] = 蓝色方奖池, [2] = 红色方奖池
}

.slg_3_league_guess_result {
    match_id 0 : integer # 场次id
    side 1 : integer # 投注方  1=蓝色方  2=红色方
    num 2 : integer # 投注数量
    profit 3 : integer # 盈亏
    reward 4: boolean # 是否已经结算
    bet_ts 5: integer # 首次下注时间
}



.slot_matrix_number {
    key 0 : integer                             # 格子key(1000 * x + y)
    number 1 : integer                          # 数字
}

.slot_matrix_line {
    slot 0 : integer                            # 连线slot
    idx  1 : integer                            # 奖励索引id
    rewarded 2 : boolean                        # 是否已领取
}

.slot_matrix_jackpot {
    idx 1 : integer                             # 索引id
    rewarded 2 : boolean                        # 是否已领取
}

.slot_matrix_level_data {                       # 矩阵信息
    level 0 : integer                           # 等级id(1: 低级矩阵, 2: 中级矩阵, 3: 高级矩阵)
    matrix 1 : *slot_matrix_number()            # 矩阵数字
    drawn_set 2 : *pair_int_bool()              # 已点亮的数字 {[数字] = true}
    lines 3 : *slot_matrix_line(slot)           # 连线信息
    jackpot 4 : slot_matrix_jackpot             # 本局大奖
    round 5 : integer                           # 轮次, 初始为1, 每次重置自增
}

.slot_matrix_reward_record {                    # 获奖记录
    level 0 : integer                           # 等级id(1: 低级矩阵, 2: 中级矩阵, 3: 高级矩阵)
    rewards 1 : *pair_int_int()                 # 奖励{[道具id] = 数量}
    count 2 : integer                           # 该等级经历的轮次数
}

.slot_matrix_task {                              # 每日任务
    quests 0 : *quest()
    finish 1 : *finishs()
}

.slot_matrix_info {
    id 0 : integer                              # 活动id
    start_ts 1 : integer                        # 活动开始时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer                       # 活动序列号
    group_id 4 : integer                        # 组id

    level_data 5 : slot_matrix_level_data       # 关卡数据
    acc_times 6 : integer                       # 累计抽奖次数
    times_rewards 7 : *pair_int_bool()          # 已领取的次数奖励 {[索引id] = true}
    reward_records 8 : *slot_matrix_reward_record(level)  # 各等级奖励记录 {[level]={count,rewards}}
    task 9 : slot_matrix_task                   # 每日任务数据
}

.slot_matrix_broadcast_record {                 # 广播记录数据结构
    record_id 0 : integer(0)                    # 记录唯一id
    uid 1 : integer                             # uid
    nick_name 2 : string                        # 昵称
    abbr 3 : string                             # 联盟简称
    record_ts 4 : integer                       # 时间戳

    level 5 : integer                           # 矩阵等级
    item_id 6 : integer                         # 奖励id
    item_count 7 : integer                      # 奖励内容
}



.snow_clean_mission_archive {        # 关卡存档数据
    version 0 : integer # 版本号，1开始自增
    map_data 1 : binary # 地图数据，长度阈值为20kb
    mission_cost_power 2 : integer # 关卡消耗能量值
    mission_add_power 3 : integer # 关卡增加能量值
    progress 4 : integer # 关卡进度 万分比
    md5 5 : string # 地图md5
}

.snow_clean_mission { # 关卡数据
    map_id 0 : integer # 地图id
    illusts 1 : *integer # 图鉴奖励列表
    rewards 2 : *item_list # 奖励列表
    box 3 : *item_list # 宝箱奖励列表
    random_key 4 : string # 关卡随机key 结算关卡时当做内容做加密使用
    archive 5 : snow_clean_mission_archive # 存档数据
    version 6 : integer # 配置版本号
    reset_v 7 : integer # 重置版本号
    use_items 8 : *pair_int_int() # 使用道具
}


.snow_fund_bp {
    .received_mark {
        type 0 : integer # 奖励类型 1免费 2普通付费
        value 1 : *pair_int_bool()
    }
    received_mark 0 : *received_mark()
    privilege_mark 1 : *pair_int_bool() # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
}

.snow_fund_info {
    buy 0 : boolean                     # 是否已购买基金
    bp_info 1 : snow_fund_bp            # 通行证数据
}

.snow_guide{
	id 0: integer
	trigger_time 1 : integer # 触发时间（new任务）
	snow_time 2 : integer  #开始下雪时间 （发邮件）
	quests 3 :  *quest(id)   #任务 （手动领奖/发过邮件 quests = {})
	manual_getaward 4 : integer # 是否手动领奖
}



.social_info {
    id 0 : integer
    is_open 1 : boolean     # 是否点开
    is_receive 2 : boolean  # 是否领取
}



.formation_build_pair {
    id 0 : integer
    prefab 1 : formation_build
}

.formation_build_pair_with_name {
    id 0 : integer
    prefab 1 : formation_build_with_name
}



.souvenir_info {
    .reward_info {
        index 0 : integer
        is_get 1 : boolean
    }
    .get_reward_info {
        item_id 0 : integer
        reward_info 1 : *reward_info()
    }

    reward_info 0 : *get_reward_info() # 领奖记录 {[item_id] = {[index]=true}}
}





.spar_laboratory_gift { # 礼包
