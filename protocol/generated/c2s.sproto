.fishing_fish_info { # 关卡生成的鱼信息
    id 0 : integer      # 鱼id
    depth 1 : integer   # 鱼深度
    index 2 : integer   # 索引id 指定鱼是-1,客户端生成的鱼是0,服务端生成的是配置表里的索引id
}

.fishing_level_info {  # 关卡信息
    type 0 : integer                        # 关卡类型 1-普通关卡 2-宝藏关卡
    use_protection_device 1 : boolean       # 是否使用保护装置
    use_thunder 2 : boolean                 # 是否使用雷达
    use_lighting 3 : boolean                # 是否使用照明灯
    specified_fish_id 4 : integer           # 指定的鱼id
    level_id 5 : integer                    # 关卡id
    total_sarticle 6 : *fishing_fish_info   # 关卡生成的特殊物件信息
    random_key 7 : string                   # 关卡随机key 结算关卡时当做内容做加密使用
    multiple 8 : integer                    # 倍数
}

.fishing_daily_task {
    quests 0 :  *quest      # 未领奖且有进度的任务
    finishs 1 : *finishs    # 已领奖任务
}

.fishing_activity_info {  # 活动信息
    preview_start_ts 0 : integer        # 预告开始时间
    preview_end_ts 1 : integer          # 预告结束时间
    start_end_ts 2 : integer            # 活动结束时间
    final_end_ts 3 : integer            # 结算结束时间
    show_end_ts 4 : integer             # 展示结束时间
    coin 5 : integer                    # 金币
    integral 6 : integer                # 积分
    power 7 : integer                   # 体力
    fish_line_level 8 : integer         # 鱼线等级
    fish_hook_level 9 : integer         # 鱼钩等级
    fish_sinker_level 10 : integer      # 鱼坠等级
    level_in_progress 11 : boolean      # 关卡是否在进行中，如果进行中，下面会有当前关卡信息
    level_info 12 : fishing_level_info  # 关卡信息
    free_gift_get_time 13 : integer     # 上次领取免费礼包的时间戳
    id 14 : integer                     # 活动ID
    rank_group_id 15 : integer          # 排行奖励组id
    serial_no 16 : integer              # 当前期数
    random_key 17 : string              # 随机key 结算关卡时的密钥
    last_daily_reward_time 18 : integer # 上次领取每日奖励的时间
    task_info 19 : fishing_daily_task   # 日常任务
    serial_task_info 20 : fishing_daily_task   # 本期任务
    fishing_guide 21 : boolean          # 是否需要进行钓鱼引导
}

.fishing_handbook_info {  # 图鉴信息
    season 0 : integer                  # 当前季节
    item 1 : *integer                   # 已经获得的图鉴 包括鱼,宝箱,纪念品,潜水员
    star_reward_info 2 : *integer       # 星星已领奖信息 id为星星数
    single_reward_info 3 : *integer     # 单图鉴已领奖信息 id为物件id
    whole_reward_info 4 : *integer      # 全图鉴已领奖信息 id为物件类型 1-鱼 2-潜水员 3-宝箱 4-纪念品
    unlock_item_type 5 : *pair_int_bool()  # 解锁的物件类型 不包含默认解锁类型
}

.fishing_item {  # 物品信息
    id 0 : integer # id
    count 1 : integer # 个数
}

.fishing_rank_info {  # 排行榜信息
    rank_data 0 : rank_data    # 排行榜基础信息
    kid 1 : integer             # 所在王国id
}



.fishing_bp_info{
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer
    group_id 4 : integer #当前期数分组配置id
    integral 5 : integer # 当前积分

    .received_mark {
        type 0 : integer # 奖励类型 1免费 2普通付费 3高级付费
        value 1 : *pair_int_bool()
    }
    received_mark 6 : *received_mark()
    privilege_mark 7 : *pair_int_bool() # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
    extra_reward_count 8 : integer # 额外奖励领取次数
}



.fishing_turntable_info{
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    serial_no 3 : integer           
    group_id 4 : integer            # 当前期数分组配置id
}



.fog_cell_node {
    # 共用
    all_clear 0 : boolean
    # node用
    nodes 1 : *fog_cell_node_element()
    # cell用
    grids 2 : integer   # bitmap
}

.fog_cell_node_element {
    idx 0 : integer
    node 1 : fog_cell_node
}

.fog_recon_march {
    id 0 : integer
    startpoint 1 : point
    endpoint 2 : point
    starttime 3 : integer   # 出发时间
    endtime 4 : integer     # 到达时间
    sight 5 : integer       # 视野，没有操作的话不会重新计算视野
    returning 6 : boolean   # 回城中
}



.fortwar_activity {
	season 0 : integer # 赛季
	phase 1 : integer # 期数
	stage 2 : integer # 阶段 0:未开启 1:预告 2:报名阶段 3:争夺 4:保护
	end_time 3 : integer # 阶段结束时间
	index 4 : integer # 当前开发期数（据点是否开放使用）
	protect_endtime 5 : integer # 保护结束时间(用于据点显示)
	group_id 6 : integer # 战区组ID
}

.fortwar_info {
	id 0 : integer # 据点ID
	state 1 : integer # 争夺状态 0:无状态（非争夺阶段）1:准备 2:争夺中 3:结算（活动保护状态）
	times 2 : *integer # 本联盟报名时间列表
	end_time 3 : integer # 状态结束时间 

	.owner {
		aid 0 : integer(0)
		abbr 1 : string
		name 2 : string
	} 
	owner 4 :  owner # 占领联盟信息
	rewards 5 : *item() # 未分配的奖励
	auto_apply 6 : boolean # 自动报名
	applied 7 : boolean # 是否参与报名, false or nil时表示未报名据点
	warrior_rewards 8 : *item() # 未分配的勇者奖励
	settle_begin_ts 9 : integer # 分配开始时间
}

.apply_fort_info {
	id 0 : integer #据点ID
	times 1 : *integer # 报名时间列表
}



.fortune_card {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    version 3 : integer             # 期数

    reward_pool 4 : *pair_int_int()  # 大奖奖池（[服务端槽位]= 奖励索引） 
    geted_reward_pool 5 : *pair_int_int() # 已经领奖池子 [槽位]= 奖励索引
    multiple 6 :integer        # 倍数 （nil or 0 就是 没有加倍）
	cost_num 7 :integer 		#消耗游戏券数量
	extra_reward 8 : *pair_int_bool() #额外奖励领取情况 【消耗游戏券数量】= 是否已领奖
	client_flag 9 : boolean #客户端标记
	daily_reward_ts 10 : integer # 每日奖励领奖时间, 首次开启时为nil
	geted_multiple 11 : *pair_int_int() # 记录领奖时的倍数, [槽位] = 倍数, 默认倍数为1
}

.fortune_card_winning_record { # 中奖记录
	uid 0 : integer
	item_id 1 : integer
	item_count 2 : integer
	open_num 3 : integer # 第几次抽到大奖
	multiple 4 : integer # 奖励倍数
	record_ts 5 : integer # 中奖时间
	record_id 6 : integer(0) # 记录唯一ID
	nick_name 7 : string # 中奖者昵称
	abbr 8 : string # 中奖者联盟简称
}



.friend_req_result {
