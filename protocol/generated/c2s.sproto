req_frostfire_war_enter_warzone 13301 { # 进入战场
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        city_point 1 : point #城池坐标
        starttime 2 : integer #战场开始时间
        endtime 3 : integer #战场结束时间

        .move_city_free {
            count 0 : integer # 免费次数
            next_calc_ts 1 : integer  # 下次恢复次数时间戳
            move_num 2 : integer #已经使用的迁城道具次数
        }
        move_city_free 5 : move_city_free #免费迁城相关信息
        chat_room_id 6 : integer(0) # 战场聊天室ID

        state 7: integer #当前状态
        marchs 8 : *world_march #玩家自己队列数据
        player_num 9 : integer #当前战场人数
        hero_injured 10 : *pair_int_int() # 英雄受伤恢复时间 {[hero_id] = recover_ts}
        formation_map 11 : *formation(id) # 战场中的队列信息
        skill_point 12 : integer # 技能点
        .skill_slot {
            slot 0 : integer # 槽位
            value 1 : frostfire_war_skill # 技能
        }
        skill_slots 13 : *skill_slot() # 技能列表

        .score_info {
            tag 0 : integer         # 积分来源 1.采集 2.技能
            count 1 : integer       # 分数
        }
        score 14 : *score_info()        # 已存储的积分
    }
}

