}


# 幸存者
.survivor {
    sid             0 : integer     # 工人id
    status          1 : integer     # 工人状态(空闲、工作、生病...)
    fid_source      2 : integer     # 工人绑定宿舍床位
    fid_work        3 : integer     # 工作工位家具id
    fid_ibed        4 : integer     # 医务室病床 bed
    cure_end_time   5 : integer     # 治疗结束时间
    img_id          6 : integer     # 形象id
    name_id         7 : integer     # 名字索引
    total_cure_time 8 : integer     # 生病总时间
    is_sick         9 : boolean     # 是否生病
}

.riot_data {
    start_time 0 : integer          # 暴动开始时间，一次都没暴动过是nil，暴动结束不会清
    detect_time 1 : integer         # 上次检测暴动时间，一次都没检测过是nil
}



.target_integral_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer         # 活动开始时间
    end_ts 2 : integer           # 活动结束时间
    integral 3 : integer         # 当前积分
    
    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 4 : *received_mark() #已领取的奖励
    reward_conf_idx 5 : *integer #每个阶段奖励的配置ID(索引target_integral_reward表), 按阶段顺序排序, 1阶段的配置ID就是数组的第一个元素
    act_conf_id 6 : integer # 索引target_activity_conf
}


.thanksgiving_bp_info {
    id 0 : integer                      # 活动ID
    start_ts 1 : integer                # 活动开启时间
    end_ts 2 : integer                  # 活动结束时间
    serial_no 3 : integer
    integral 4 : integer                # 当前积分

    group 5 : integer
    reward_group 6 : integer
    received_mark 7 : *received_mark()  # 已领取
    privilege_mark 8 : *mark()          # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
}



.self_exchange {
    exchange_state 0 : integer  # 自己的交换状态 0：没有交换 1：交换中 2：交换完成，待领取
    sub_id 1 : integer          # 自己扣减的食材
    sub_num 2 : integer
    add_id 3 : integer          # 自己增加的食材
    add_num 4 : integer
    exchange_uid 5 : integer    # 交换的玩家
}

.self_exchange_info {
    exchange_id 0 : integer
    info 1 : self_exchange()
}

.apply_food {               
    nums 0 : integer        # 申请数量
    food_id 1 : integer     # 申请的食材id
    state 2 : integer       # 1：进行中 2：完成，待领取
    give_uid 3 : integer    # 赠送的玩家id
}

.apply_info {
    apply_id 0 : integer    # 申请的id
    info 1 : apply_food
}

.thanksgiving_cooking_info {
    id 0 : integer              # 活动ID
    start_ts 1 : integer        # 活动开启时间
    end_ts 2 : integer          # 活动结束时间
    serial_no 3 : integer       # 期数
    food_adept 4 : *pair_int_bool()      # 菜品是否老手 [food_id] = true
    exchange_info 5 : *self_exchange_info()
    apply_nums 6 : integer      # 今日申请数量
    last_refresh_ts 7 : integer # 上次刷新时间
    apply_info 8 : *apply_info()
}

.owner_exchange {
    sub_id 0 : integer          # 交换的玩家扣减的食材
    sub_num 1 : integer
    add_id 2 : integer          # 交换的玩家增加的食材
    add_num 3 : integer
}

.owner_exchange_info {
    exchange_id 0 : integer     # 交换id
    info 1 : owner_exchange()
}

.thanksgiving_cooking_exchange_info {
    owner 0 : integer
    info 1 : *owner_exchange_info()
}


.thanksgiving_feast_table { # 加餐
    uid 0 : integer # 加餐uid
    table_id 1 : integer # 餐桌的私有ID
    meal_id 2 : integer # 加餐类型ID
}

.thanksgiving_feast_alliance { # 联盟数据
    id 0 : integer # 宴会ID
    time 1 : integer(0) # 开启(预约开启)时间
    can_join 2 : boolean # 玩家能否加入(默认nil)
    tables 3 : *thanksgiving_feast_table # 加餐列表(默认nil)
    .point {
        x 0 : integer
        y 1 : integer
    }
    point 4 : point # 宴会坐标
}

.thanksgiving_feast_alliance_del_keys {
    point 0 : boolean
}

.thanksgiving_feast_activity { # 活动数据
    id 0 : integer              # 活动id
    stage_ts 1 : *integer(0)    # 活动阶段开始时间 1.预告,2.开启,3.展示,4.展示结束
	serial_no 2 : integer 		# 赛季
    buy_count 3 : *pair_int_int()  # 礼包购买数据
    gift_group_idx 4 : integer  # 礼包配置索引ID
    unread_record 5 : boolean # 是否有未读记录
}



.thanksgiving_menu_activity_info {  # 活动信息
    preview_start_ts 0 : integer        # 预告开始时间
    preview_end_ts 1 : integer          # 预告结束时间
    start_end_ts 2 : integer            # 活动结束时间
    final_end_ts 3 : integer            # 结算结束时间
    id 4 : integer                      # 活动ID
    integral 5 : integer                # 积分
    stage_type 6 : integer              # 阶段状态 1-展示 2-活动中 3-结算
    alliance_id 7 : integer(0)             # 联盟ID 根据阶段有不同含义
    daily_integral 8 : integer          # 当天累计获得积分
    take_daily_chest 9 : boolean        # 是否已领取每日积分宝箱奖励
    dishes_group_id 10 : integer        # 急需菜单组id
    take_preview_reward 11 : boolean     # 是否已领取预告奖励
}

.thanksgiving_menu_rank_info {  # 排行榜信息
    type 0 : integer # 排行榜类型 1-个人 2-联盟
    list_data 1 : *rank_data
    self_rank 2 : integer # 自身排名
    self_rank_data 3 : rank_data
}



.thanksgiving_sign_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer                       # 活动期数
    server_index 4 : integer                    # 索引thanksgivingday_sign配置表奖励
    last_sign_ts 5 : integer                    # 上次签到时间
    sign_days 6 : integer                       # 签到天数
    free_award_record 7 : *integer              # 免费领奖情况
    buy_award_record 8 : *integer               # 付费领取情况
    has_pay 9 : boolean                         # 是否付费
}

.received_sign_mark {
    day 0 : integer                             # 天数
    receive_type 1 : *pair_int_bool()           # 领取的奖励类型, 1免费, 2普通付费 
}


.three_tiles_task_info {
    finishs 0 : *finishs()                      # 已领奖任务
    quests 1 : *quest()                         # 进行中任务
}

.three_tiles_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer

    pass_level 4 : *pair_int_bool()             # 通关关卡 {[level]=true}
    progress 5 : integer                        # 通关进度
    received_progress_reward 6 : *pair_int_bool()   # 已领取的通关进度奖励 {[progress]=true}

    task_info 7: three_tiles_task_info          # 任务数据   
    gift_group_arr 8: *integer                  # 礼包组

    challenge_level 9 : integer                 # 当前挑战的关卡
}

.level_data {
    key 0 : integer # 格子key(1000 * x + y)
    id 1 : integer  # 卡片id
}

.layer_level_data {
    layer 0 : integer
    data 1 : *level_data()
}

.select_data {
    key 0 : integer # 格子key(1000 * x + y)
    id 1 : integer  # 卡片id
    layer 2 : integer
    index 3 : integer # 唯一索引
}

.three_tiles_level {
    level 0 : integer
    use_free_items 1 : *pair_int_int()          # 使用免费道具和次数 {[item_id]=nums}
    level_data 2 : *layer_level_data()          # 关卡数据
    select_data 3 : *select_data                # 消除区域数据
    back_data 4 : *select_data                  # 回撤区域数据
    index 5 : integer                           # 唯一索引
}



.todo_item {
    item_type 0 : integer # 事项类型
    start_ts 1 : integer # 开始时间
    end_ts 2 : integer # 结束时间
    .capital_war {
        office 0 : integer # 官职id
    }
    capital_war 3 : capital_war # 官职待办时此字段有效
}



.town_interaction_info {    
    shield_end_ts 0 : integer(0) #保护罩结束时间
    shield_cd_ts 1 : integer(0) #保护罩冷却结束时间戳
}



.fishing_checkpoint_fish_info { # 鱼信息
    id 0 : integer      # 鱼id
}

.fishing_checkpoint_param { # 钓鱼检查点客户端参数
    level_id 0 : integer                    # 关卡id
    items 1 : *fishing_checkpoint_fish_info # 勾到的物件id列表 包括鱼,宝箱,纪念品,潜水员等
    max_depth 2 : integer                   # 到达的最大深度
    rewards 3 : *pair_int_int()             # 获得的奖励列表   
}

.cooking_checkpoint_param { # 烹饪检查点客户端参数
    angle 0 : integer # 烹饪的角度值
    option 1 : integer # 1-完美 2-成功 3-失败
}

.fortune_card_checkpoint_param {   # 占卜检查点客户端参数
    slot 0: integer # 翻卡的位置
    flag 1: boolean # 打乱牌组
}

.pin_game_kunai { # 见缝插针苦无信息
    type 0 : integer # 苦无类型
    time 1 : integer # 时间
    angle 2 : integer # 角度
}

.adventure_pve_checkpoint { # 探险检查点信息
    is_win 0 : boolean # true:进攻胜利
}

.dig_treasure_checkpoint_param { # 挖宝检查点客户端参数
    key 0 : integer # 坐标(1000*x+y)
}

.dig_treasure_checkpoint { # 挖宝检查点数据
    key 0 : integer # 坐标(1000*x+y)
    update_brick 1 : brick_info
    treasure 2: dig_treasure_item                   # 铲子挖到的宝物(包含坐标，方便动画效果)
    find_treasure 3: dig_treasure_item              # 本次挖掘发现的宝物(未挖出)
    option 4 : integer # 该片段的结果, 根据本关卡表现会有不同的结果
}

.select_box_checkpoint_param { # 选箱子检查点参数
    select_id 0 : integer # 选择的箱子id
}

.punch_guess_checkpoint_param {
    result 0: integer    # 猜拳结果 1-胜  2-平 3-负
    player_gesture 1: integer # 玩家出拳手势    1-石头， 2-剪刀  3-布
}

.travel_checkpoint_param { # 游历检查点客户端参数
    # （各类型片段的检查点信息需要自行定义）
    .pin_game_checkpoint_param { # 见缝插针检查点客户端参数
        type 0 : integer # 类型 1-进行中 2-结束

        ### 以下是进行时提交的信息
        is_pause 1 : boolean # true暂停 false暂停结束，重新进行游戏

        ### 以下是结束时提交的信息
        kunai_seq 2 : *pin_game_kunai # 扔出苦无的信息
        is_pass 3 : boolean # true通关 false失败(包括超时)
        time 4 : integer # 通关时间
    }
    .relic_adventure_checkpoint_param { # 古迹秘宝检查点客户端参数
        grid_id 0 : integer # 格子id
    }


    cooking_info 0 : cooking_checkpoint_param # 烹饪
    pin_game_info 1 : pin_game_checkpoint_param # 见缝插针
    fishing_info 2 : fishing_checkpoint_param   # 钓鱼
    adventure_pve 3 : adventure_pve_checkpoint # 探险
    dig_treasure_info 4 : dig_treasure_checkpoint_param # 挖宝
    fortune_card 5 : fortune_card_checkpoint_param # 占卜
    relic_adventure_info 6 : relic_adventure_checkpoint_param # 古迹秘宝
    select_box_info 7: select_box_checkpoint_param # 选箱子
    punch_guess_info 8: punch_guess_checkpoint_param # 猜拳
}

.climbtower_checkpoint {  # 爬塔检查点信息
    .climbtower_formation {
        formation_id 0 : integer                    # 编队id
        soldier_info 1 : *pair_int_int()            # 士兵剩余数量
    }

    .climbtower_round_result {
        ret 0 : integer                 # 1:已方胜利 2:己方失败
        atk 1 : climbtower_formation    # 攻方阵容
        def 2 : climbtower_formation    # 守方阵容
    }

    is_win 0 : boolean                    # true:攻方胜利
    round_result 1 : *climbtower_round_result   # 回合结果
}

.monopoly_checkpoint { # 大富翁
    count       0 : integer # 第几次
    points      1 : integer # 投掷的点数
    cheque_id   2 : integer # 达到的格子id
    reward      3 : *item() # 奖励
}

.fortune_card_checkpoint {
    multiple           0 : integer # 本次奖励倍数
    reward_pool_idx    1 : integer # 奖励
}

.festival_turntable_checkpoint {
    slot        0: integer  # 本次抽中的格子
}

.normal_turntable_checkpoint {
    slot        0: integer  # 本次抽中的格子
}

.place_monster_info_checkpoint {
    remain_hp          0 : integer # 剩余血量
    damage             1 : integer # 伤害
    rewards            2 : *pair_int_int() # 伤害奖励
    kill_reward        3 : *pair_int_int() # 击杀奖励
}

.travel_checkpoint { # 游历检查点信息
    # （各类型片段的检查点信息需要自行定义）
    .pin_game_checkpoint { # 见缝插针苦无记录
        mission 0 : integer # 关卡id
        kunai_seq 1 : *pin_game_kunai # 扔出苦无的信息
    }
    .relic_adventure_checkpoint { # 古迹秘宝
        grid 0 : relic_adventure_grid # 变化的格子
    }

    climbtower_info 0 : climbtower_checkpoint   # 爬塔（地心探险）
    cooking_info 1 : cooking_checkpoint_param   # 烹饪
    pin_game_info 2 : pin_game_checkpoint # 见缝插针
    fishing_info 3 : fishing_checkpoint_param   # 钓鱼
    dig_treasure_info 4 : dig_treasure_checkpoint # 挖宝
    monopoly_info 5 : *monopoly_checkpoint       # 大富翁
    fortune_card_info 6 : fortune_card_checkpoint # 占卜
    festival_turntable_info 7 : festival_turntable_checkpoint # 转盘
    place_monster_info 8 : place_monster_info_checkpoint # 砸南瓜
    adventure_pve 9 : adventure_pve_checkpoint # 探险
    relic_adventure_info 10 : relic_adventure_checkpoint # 古迹秘宝
    normal_turntable_info 11 : normal_turntable_checkpoint # 轮盘
}

.fortune_card_base {    #占卜片段基础信息
    level_id 0 : integer                      # 关卡id
    reward_pool 1 : *pair_int_int()           # 奖励池   ( [slot] = idx )
    geted_reward_pool 2 : *pair_int_int()     # 选择的奖励列表  ( [slot] = idx  )
    geted_multiple 3 : *pair_int_int()        # 选择的奖励倍数  ( [slot] = multiple )
    geted_slot_seq 4 : *pair_int_int()        # 选择的顺序 ( slot1, slot2, slot3 ... )
    multiple 5 : integer                      # 当前的倍数
    client_flag 6 : boolean                   # 客户端标记
    group_id 7: integer                       # 组别                 
}

.festival_turntable_base { #转盘基础信息
    level_id 0 : integer                      # 关卡id
    reward_slot_list 1 : *pair_int_int()      # 已经中奖的格子
}

.normal_turntable_base {    # 轮盘基础信息
    level_id 0 : integer                      # 关卡id
    reward_slot_list 1 : *pair_int_int()      # 已经中奖的格子
}

.place_monster_base { # 砸南瓜基础信息
    total_hp    0 : integer           # 总血量
    level_id    1 : integer           # 关卡id
    remain_hp   2 : integer           # 剩余血量
    free_count  3 : integer           # 剩余免费次数
}

.select_box_base { # 选箱子基础信息
    level_id 0 : integer                      # 关卡id
    select_id 1 : integer                     # 选择的箱子id
    exchange_group 2: integer                 # 交换组id
}

.punch_guess_base { # 猜拳基础信息
    level_id 0: integer  # 关卡id
    result 1: integer    # 猜拳结果 1-胜  2-平 3-负  0-未开始
}

.travel_segment { # 游历片段信息
    id 0 : integer         # 片段id
    checkpoint_list 1 : *travel_checkpoint  # 检查点列表
    option 2 : integer  # 片段选项
    rewards 3 : *pair_int_int() # 获得的奖励
    add_favour 4 : integer  # 获得的好感度
    favour 5 : integer # 完成当前片段时好感度
    old_lv 6 : integer # 完成片段前的专家等级
    new_lv 7 : integer # 完成片段后的专家等级

    # 片段的基础信息（各类型片段信息需要自行定义）
    dig_treasure_info 8 : dig_treasure_level
    fortune_card 9 : fortune_card_base
    festival_turntable 10 : festival_turntable_base
    place_monster 11 : place_monster_base
    normal_turntable 12 : normal_turntable_base
    select_box 13 : select_box_base
    punch_guess 14 : punch_guess_base
}

.travel_event { # 游历事件信息
    id 0 : integer

    segment_list 1 : *travel_segment        # 片段列表
    segment_idx 2 : integer                 # 当前的片段索引
}

.travel_segment_record { # 游历片段记录信息
    id 0 : integer          # 片段id
    option 1 : integer      # 选择的选项
    rewards 2 : *pair_int_int() # 获得的奖励
    add_favour 3 : integer  # 获得的好感度
    favour 4 : integer      # 完成时的好感度
    old_lv 5 : integer # 完成片段前的专家等级
    new_lv 6 : integer # 完成片段后的专家等级
}

.travel_expert_reward {
    id 0 : integer # 专家id
    add_favour 1 : integer  # 获得的好感度
    favour 2 : integer # 当前好感度
    new_lv 3 : integer # 当前专家等级
}


.triangle_war_stat {
    type 0 : integer
    count 1 : integer
}

.triangle_war_player {
    uid 0 : integer
    aid 1 : integer(0)
    stat 2 : *triangle_war_stat()
}

.triangle_war_alliance {
    aid 0 : integer(0)
    stat 1 : *triangle_war_stat()
    occupy_building 2 : *integer # 占领建筑id
}

.triangle_war_camp {
    camp 0 : integer
    aid 1 : integer(0)
    kid 2 : integer
    abbr 3 : string
    aname 4 : string
    flag 5: integer
    flag_bg 6 : integer
    stat 7 : *triangle_war_stat()
    commanders 8 : *pair_int_int()  # 指挥官uid列表 {[slot_id] = uid}
}

.triangle_war_path_point {
    dst 0 : integer # 目标点id
    t 1 : integer # 行军时间毫秒
}

.triangle_war_march {
    id 0 : integer #队列唯一id
    owner 1 : integer # 玩家id

    startpointid 2 : integer # 移动开始建筑id
    endpointid 3 : integer # 当前所在建筑id、移动目标建筑id
    starttime 4 : integer(0) # 移动开始时间
    endtime 5 : integer(0) # 移动结束时间、复活结束时间
    path 6 : *triangle_war_path_point # 路径，不做增量更新

    state 7 : integer #状态
    squad_list 8 : triangle_war_formation   #出征小队信息用于表现 这个字段直接覆盖，不做增量更新
    camp 9 : integer # 阵营 1,2,3
    equiped_skin 10 : *skin_slat_detail(skintype)	# 装扮列表，不做增量更新
    power 11 : integer(0) # 战力
    formationid 12 : integer
    move_rate 13 : double # 当前已移动的比例
    origin_power 14: integer(0) # 满兵时的战力
}

.triangle_war_march_del_keys {
    startpointid 0 : boolean
    endpointid 1 : boolean
    starttime 2 : boolean
    endtime 3 : boolean
    path 4 : boolean
    move_rate 5 : boolean
}

.triangle_war_food_info { # 食物信息
    food_value 0 : integer           # 当前食物数量
    pre_recover_value 1 : integer    # 每秒恢复量
    last_time 2 : integer            # 上次恢复的时间
}

.triangle_war_player_info_by_appoint { # 玩家任命需要的显示信息
    uid 0 : integer             # uid 
    food_value 1 : integer      # 当前食物数量 
}

.triangle_war_player_map {
    camp 0 : integer
    uid_set 1 : *pair_int_bool()
}

.triangle_war_information_info { # 资讯信息
    .information_occupy { # 占领信息
        aid 0 : integer(0)     # 联盟id
        bid 1 : integer     # 建筑id
    }

    .information_defense {          # 防守成功
        abbr 0 : string             # 联盟简称
        name 1 : string             # 玩家名字
        bid 2 : integer             # 建筑id
    }

    .information_tag {              # 标记
        type 0 : integer            # 标记类型
        bid 1 : integer             # 建筑id
    }

    type 0 : integer                                # 类型 1-占领 2-标记 3-防守成功
    id 1 : integer                                  # 资讯唯一id
    information_occupy 2 : information_occupy       # 占领资讯信息
    information_defense 3 : information_defense     # 防守成功
    information_tag 4 : information_tag             # 标记
    time 5 : integer                                # 时间
}

.triangle_war_building_battle_report { # 建筑战报信息
    time 0 : integer                        # 时间
    win 1 : boolean                         # 是否攻方胜利
    atk_uid 2 : integer                     # 攻击方玩家
    atk_formation_id 3 : integer            # 攻击方部队编号
    atk_abbr 4 : string                     # 攻击方联盟简介
    atk_camp 5 : integer                    # 攻击方阵营
    atk_power 6 : integer(0)                # 攻击方战力值
    atk_total_soldier_count 7 : integer(0)  # 攻击方总士兵数量
    atk_loss_soldier_count 8 : integer(0)   # 攻击方损失的士兵数量
    def_uid 9 : integer                     # 防守方玩家
    def_formation_id 10 : integer           # 防守方部队编号
    def_abbr 11 : string                    # 防守方联盟简介
    def_camp 12 : integer                   # 防守方阵营
    def_power 13 : integer(0)               # 防守方战力值
    def_total_soldier_count 14 : integer(0) # 防守方总士兵数量
    def_loss_soldier_count 15 : integer(0)  # 防守方损失的士兵数量
    def_is_npc 16 : boolean                 # 防守方是否是npc
    report_id 17 : integer                  # 战报id
}

.triangle_war_formation_hero {
    pos 0 : integer
    id 1 : integer      # 英雄id
    lv 2 : integer      # 等级
    training_lv 3 : integer # 训练营等级
    star 4 : integer    # 星级
}

.triangle_war_soldier {
    id 0 : integer      # 士兵id
    count 1 : integer   # 数量
}

.triangle_war_formation {
