.kingdom_showinfo {
	name 0: string #王国名字
	flag 1: integer #王国旗帜

	abbr 2: string #总统联盟简称
	nickName 3 : string #总统昵称
	owner_kid 4 : integer #占领者王国ID
	super_count 5 : integer #连续强盛次数
}

.capital_war_skill_cell {
	id 0 : integer #技能ID

	.value {
		use_count 0: integer #使用次数
		use_time 1: integer #使用时间
	}
	value 1: value
}

.president_data {
	.office_cell {
		office 0: integer #职位
		.value {
			uid 0: integer #玩家ID
			time 1: integer #操作时间
		}
		value 1: value
	}

	.gift_data {
		.uid_cell {
			uid 0 : integer
			flag 1 : boolean
		}
		uid_set 0 : *uid_cell()

		.gift_cell {
			giftid 0 : integer
			num 1 : integer
		}
		gift_map 1 : *gift_cell()
	}

	office_map 0 : *office_cell() 
	dominance 1: integer 
	skill_info_map 2: *capital_war_skill_cell() 
	gift_data 3: gift_data 

	uid 4: integer #总统UID
	abbr 5 : string #联盟简称
	nickName 6 : string #总统名字
	image 7 : integer #总统形象
	aid 8 : integer(0) #联盟ID

	manifesto 9 : string #宣言
    term 10 : integer #第x任总统

	kingdom_name 11: string #王国名字
	kingdom_flag 12: integer #王国旗帜

	modify_manifesto_ts 13 : integer # 宣言修改时间
	modify_name_ts 14 : integer #王国名字修改时间
	kid 15 : integer # 国王kid, 任命国王时下发
	vassal_kid 16 : integer # 附属国kid
	aname 17 : string # 联盟名字
	modify_name_count 18 : integer # 修改名字次数
	manifesto_like_id 19 : integer(0) # 宣言点赞ID, 次字段为nil或者0时表示没有点赞ID, 客户端应该隐藏点赞相关ui
	office_mode 20 : integer # 官职模式
	office_mode_ts 21 : integer(0) # 官职模式设置时间
	is_cross_mode 22 : boolean # 是否跨服模式 false或者nil时表示单王国模式
}

.capital_war_buff_cell {
	id 0 : integer

	.value {
		value 0: integer
		endtime 2: integer 
		starttime 3 : integer
	}
	value 1: value
}

.capital_war_apply_info {
	id 0 : integer #官职ID
	ts 1 : integer(0) #申请时间
	status 2 : integer # 0 申请通过, 1 申请拒绝
}

.capital_war_application_info {
	uid 0 : integer
	ts 1 : integer(0) # 申请时间
}

.schedule_skill_data {
	skill_id 0 : integer
	enemy_effect 1 : boolean # 是否对敌方生效
}

.capital_war_president_record {
	abbr 0 : string
	nickName 1 : string
	time 2 : integer
	image 3 : integer
	uid 4: integer
	kid 5 : integer # 国王kid
	is_cross_mode 6 : boolean # 是否跨服模式
}

.capital_war_apply_slot_info {
	office 0 : integer # 官职id
	idx 1 : integer # 时段id
	in_order 2 : boolean # 是否作为内定人
	del 3 : boolean # 被删除内定人时为true
}



.card_battle_pass {
    id 0 : integer                  # 活动id
    start_ts 1 : integer            # 活动开始时间
    end_ts 2 : integer              # 活动结束时间
    serial_no 3 : integer           # 活动序列号
    progress 4 : integer            # 积分
    .reward_mark {
        id 0 : integer # 阶段ID
        mark 1 : boolean # 是否被领取
    }
    free_reward 5 : *reward_mark()       # 已领取的免费奖励id
    buy_reward 6 : *reward_mark()        # 已领取的付费奖励id
    buy_gift_id 7 : integer         # 已购买的周卡/月卡礼包ID, 为0表示未购买
    bp_conf_id 8 : integer          # 月卡通行证此字段才有意义, 用于索引month_integral_battle_pass表
    available_gift 9 : *reward_mark() # 可以购买的礼包ID
    selected_gift 10 : integer # 选择的礼包ID, nil时表示未设置
    gift_step_map 11 : *pair_int_int() # 上一期的礼包代数, {[礼包类型]=代数}
    pay_type      12 : integer # 付费类型
}


.chapter_reward {
    id 0 : integer			# id
	get_flag 1 : boolean		# true 领取
}

.chat_u2t{
    uid 0 : integer			# 玩家id
	time 1 : integer		# 时间
}

.temporary_block {
    uid 0 : integer
    start_ts 1 : integer
    end_ts 2 : integer
}

.p2p_history_del {
    uid 0 : integer
    del_ts 1 : integer(0)
}

.chat_at {
    ts 0 : integer(0)
    type 1 : integer # @类型, 1@所有人, 2单独@
    ms 2 : integer(0)
    mid 3 : string # 对应的消息mid, 撤回时为撤回的那条@的mid
    del 4 : boolean # 撤回at时此标记为true
}

.chat_read_mark {
    room_id 0 : integer(0)
    .s_value {
        ms 1 : integer(0) # 已读的毫秒
        mid 2 : string    # 已读的消息id
    }
    mark 1 : s_value
}

# 聊天分享请求通用信息
.chat_share_common_info {
    type 0 : integer			# 分享类型 1-联盟 2-群聊 3-个人 4-王国 5-群发多人 6-联盟r4 详见share_type
	params 1 : *integer(0)	    # 分享参数列表 群聊时带上群组id, 个人时带上uid等
	msgtype 2 : integer	        # msgtype
	msg 3 : string	            # msg
    reply_mid 4: string         # nil/回复的消息id
}

# 聊天分享返回通用信息
.chat_share_common_return_info {
    rtmcode 0 : integer
    mid 1 : string
    msg 2: string
    lv_limit 3 : integer        # 对方设置的私聊等级, code=1819时, 此字段才有意义
    beblocklist 4 : *integer    # 对方屏蔽了你
    broadcast_ts 5 : integer    # 上次发送广播时间戳
    attrs 6 : string            # 返回发送的attrs
    succ_list 7 : *integer      # 成功发送的uid列表
}

# 货车分享信息
.chat_truck_share_info {
    kid 0 : integer             # 被分享者的王国id
    uid 1 : integer             # 被分享者的uid
    id 2 : integer              # 被分享者的队列id
}

# 家园聊天分享信息
.chat_homeland_share_info {
    uid 0 : integer             # 被分享者的uid 自己或者被查看家园的其他人
}

.chat_alliance_vote_share_info {
    id 0 : integer             # 投票ID
}

.chat_expression_info {
    ids 0 : *integer
    broadcast 1 : boolean   # 是否广播
}

# 联盟城墙灭火分享
.chat_wall_outfire_share_info {

}

# 寻物房间邀请分享
.chat_find_goods_room_invite_info {
    room_id 0 : string       # 房间ID
}

# 联动大富翁组队邀请分享
.chat_linkage_monopoly_team_invite_info {
    activity_id 0 : integer  # 活动 ID
}

.chat_favorite_share_info {
    kid 0 : integer
    x 1 : integer
    y 2 : integer
    key 3 : string
    name 4 : string
    flag 5 : integer
}

.chat_mail_share_info {
    mailid 0 : string
    type 1 : integer        # 分享类型:1.分享邮件 2.转发分享
}

# 爬塔分享信息
.chat_climbtower_info {
    report_id 0 : integer       # 爬塔战报id
}

# 3v3分享信息
.chat_slg_3_league_info {
    match_id 0 : integer       # 3v3比赛id
    game_idx 1 : integer       # 轮次ID
    round_idx 2 : integer      # 回合ID
    src_key 3 : string         # 战报ID, 转发战报时需要这个字段, 分享战报时此字段为nil
}

.chat_group_vote_share_info {
    group_id 0: integer(0)          # 群组id
    id 1 : integer                  # 投票ID
}

.p2p_mark {
    k 0 : integer
    v 1 : integer(0)
}

.room_mark {
    k 0 : integer(0)
    v 1 : integer(0)
}


.chat_group {
    group_id 0 : integer(0) # 群ID
    owner_uid 1 : integer # 群主
    name 2 : string # 群名
    uid_arr 3 : *integer # 群成员, 按照进群时间排序, 进群早的在前面
    create_ts 4 : integer # 创建时间
    invite_review 5 : boolean # 权限审核  开-true  关-false
    member_count 6 : integer    # 成员数量（包含群主）
}

.chat_group_info {
    owner_group_arr 0 : *integer(0) # 我是群主的群
    member_group_arr 1 : *integer(0) # 我是群成员的群
}

.user_agent_channel_tb {
    .msg_queue_data {
        mid 0: integer(0)   # 消息id
        from_uid 1: integer # 发送者uid
        ts 2 : integer # 服务端接收的时间戳
        ms 3 : integer # 客户端发送的时间戳
        type 4: integer # 消息@的类型
        del 5: boolean # 是否是撤回消息
    }
    .single_channel_data {
        msg_queue 0: *msg_queue_data
        clean_ts 1: integer
    }

    .all_channel_data {
        key 0 : integer
        value 1 : single_channel_data
    }

    .agent_channel_data {
        channel_data 0 : *all_channel_data()
    }
    chat 0: agent_channel_data
    group_chat_at 1: agent_channel_data
}

.invite_info {
    uid 0: integer  # 被邀请者
    inviter 1: integer # 邀请者
    ts 2: integer(0)    # 邀请时间
}

.chat_group_invite_info {
    group_id 0: integer(0)
    invite_list 1: *invite_info
}

.chat_group_notice_info{
    uid 0: integer      # 发布者
    notice 1: string    # 公告内容
    ts 2: integer(0)    # 发布时间
    uuid 3: string      # 历史公告唯一id，仅在历史公告数据中才会传
}




.chat_group_vote_player { # 投票记录玩家信息
    uid 0 : integer             # uid
    nickName 1 : string         # 昵称
    power 2 : integer(0)        # 实力
    stove_lv 3 : integer        # 火炉等级
    abbr 4 : string             # 联盟简称

}

.chat_group_vote { # 投票
	id 0 : integer # 投票ID
    uid 1 : integer
    is_multi 2 : boolean # 是否多选
    st 3 : integer # 开始时间
    et 4 : integer # 结束时间
    title 5 : string # 标题
    options 6 : *string # 选项

    # 成员选择
    selects 7 : *pair_int_int() # 选择数据{[uid]=选择值, ...}, 选择值为(选择1|选择2|...), 选择n=(1<<(n-1))

    # 记录
    total 8 : integer # 群聊人数
    s_uname 9 : string # 发起者昵称
    e_uname 10 : string # 结束者昵称
    s_abbr 11 : string # 发起者联盟简称
    e_abbr 12 : string # 结束者联盟简称
}



.city_field_effect_info {
    map_type 0 : integer    # 地图类型 : 1-大世界
    data 1: *pair_long_int()  #   { 领域ID: 提供者uid }    
}


.ttl_item { #时效物品
    id 0 : integer #ID
    itemid 1 : integer #itemid
    starttime 2 : integer #开始时间
    endtime 3 : integer #结束时间
    free_id 4: integer #免费id
    cd_endtime 5 : integer #cd 结束时间
    is_new 6 : boolean # 新手保护罩
}



.client_survivor_data {           # 在客户端计算的属性
    sid 0 : integer
    res601 1 : double
    res602 2 : double
    res603 3 : double
    res604 4 : double
    res607 5 : double
}

.client_data {
    law_point 0 : integer(0)        # 法典值
    survivor 1 : *client_survivor_data(sid) # 幸存者在客户端计算的属性
}


.climbtower_tower_info {
    id 0 : integer                                  # 塔id
    daily_fail 1 : integer                          # 今日失败次数
    cur_passed_level 2 : integer                    # 当前已通关关卡
    his_passed_level 3 : integer                    # 截止上周最高通关关卡
    sweep_cnt 4 : integer                           # 扫荡次数
    unread_report_cnt 5 : integer                   # 未读战报数量
    completed_cnt 6: integer                        # 通关该塔次数
}

.climbtower_level_info {
    .climbtower_alliance_member {
        uid 0 : integer                             # 盟友uid
        passed_ts 1 : integer                       # 关卡通关时间
        power 2 : integer(0)                        # 战力
    }

    id 0 : integer                                          # 关卡id
    alliances 1 : *climbtower_alliance_member               # 正在挑战当前关卡的盟友
    finish_alliances 2 : *climbtower_alliance_member        # 已通关当前关卡的盟友（仅最后一关有值）
}

.climbtower_report_record {
    .climbtower_player_info {
        nickName 0 : string                 # 玩家名称
        abbr 1 : string                     # 联盟简称
    }

    .hero_data {
        id 0 : integer
        star 1 : integer
        lev 2 : integer
        training_lev 3 : integer
    }
    .pos_hero_pair {
        pos 0 : integer
        hero 1 : hero_data
    }

    .climbtower_cover_formation {
        hero_map 0 : *pos_hero_pair()               # 英雄map {[位置] = 英雄数据}
        soldier_map 1 : *battle_soldier(id)         # 上阵士兵map
        remain_soldier_cnt 2 : integer              # 剩余士兵
        playerinfo 3 : climbtower_player_info       # 玩家信息（仅己方信息有值）
    }

    .climbtower_report_cover {
        time 0 : integer                            # 战斗时间戳
        is_win 1 : boolean                          # 是否获胜
        atk_info 2 : climbtower_cover_formation     # 己方信息
        def_info 3 : climbtower_cover_formation     # 敌方信息
    }

    .climbtower_brief_report {
        id 0 : integer                                      # 战报id
        read_flag 1 : boolean                               # 是否已读
        cover 2 : climbtower_report_cover                   # 战报封面数据
    }

    level_id 0 : integer                                    # 关卡id
    infos 1 : *climbtower_brief_report                    # 战报简要数据
}


.continuous_recharge_info {
    round 0 : integer               # 轮次
    amount 1 : integer              # 充值金额
}

.continuous_recharge_reward {
    round 0 : integer               # 轮次
    mark 1 : boolean                # true表示已领取
}

.continuous_accumulative_reward {
    idx 0 : integer                 # 宝箱下标, 根据宝箱奖励配置day字段排序
    mark 1 : boolean
}

.continuous_recharge_act_info {     # 活动数据
    id 0 : integer                  # 活动id
    start_ts 1 : integer            # 开始时间
    end_ts 2 : integer              # 结束时间
    daily_reward_ts 3 : integer     # 上次领取每日免费礼包的时间
    recharge_info 4 : *continuous_recharge_info()   # 充值金额
    recharge_reward 5 : *continuous_recharge_reward()       # 已领取的充值礼包
    accumulative_reward 6 : *continuous_accumulative_reward() # 已领取的宝箱奖励
}


.cross_capital_war_match_info { # 匹配信息
    state 0 : integer # 1.匹配成功 2.轮空
    kids 1 : *integer # 匹配王国列表
}

.cross_capital_war_kingdom { # 王国数据
    is_win 0 : boolean # 是否是胜利方
    open_shop_time 1 : integer(0) # 商店第一次开启时间(默认nil)
}

.cross_capital_war_activity { 	# 跨服活动数据
	season 0 : integer # 赛季
	stage 1 : integer # 阶段 # 1.预匹配(不展示) 2.匹配 3.预告 4.军备 5.战斗 6.复活 0.关闭
    stage_ts 2 : *integer(0) # 阶段时间数组
    match_info 3 : cross_capital_war_match_info
    group_id 4 : integer # 活动奖励分组ID
}

.cross_capital_war_arms_race { # 军备阶段数据
    sub_stage_idx 0 : integer # 当前子阶段索引
    sub_stage_ts 1 : *integer(0) # 子阶段时间数组
    personal_goal 2 : integer(0) # 当前阶段个人分数
    alliance_goal 3 : integer(0) # 当前阶段联盟分数
    .received_mark {
        id 0 : integer # 阶段
        value 1 : *pair_int_bool() #key=积分值,value=是否被领取
    }
    alliance_received 4 : *received_mark() # 联盟已领取的奖励
    received 5 : *received_mark() # 个人已领取的奖励
    expert_mark 6 : *pair_int_int() #key=阶段,value=技能等级
}

.cross_capital_war_fight { # 争霸阶段数据
    attack_side_kid 0 : integer # 攻击方王国ID
    winner_kid 1 : integer # 胜利方王国ID
    personal_goal 2 : integer(0) # 当前阶段个人分数
    alliance_goal 3 : integer(0) # 当前阶段联盟分数
    alliance_received 4 : *pair_int_bool() # 联盟已领取的奖励,key=积分值,value=是否被领取
    received 5 : *pair_int_bool() # 个人已领取的奖励,key=积分值,value=是否被领取
}

.cross_capital_war_player  { # 玩家数据
    score 0 : integer # 徽记
    received 1 : *pair_int_bool() # 已领取的徽记奖励
    arms_race 2 : cross_capital_war_arms_race # 军备阶段数据
    revive_data 3 : cross_capital_war_revive # 复活阶段数据
    fight 4 : cross_capital_war_fight # 争霸阶段数据

    .received_mark {
        id 0 : integer # 徽记数量(personal_emblem_reward字段emblem_num)
        items 1 : *pair_int_int()
    }
    extra_received 5 : *received_mark() # 已领取的额外奖励
}

.cross_capital_war_revive { # 复活阶段数据
    dead_map 0 : *pair_int_int()    # 死亡的士兵数量
    revive_map 1 : *pair_int_int()  # 已经复活的士兵数量
    revive_coupon 2 : integer       # 复活券数量
    use_medkit_count 3 : integer    # 已经使用急救包的数量
    receive_help_times 4 : integer  # 已收到的帮助次数
    call_alliance_help_ts 5 : integer # 上一次发送联盟请求的时间
}

.cross_capital_war_revive_brief {   # 其他玩家复活数据摘要
    uid 0 : integer
    stage_score 1 : *integer(0)        # 活动阶段分数
    revive_coupon 2 : integer       # 复活券数量
    use_medkit_count 3 : integer    # 已经使用急救包的数量
    receive_help_times 4 : integer  # 已收到的帮助次数
    total_dead_soldier 5 : integer  # 总死亡士兵数量
    call_help 6 : boolean           # 是否请求帮助
}

.cross_capital_war_rank_type {  # 排行榜类型和id
    rtype 0 : integer   # 排行榜类型
    key 1 : integer(0)     # 目标的id
}

.cross_capital_war_rank_data {  # 排行榜数据
    rtype 0 : integer   # 排行榜类型
    key 1 : integer(0)     # 目标的id
    rank 2 : integer    # 排名
    value 3 : *integer(0) # 数据,默认是[分数, 时间, 王国]
}



.cross_most_lords_info {
    id 0 : integer
    cur_stage 1 : integer # 当前阶段
    cur_integral 2 : integer #当前阶段积分
    total_integral 3 : integer #总积分

    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 4 : *received_mark() # 当前阶段已领取的奖励
    cur_stage_end_ts 5 : integer #当前阶段结束时间
    stove_lv 6 : integer #活动开启时的熔炉等级
    warzone_day 7 : integer #活动开启时服务器的战区天数
    start_ts 8 : integer #活动开启时间(不包含预告)
    end_ts 9 : integer #活动结束时间(不包含结算)
    special_integral 10 : integer # 荣誉勋章
    special_received 11 :*received_mark() # 荣誉勋章领奖记录
    kingdom_arr 12 : *integer #王国ID数据
}


.customize_item_buy_boxdata {
    boxid 0 : integer   #格子id  
    items 1 : *item()
}

.customize_item_buy_recode {
    idx 0 : integer     #索引id
    boxdata 1 : *customize_item_buy_boxdata() #最后一次购买物品信息
}

.customize_item {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    buy_info 3 : *pair_int_int()    # 购买情况 【索引id】= 购买次数 （nil 则未购买）
    free_box_get_time 4 : integer   # 免费宝箱领奖时间 nil未领取
    last_buy_items_record 5 : *customize_item_buy_recode() #最近购买道具
}



.daily_bundle_data {
    buy_status 0 : *pair_int_bool() # 购买状态
    reset_ts 1 : integer            # 重置时间
    group 2 : integer               # 礼包分组
    hero_id 3 : integer             # 英雄id，当天未选择时发nil
    free_gift 4 : boolean           # 免费奖励是否领取
}



.daily_claim_info {
    id                    0 : integer # 活动ID
    start_ts              1 : integer # 活动开启时间
    end_ts                2 : integer # 活动结束时间
    serial_no             3 : integer # 活动序列号
    reward_group          4 : integer # 奖励组ID

    free_reward_ts        5 : integer # 免费奖励领取时间
    receive_slot_index    6 : integer # 已领取的天数格子 （每次全部领取）
    has_pay               7 : boolean # 已购买领取权限
    main_index            8 : integer # mian表index, reward_group没有删除也会带下去
}



.daily_task_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间

    .mark {
        id 0 : integer
        value 1 : boolean
    }
    received_reward 3 : *mark() #已领取的积分奖励 {[积分值]=true}
    quests 4 :  *quest()    #未领奖且有进度的任务
    finishs 5 : *finishs()    #已领奖任务
    integral 6 : integer #积分
}







.dig_treasure_task_info {
    finishs 0 : *finishs()                              # 已领奖任务
    quests 1 : *quest()                                 # 进行中的任务
}

.dig_treasure_info {
    id 0 : integer                                      # 活动id
    start_ts 1 : integer                                # 活动开始时间
    end_ts 2 : integer                                  # 活动结束时间
    serial_no 3 : integer                               # 活动序列号

    pass_level 4 : integer                              # 当前通关关卡id

    task_info 5 : dig_treasure_task_info                # 任务数据
    gift_group_arr 6 : *integer                         # 礼包组
    is_start_level 7 : boolean                          # 是否正在进行关卡
    level_data 8 : dig_treasure_level                   # 关卡数据
}

.brick_info {
    key 0 : integer                                     # 格子key(1000 * x + y)
    id 1  : integer                                     # 砖块id
    hp  2 : integer                                     # 剩余耐久
}

# 宝物
.dig_treasure_item {
    key 0 : integer                                     # 锚点坐标(1000 * x + y)
    id 1 : integer                                      # 宝物id
}

# 棋盘数据
.dig_treasure_chessboard {
    level_id 0 : integer                                # 关卡id
    bricks 1 : *brick_info(key)                         # 棋盘存在变化的砖块数据
    treasures 2 : *dig_treasure_item(key)               # 埋在地图中的宝物列表(包含坐标信息)
}

.dig_treasure_level {
    level 0 : integer                                   # 关卡等级
    chessboard 1 : dig_treasure_chessboard              # 棋盘数据
    get_treasures 2: *integer                           # 已收集到的宝物id列表(id会重复，因为一个关卡里面会出现多个同id的宝物)
}

# 鼹鼠事件结构
.dig_treasure_mole {
    id 0 : integer                                      # 鼹鼠id
    key 1 : integer                                     # 鼹鼠出现的坐标
    update_arr 2 : *brick_info(key)                     # 更新的砖块列表
    treasures 3 : *dig_treasure_item(key)               # 鼹鼠挖出来的宝物(已挖出)
    find_treasure 4: *dig_treasure_item(key)            # 本次挖掘发现的宝物(未挖出)
}

.dig_treasure_settlement {
    id 0     : integer                                  # 活动id
    level 1  : integer                                  # 关卡
    result 2 : integer                                  # 1:成功;2:失败;3:活动结束;
    rewards 3: *item()                                  # 奖励道具
    costs 4  : *item()                                  # 消耗的道具(目前只有铲子)
    next_level 5: integer                               # 下一关挑战的关卡
}


.int_bool_map_item {
    i 0: integer
    b 1 :boolean
}





.duck_market_floor { # 楼层信息
    id 0 : integer              # 楼层id
    reward_list 1 : *integer    # 奖励id列表: duckmarket_reward.index
}

.duck_market { # 市集数据
    group_type 0 : integer                  # 奖池组类型: 1-普通奖池组 2-特殊奖池组
    group_id 1 : integer                    # 奖池组id: duckmarket_gacha.group
    floor 2 : integer                       # 当前楼层
    is_down 3 : boolean                     # 是否触发过降层
    floor_infos 4 : *duck_market_floor      # 楼层信息
    reward_flag 5 : integer                 # 领奖标识: 0-不可领奖（初始位于第1层）1-可领奖 2-已领奖

    .gacha_info { # 抽取信息
        effect 0 : integer      # 楼层升降效果: 1-升1层 2-升2层 3-升3层 4-降1层 5-降2层
        is_protect 1 : boolean  # 是否触发降层保护
    }
    last_gacha_info 6 : gacha_info          # 上一次抽取结果
    protect_num 7 : integer                 # 降层保护次数
    total_star 8 : integer                  # 累计星星数量
}

.duck_market_act_info {
    id 0 : integer                  # 活动ID
    start_ts 1 : integer            # 活动开启时间
    end_ts 2 : integer              # 活动结束时间
    market_info 3 : duck_market     # 市集数据
    cost_item_cnt 4 : integer       # 累计消耗的道具数量
    rewarded_idx_lst 5 : *integer   # 已领取的额外奖励id列表: duckmarket_extra_reward.index
    extra_reward_group_id 6 : integer # 消耗奖励分组
    interation_id 7 : integer # 奖励分组
}

.duck_market_task_info {
    quests 0 :  *quest()        # 未领奖且有进度的任务
    finishs 1 : *finishs()      # 已领奖任务
}








.equip_detail_info {
	uid 0 : integer			# 装备唯一id
	eid 1 : integer 		# 装备ID
	slv 2 : integer         # 强化等级
	exp 3 : integer  		# 强化经验
	rlv 4 : integer  		# 专精等级
	sid 5 : integer 		# 槽位id
	hid 6 : integer 		# 英雄id
	chg 7 : boolean         # 装备属性是否非原始状态  nil 原始
	slv_ts 8 : integer 		# 强化等级重铸时间
	rlv_ts 9 : integer 		# 专精等级重铸时间
}

.equip_info {
	eid 1 : integer 		# 装备ID
	sid 2 : integer         # 槽位id
	hid 3 : integer  		# 英雄id
	uid 4 : integer 		# 装备唯一id
}

.equip_common {
	eid 0 : integer 		# 装备ID
	count 1 : integer 		# 数量
}

.equip_item {
	item 0 :*item()
	equip_common 1 : *equip_common()
	uid_equip 2 : *integer
}

.equip_detail_change {
	type 0 : string  # add:添加 del:减少 chg：变化
	equip_detail 1 : *equip_detail_info(uid) 
}

.eid2uid {
	eid 0 : integer
	uid 1 : integer
}


.exchange_activity {
    base 0 : activity_base          # stage_ts [1]预告开始 [2]活动开始 [3]展示阶段开始 [4]活动结束
    exchange_times_map 1 : *pair_int_int() # 兑换次数
    group 2 : integer # 组id
}



.expert_skill_effect{
    id 0 : integer # 技能效果类型
    last_refresh_time 1 : integer    # 上次刷新时间

    # 各技能效果自行定义
}

.expert_skill {
    id 0 : integer
    lv 1 : integer      # 技能等级
    exp 2 : integer     # 技能熟练度
    end_ts 3 : integer  # 学习结束时间戳
    learn_time 4 : integer # 本次技能学习时长
    effects 5 : *expert_skill_effect(id) # 技能效果信息
}

.expert {
    id 0 : integer
    favour 1 : integer              # 好感度
    level 2 : integer               # 专家等级
    break_lv 3 : integer            # 专家阶数
    room_unlocked 4: boolean        # 房间是否解锁
    story_rewarded 5: boolean       # 专家故事奖励是否领取
    unlock_ts 6: integer            # 解锁时间戳
    drawing_lv 7 : integer          # 专家图纸等级
    skills 8 : *expert_skill        # 技能
}

.expert_effect_source { # 技能效果来源
    .effect_skill {
        id 0 : integer
        .skill_info{
            lv 0 : integer
        }
        info 1 : skill_info
    }

    expert_id 0 : integer
    skills 1 : *effect_skill()
}


.favorite_mini_programs_info {
    is_add 0 : boolean                          # 是否添加收藏
    is_reward 1 : boolean                       # 是否领奖 
}

.favorite_mini_programs_sign {
    last_sign_ts 0 : integer(0)                 # 上次签到时间
    sign_count 1 : integer                      # 累计签到次数
    sign_reward 2 : *pair_int_bool()            # 签到奖励领取情况 {[sign_count]=true}
}

.favorite_mini_programs_sign_info {
    type 0 : integer                            # 5 - 微信签到 6 - 抖音签到
    info 1 : favorite_mini_programs_sign()
}

.favorite_mini_programs {
    type 0 : integer                            # 1-小程序收藏奖励 2-小程序桌面奖励 3-抖音添加桌面 4-抖音添加侧边栏
    info 1 : favorite_mini_programs_info
}



.tab_data {                     # 标记信息
    type 0 : integer            # 类型
