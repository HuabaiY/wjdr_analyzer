.value_exchange {
    id 0 : integer                  # 活动id
    preview_ts 1 :integer(1)        # 预览开始时间
    start_ts 2 : integer(1)         # 活动开始时间
    end_ts 3 : integer(1)           # 活动结束时间
	exchange_data 4 : *pair_int_int() # 兑换情况 [物品索引]=已兑换数量
    version 5:integer #组id
    is_free_exchange 6 : boolean #免费兑换标记
}



.version_up_activity { 	# 对象
    id 0 : integer # 活动ID
	starttime 1 : integer # 开始时间
	endtime 2 : integer # 结束时间
    rewards 3 : *integer # 更新奖励 # {id,count,id,count,...}
    .platform_version {
        id 0 : integer # 平台ID 1.apple 2.google
        version 1 : string # 版本号
    }
    versions 4 : *platform_version(id) # 平台对应版本号
}



.vip_data {
    vip_lv 0 : integer      # vip等级
    vip_exp 1 : integer     # vip经验
