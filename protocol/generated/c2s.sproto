        total_points            2 : integer # 总点数
        play_info               3 : *play_dice_info # 投掷的信息
        chg_cheque              4 : *cheque_detail_info() # 改变的格子
        adventure_box_cheque_id 5 : integer # 探险宝箱所在的格子id
    }
}

