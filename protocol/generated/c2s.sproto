req_climbtower_challenge 20463 { # 挑战关卡
    request {
        id 0 : integer                                  # 关卡id
        formation_prefab 1 : *formation_build_pair()    # 编队
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .climbtower_formation {
            formation_id 0 : integer                    # 编队id
            soldier_info 1 : *pair_int_int()            # 士兵剩余数量
        }

        .climbtower_round_result {
            ret 0 : integer                 # 1:已方胜利 2:己方失败
            atk 1 : climbtower_formation    # 攻方阵容
            def 2 : climbtower_formation    # 守方阵容
        }

        .climbtower_battle_result {
            atk_power 0 : integer(0)                    # 攻方战力
            def_power 1 : integer(0)                    # 守方战力
            round_result 2 : *climbtower_round_result   # 回合结果
        }

        code 0 : integer
        is_win 1 : boolean                              # 是否获胜
        first_reward 2 : *item()                        # 首通奖励
        normal_reward 3 : *item()                       # 通关奖励
        battle_result 4 : climbtower_battle_result      # 战斗结果
        formation_prefab 5 : *formation_build_pair()    # 实际上阵的编队
    }
}

