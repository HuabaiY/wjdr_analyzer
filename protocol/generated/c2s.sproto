req_alliance_duel_get_history 16358 { # 获取联盟对决历史记录
	request {
		idx 0 : integer # 页起始下标
		size 1 : integer # 页大小
	}
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0 : integer
        .alliance_info {
            aid 0 : integer(0)
            score 1 : integer(0)
            kid 2 : integer
            name 3 : string # 联盟名字
            abbr 4 : string
            flag 5 : *integer
            flag_bg 6 : *integer
        }
        .duel_content {
            res 0 : integer # 对决结果 1 赢 2 平局 3 输
            alliance 1 : alliance_info # 己方联盟数据
            opponent 2 : alliance_info # 敌方联盟数据
        }
        .duel_mvp {
            uid 0 : integer
            name 1 : string
            abbr 2 : string
        }
		.duel_data {
