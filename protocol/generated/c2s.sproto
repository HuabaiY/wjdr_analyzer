        mass_end_time   2 : integer     # 活动结束时间
        cool_end_time   3 : integer     # 冷却结束时间
        donate          4 : integer     # 捐献数量
        total_score     5 : integer(0)  # 全盟总积分
        reserve_time    6 : integer     # 预约时间
    }
}

