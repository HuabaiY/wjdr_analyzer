        level 11 : integer      # 火堆等级
        item_use 12 : *pair_int_int() # 使用道具
        cost_time 13 : integer # 耗时

        client_power 14 : integer # 客户端拥有的能量
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
