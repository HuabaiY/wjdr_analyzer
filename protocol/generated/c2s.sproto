# 信件处理，紧急事件选择完才算处理；回信打开就算处理
req_process_opinion 8502 {
    request {
        ids             0 : *integer    # 普通信件可能同时请求多封一起处理(此时不是紧急信件，没有select_id)
        select_id       1 : integer     # 处理紧急信件时的选择id      
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code            0 : integer
        fail_ids        1 : *integer    # 如果有处理失败的，返回失败列表
    }
}

