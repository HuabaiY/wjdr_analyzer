    }

    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        rank 1 : integer # 排名
        rank_data 2 : rank_data

        .stage_rank_data {
            stage 0 : integer
            rank 1 : integer
            rank_data 2 : rank_data
        }

        all_stage_rank_data 3 : *stage_rank_data # 所有阶段的排名信息, overall=true时返回
        cross_rank 4 : integer #跨服排名
        kingdom_rank 5 : integer #王国排名
    }
}

