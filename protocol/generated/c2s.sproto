        .show_info {
            kid 0 : integer # 对手kid
            aid 1 : integer(0) # 对手aid
            fighter_count 2 : integer # 参战人数
            fighter_score 3 : integer # 参战人员总袭击分
			score 4 : integer # 兵工厂战场积分(战场结束后此字段才有意义)
			is_win 5 : boolean # 是否在战斗中获胜(战场结束此字段才有意义)
			legion_id 6 : integer # 对手军团ID
			flag 7 : integer # 旗帜
			flag_bg 8 : integer # 旗帜背景
        }
		.legion_show_info {
			legion_id 0 : integer # 军团ID
			self_info 1 : show_info # 自身联盟的数据
        	opponent_info 2 : show_info # nil 表示没有匹配结果, 空表表示轮空
		}

		infos 1 : *legion_show_info(legion_id)
    }
}

