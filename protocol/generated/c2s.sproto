req_alliance_arsenal_war_get_history 11901 { 	# 获取历史数据
	request {
		start 0 : integer # 开始编号(nil默认从最新一条开始发送)
		count 1 : integer # 条数(nil默认20条)
	}

	response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0 : integer
		.history {
			index 0 : integer # 编号
            result 1 : integer # 胜利方 1.进攻 2.防守
            .side_data { #  攻防联盟数据
                aid 0 : integer(0)
                kid 1 : integer
                side 2 : integer # 攻防
                info 3 : alliance_brief_info
				score 4 : integer # 积分
				count 5 : integer # 参战人数
				legion_id 6 : integer # 军团编号
            }
            sides 2 : *side_data(side)
			starttime 3 : integer(0) # 开始时间
			endtime 4 : integer(0)  # 结束时间
			side 5 : integer # 本盟所属方
			.mvp_data {
                uid 0 : integer
                side 2 : integer
                name 3 : string
                image 4 : integer
                upload_image 5 : string
            }
			mvp 6 : mvp_data # mvp数据
			.player_score {
				uid 0 : integer
				values 1 : *integer(0) # 玩家分数，格式:{分数, 是否替补}, 第二个值默认nil,1表示替补
			}
			score_map 7 : *player_score() # 玩家得分情况, 旧数据是nil
		}
		list 1 : *history # 历史数据列表
	}
}

