    key 8 : string              # 多语言key
    bid 9 : integer              # 建筑id
}

.tab_message {                  # 标记留言信息
    id 0 : integer
    name 1 : string             # 名字
    content 2 : string          # 内容
    time 3 : integer            # 时间
}



.fes_bp_dailytask_bp {
    .received_mark {
        type 0 : integer # 奖励类型 1免费 2普通付费
        value 1 : *pair_int_bool()
    }
    received_mark 0 : *received_mark()
    privilege_mark 1 : *pair_int_bool() # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
    integral 2 : integer # 当前积分
    extra_reward_count 3 : integer # 额外奖励领取次数
}

.fes_bp_dailytask_daily_task {
    quests 0 :  *quest()    #未领奖且有进度的任务
    finishs 1 : *finishs()    #已领奖任务
    received_count 2 : *pair_int_int() #{[任务ID]=领取次数}
}

.fes_bp_dailytask_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer
    reward_group 4 : integer # 奖励组ID
    task_group 5 : integer # 任务组ID
    buy 6 : boolean # 是否购买宝箱
    bp_info 7 : fes_bp_dailytask_bp # 通行证数据
    task_info 8 : fes_bp_dailytask_daily_task # 日常任务
    buy_legendary 9 : boolean # 是否购买传说宝箱
}



.fes_bp_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer
    integral 4 : integer # 当前积分

    .mark {
        id 0 : integer
        value 1 : boolean
    }
    .received_mark {
        type 0 : integer # 奖励类型 1免费 2普通付费 3高级付费
        value 1 : *mark()
    }

    received_mark 5 : *received_mark()
    privilege_mark 6 : *mark() # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
    box_mark 7 : *mark() # 宝箱奖励领奖标记 {[宝箱等级]=true}
    reward_idx 8 : *integer # 奖励配置索引 [1]=起始下标 [2]=结束下标
    buy_gift_id 9 : *mark() # 已购买的礼包ID
    extra_reward_count 10 : integer      # 额外奖励领取次数
}



.festival_sevendays {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    score 3 : integer               # 积分数量
    scord_raward 4 : *pair_int_bool()        # 积分奖励领取情况 【idx】= true
    quests 5 :  *quest(id)    #今天任务中未领奖任务信息
    finishs 6 : *pair_int_bool()    #今天任务中已领奖任务 
}



.festival_turntable_info {
    # 活动
    id 0 : integer                  # 活动id
    stage_start_list 1: *integer    # 各个阶段开始时间
    cur_stage 2: integer            # 当前阶段
    group_index 3: integer          # 开启的活动组别: festival_turntable_group表的index

    # 转盘
    lucky_value 4: integer          # 幸运值
    process_value 5: integer        # 进度值
    process_rewarded 6: integer     # 已领取的进度

    # 礼包
    last_free_gift_ts 7: integer    # 上次领取免费礼包的时间戳

    # 商店
    shop_limit 8: *pair_int_int()   # 已购买商品 index: num
    shop_refresh_ts 9: integer      # 商店刷新的时间戳

    # 任务
    .festival_turntable_task {
        quests 0 :  *quest()      # 未领奖且有进度的任务
        finishs 1 : *finishs()    # 已领奖任务
    }
    task 10 : festival_turntable_task  # 任务列表
}



.find_goods_act_base { # 活动基础信息
    id                      0 : integer       # 活动ID
    start_ts                1 : integer       # 活动开启时间
    end_ts                  2 : integer       # 活动结束时间
    serial_no               3 : integer       # 活动序列号
    warzone_day             4 : integer       # 活动开始时固定的战区天数
    stage_id                5 : integer       # 期数
}

.find_goods_progress { # 寻物等级进度信息（永久数据，不随活动清除）
    progress_num            0 : integer(0)    # 总进度值
    received_grade          1 : integer       # 领取了的等级（已领取最大等级 <=conf_max_grade）
    received_infinite       2 : integer       # 无尽等级下领取的次数 （progress_num - max）// X
}

.find_goods_chapter {
    chapter_map             0 : integer       # 场景章节地图ID
    chapter_id              1 : integer       # 章节ID
    chapter_level           2 : integer       # 章节关卡顺序（conf.front_level）
    chapter_started         3 : boolean       # 是否已开启章节（关卡失败、章节完成时重置）
    chapter_inf_items       4 : *integer      # 地图中的干扰物item_id
    chapter_pass_all        5 : boolean       # 所有章节全部通关（当前处于最后一章、最后一关）

    scene                   6 : find_goods_scene # 如果有正在进行的单人场景，可直接继续游戏
    energy                  7 : integer       # 体力
}

.find_goods_scene {
    target_items            0 : *find_goods_target
    stop_ts                 1 : integer       # 停止时间 （延时道具可以递增）
    free_prompt             2 : integer       # 可用的免费提示的次数
    error_punish_ts         3 : integer       # 错误惩罚截止时间
    extra_time_cnt          4 : integer       # 加时的次数
    tip_item_id             5 : integer       # 当前正在被提示的物品
    tip_cnt                 6 : integer       # 已提示的次数
    in_time_option          7 : boolean       # 加时标记，加时后也要手动scene_time_begin
    xxx_key                 8 : string
}

.find_goods_target {
    item_id                 0 : integer       # 物品id
    mark                    1 : boolean       # 已找到true
}

.find_goods_room_scene {
    target_items            0 : *find_goods_target
    inf_items               1 : *integer      # 地图中的干扰物item_id
    rate_gear               2 : integer       # 倍率档位（最近一次触发的）需要rate_trigger_ts计算当前实时倍率
    gear_trigger_ms         3 : integer(0)    # 倍率档位触发时间（计算衰减和更新倍率）毫秒

    room_map_id             4 : integer      # 双人地图ID (防止跨天或其他错误，不用room_info中的id)
    room_level_id           5 : integer      # 双人关卡ID
    begin_ts                6 : integer      # 开始时间（双方都确认加载后或自动开始后）时间 + ti
    stop_ts                 7 : integer      # 结束时间
    xxx_key                 8 : string
    round                   9 : integer      # 房间轮次
}

.find_goods_room_member {
    position                0 : integer       # [1]房主
    uid                     1 : integer
    kid                     2 : integer
    nickName                3 : string
    abbr                    4 : string

    daily_max_score         5 : integer(0)    # 今日最高分
    ready_ts                6 : integer       # 是否准备
    score                   7 : integer(0)    # 房间内成员找到的分数
    error_punish_ts         8 : integer       # 错误惩罚截止时间
    offline                 9 : boolean       # 是否离线 true:已离线
    mark_count              10 : integer      # 本局找到的个数
}

.find_goods_room_info {
    room_id                 0 : string        # 当前所在房间
    create_ts               1 : integer       # 房间创建时间
    room_member             2 : *find_goods_room_member(uid) # 房间成员（不保证顺序）
    room_scene              3 : find_goods_room_scene # 正在进行的双人场景

    team_max_score          4 : integer(0)    # 队伍最高分(排行榜数据)
    team_rank               5 : integer       # 队伍排名(排行榜数据)
    chat_id                 6 : integer(0)    # 聊天ID
}

.find_goods_match_info { # 双人挑战活动主界面匹配信息
    double_find_num         0 : integer       # 双人寻物次数
    daily_max_score         1 : integer(0)    # 今日最高分
    match_ts                2 : integer       # 开始匹配时间（是否匹配中）
    received_daily_reward   3 : integer       # 今日最高分奖励领取标记（全部领取）

    room_info               4 : find_goods_room_info
    room_map_id             5 : integer       # 双人地图ID（主题地图，每日更换）
    room_level_id           6 : integer       # 双人关卡ID
    last_creat_ts           7 : integer       # 上次创建房间时间（防止频繁创建房间）
}

.find_goods_record_member {
    position                0 : integer       # [1]房主
    uid                     1 : integer
    kid                     2 : integer
    nickName                3 : string
    abbr                    4 : string
}

.find_goods_challenge_record { # 双人挑战记录
    scene_begin_ts          0 : integer       # 房间场景挑战开始时间
    score                   1 : integer(0)    # 获得总分数
    team_id                 2 : string        # 房间成员（不保证顺序）
}

.find_goods_room_member_mark_result {
    room_id             0 : string
    item_id             1 : integer
    uid                 2 : integer
    add_score           3 : integer

    rate_gear           4 : integer       # 倍率档位（最近一次触发的）需要rate_trigger_ts计算当前实时倍率
    gear_trigger_ms     5 : integer(0)    # 倍率档位触发时间（计算衰减和更新倍率）毫秒
    error_punish_ts     6 : integer       # 错误惩罚截止时间
    mark                7 : boolean       # 没有标记说点错了
    mark_count          8 : integer       # 本局找到的个数
    score               9 : integer(0)    # 本局获得分数
}

.find_goods_task { # 寻物活动任务列表
    quests              0 : *quest()      # 未领奖且有进度的任务
    finish              1 : *finishs()    # 已领奖任务
}

.find_goods_gift {
    group_id            0 : integer       # 礼包组id
    expire_ts           1 : integer       # 礼包过期时间戳（活动过期时间）
}

.find_goods_room_settle_result {
    room_id             0 : string
    score               1 : integer(0)    # 总分
    time_score          2 : integer(0)    # 时间分
    correct_score       3 : integer(0)    # 正确分
