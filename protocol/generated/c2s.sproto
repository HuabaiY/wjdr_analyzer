            id 0 : integer
            last_refresh_time 1 : integer    # 上次刷新时间
            # 各技能效果自行定义
            recruitment_loyalty_info 2 : recruitment_loyalty_result_info # 募兵所令牌返回信息
            barrack_soldier_info 3 : daily_take_barrack_soldier_result_info # 兵营返回信息
        }

