        id 3 : integer              # 建筑id
        uid 4 : integer             # 占领者uid
        name 5 : string             # 占领者名字
        kid 6 : integer             # 占领者王国
        abbr 7 : string             # 联盟简称
        flag 8 : integer            # 联盟flag
        flag_bg 9 : integer         # 联盟flag_bg
    }

    .map_supremacy_palace {     # 霸主战主殿
