req_arsenal_league_legion_match_info 30581 { # 获取军团匹配数据
    request {
        act_id 0 : integer
        legion_ids 1 : *integer     # 军团id列表
    }

    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        code 0 : integer
        .show_info {
            kid 0 : integer # kid
            aid 1 : integer(0) # aid
            legion_id 2 : integer # 军团ID
            fighter_count 3 : integer # 参战人数
            fighter_score 4 : integer # 参战人员总袭击分
			score 5 : integer # 兵工厂战场积分(战场结束后此字段才有意义)
			is_win 6 : boolean # 是否在战斗中获胜(战场结束此字段才有意义)

            .alliance_info { # 联盟信息
                name 0 : string         # 联盟名称
                abbr 1 : string         # 联盟简称
                flag 2 : integer        # 联盟旗帜
                flag_bg 3 : integer     # 旗帜背景 
            }

            alliance_info 7 : alliance_info
        }

		.legion_show_info {
			legion_id 0 : integer # 军团ID
			self_info 1 : show_info # 己方军团信息
        	opponent_info 2 : show_info # 敌方军团信息
		}

		infos 1 : *legion_show_info(legion_id)
    }
}

req_arsenal_league_schedule 30582 { # 获取赛区赛程表
    request {
        act_id 0 : integer
        group_id 1 : integer # 赛区id
        stage 2 : integer # 赛事阶段（5=淘汰赛, 6=争霸赛） 
    }

    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .duel_legion { # 参赛军团
            legion_index 0 : integer # 编号
            legion 1 : arsenal_league_legion # 军团信息
            pos 2 : integer # 位置 # 对应match_plan中淘汰赛第一轮的军团排名
        }

        .match_result { # 场次结果信息
            match_id 0 : integer # 场次编号
            winner 1 : integer # 获胜方军团编号
            mvp_uid 2 : integer # mvp玩家uid
            match_ts 3 : integer # 开战时间
            mvp_side 4 : integer # mvp阵营 1-蓝方 2-红方
        }

        code 0 : integer
		total_round 1 : integer # 总轮次
        duel_legions 2 : *duel_legion # 所有参赛军团
        match_results 3 : *match_result(match_id) # 所有场次结果
    }
}

