req_arsenal_league_refresh_match_info 30587 { # 刷新比赛数据
    request {
        act_id 0 : integer
        group_id 1 : integer    # 赛区id
        match_ids 3 : *integer  # 比赛id列表
    }
    response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0: integer
		.match_refresh_info {
            .side_info {
                side 0 : integer # 阵营 1-蓝方 2-红方
                fight_cnt 1 : integer               # 参战人员数量
                power 2 : integer(0)                # 总战力
                avg_score 3 : integer(0)            # 平均分
                score 4 : integer(0)                # 当前得分
                mvp_uid 5 : integer                 # mvp玩家uid（获胜方才有）
            }
            match_id 0 : integer    # 比赛id
            sides 1 : *side_info(side) # 对阵信息
            is_finish 2 : boolean   # 比赛是否结束
            win_side 3 : integer # 获胜方阵营
        }
		match_infos 1 : *match_refresh_info(match_id) # 场次比赛刷新数据
    }
}

