req_fortwar_war_record 10717 {				# 战争记录
	request {
		id 0 : integer						# 据点id
		start_index 1 : integer				# 开始索引(本期内从1开始计数, 为空默认从最大的索引开始下发)
		num 2 : integer						# 条数(为空默认20条)
		kid 3 : integer						# 王国id(为空默认是当前玩家所在的王国)
	}
	response {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		code 0 : integer
		.war_record_player {
			uid 0 : integer					# 队长玩家id
			name 1 : string					# 玩家名称
			aname 2 : string				# 联盟名称
			abbr 3 : string					# 联盟简称
			aid 4 : integer(0)				# 联盟id
		}
		.war_record {
			index 0 : integer				# 索引(最大索引表示最新)
			.value {
				type 0 : integer			# 类型(1 = 首占, 2 = 进攻胜利, 3 = 进攻失败, 4 = 驻防)
				atk 1 : war_record_player	# 进攻方/驻防方
				def 2 : war_record_player	# 防守方，为nil时则是NPC
				time 3 : integer			# 记录产生的时间戳
			}
			value 1 : value
		}
		data 1 : *war_record()				# 战争记录
	}
}



