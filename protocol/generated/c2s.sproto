    power 2 : integer(0) # 部队战力
    lock_uid 3 : integer # 被协助者uid, nil时表示空闲
    finish_ts 4 : integer(0) # 到站时间
    count 5 : integer # 协助次数
    soldier_map 7 : *battle_soldier(id)
    quality 8 : integer                                             # 品质
    expert_info 9 : *expert_effect_source()                              # 专家信息
}

.truck_escort_send_truck_info { # 已发车信息
    stage_index 0 : integer     # 阶段id
    count 1 : integer           # 已发车次数
}

.truck_escort_truck_record_predator_info { # 货车记录掠夺者信息
    .pos_hero_pair {
        pos 0 : integer
        hero 1 : hero
    }
    uid 0 : integer                     # uid
    success 1 : boolean                 # 是否掠夺成功
    hero_map 2 : *pos_hero_pair()       # 英雄map {[位置] = 英雄数据}
    power 3 : integer(0)                   # 战力
    id 4 : integer(0)                   # 掠夺记录id
    time 5 : integer                    # 掠夺时间
    plundered_basis_items 6 : *item     # 被抢走的基础道具列表
    plundered_random_items 7 : *item    # 被抢走的随机道具列表
    kid 8 : integer                     # 王国id
    take_back_reward_items 9 : truck_expert_item_info    # 被掠夺时夺回的奖励物品列表
    expert_items 10 : truck_expert_item_info             # 专家奖励物品列表
}

.truck_escort_truck_march_info { # 货车队列信息
    route_id 0 : integer        # 路线id
    total_time 1 : integer      # 总时长
    march_id 2 : integer        # 队列id
    begin_time 3 : integer      # 开始时间
    kid 4 : integer             # 王国id
    start_point 5 : point       # 货车起点
    old_total_time 6 : integer  # 原总时长
}

.truck_escort_truck_info { # 货车信息
    slot_id 0 : integer                                             # 槽位id
    id 1 : integer(0)                                               # 货车id
    quality 2 : integer                                             # 品质
    basis_reward_items 3 : *item                                    # 剩下的基础奖励列表
    random_reward_items 4 : *item                                   # 剩下的随机奖励物品列表
    march_info 5 : truck_escort_truck_march_info                    # 货车队列信息
    is_finish 6 : boolean                                           # 是否已完成护送
    diamond_count 7 : integer                                       # 钻石已刷新次数
    formation 8 : formation_build                                   # 编队信息
    assist_uid 9 : integer                                          # 援助者uid
    plundered_basis_items 10 : *item                                # 被抢走的基础道具列表
    plundered_random_items 11 : *item                               # 被抢走的随机道具列表
    predator_infos 12 : *truck_escort_truck_record_predator_info    # 掠夺者信息
    random_count 13 : integer                                       # 已刷新次数
    be_plundered 14 : integer                                       # 被掠夺次数
    formation_info 15 : truck_assist_formation_info                 # 详细的编队信息 查看他人货车信息时使用
    aid 16 : integer(0)                                             # 联盟id 查看他人货车信息时使用
    free_random_count 17 : integer                                  # 专家技能已免费刷新次数
    extra_reward_items 18 : *truck_expert_item_info                 # 额外奖励物品列表
    take_back_reward_items_array 19 : *truck_expert_item_info       # 被掠夺时夺回的奖励物品列表
    expert_items_array 20 : *truck_expert_item_info                 # 专家奖励物品列表
    expert_quality_drop_id 21 : integer                             # 专家红车品质掉落id
}

.truck_escort_truck_record_info { # 货车记录信息
    id 0 : integer(0)                                           # 记录id
    begin_time 1 : integer                                      # 发车时间
    quality 2 : integer                                         # 品质
    basis_reward_items 3 : *item                                # 基础奖励列表
    random_reward_items 4 : *item                               # 随机奖励物品列表
    formation 5 : truck_assist_formation_info                   # 详细的编队信息
    assist_uid 6 : integer                                      # 援助者uid
    predator_infos 7 : *truck_escort_truck_record_predator_info # 掠夺者信息
    plundered_basis_items 8 : *item                             # 被抢走的基础道具列表
    plundered_random_items 9 : *item                            # 被抢走的随机道具列表
    end_time 10 : integer                                       # 结束时间
    extra_reward_items 11 : *truck_expert_item_info             # 额外奖励物品列表
    take_back_reward_items_array 12 : *truck_expert_item_info   # 被掠夺时夺回的奖励物品列表
    expert_items_array 13 : *truck_expert_item_info             # 专家奖励物品列表
    expert_quality_drop_id 14 : integer                         # 专家红车品质掉落id
}

.truck_cover {
    kid 0 : integer             # 队列所在kid
