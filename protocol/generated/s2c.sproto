.item {
    id 0 : integer #奖励ID
    count 1 : integer #奖励数量
}

.item_list {
    idx 0 : integer
    items 1 : *item
}

.pair_int_int {
    k 0 : integer
    v 1 : integer(0)
}

.pair_long_int {
    k 0 : integer(0)
    v 1 : integer
}

.pair_int_intarray {
    k 0 : integer
    v 1 : *integer(0)
}

.pair_int_bool {
    k 0 : integer
    v 1 : boolean
}

.item_long {
    id 0 : integer
    count 1 : integer(0)
}

.alliance_base { # 联盟基础信息
    aid 0 : integer(0)
    name 1 : string # 名称
    abbr 2 : string # 简称
    flag 3 : *integer # 旗帜ID
    flag_bg 4 : *integer # 旗帜背景(可空)
    leader 5 : integer # 盟主uid
    leader_name 6 : string # 盟主名称
    count 7 : integer # 联盟成员数量
    language 8 : integer # 联盟语言
    power_rank 9 : integer # 战力排行榜
    power 10 : integer(0) # 战斗力
}

.role_info {
    abbr 0 : string     # 联盟缩写
    name 1 : string     # 玩家名字
    stove_lv 2 : integer   # 市政厅等级
    kid 3 : integer     # 王国id
    uid 4 : integer     # 角色id
    register_time 5 : integer   # 注册时间
    power 6 : integer(0)    # 战力
    image 7 : integer   # 形象id
    lan 8 : string      # 语言
    block_endtime 9 : integer # 封号结束时间
    block_reason 10 : integer # 封号原因
    total_recharge_amount 11 : integer # 充值金额
    delete_end_time 12 : integer # 最终删除角色时间
}

.server_info {
    id 0 : integer		# 王国id
    name 1 : string 	# 名字
    state 2 : integer   # 状态
    role_count 3 : integer    # 角色数量
}

.cheque_info { # 格子数据
    id                          0 : integer # 格子id
    type                        1 : integer # 格子类型
    level                       2 : integer # 格子等级
    exp                         3 : integer # 格子经验
}

.cheque_detail_info {
    id                          0 : integer # 格子id
    cheque_info                 1 : cheque_info 
}

.start_trigger_cheque_info {
    cheque_id                   0 : integer
    reward                      1 : *item() # 奖励
}

.adventure_box_info {
    adventure_box_reward        0 : *item() # 探险宝箱奖励
    adventure_box_cheque_id     1 : integer # 下一个探险宝箱格子id 
}

.record_reward_info {
    cheque_id                   0 : integer # 格子id
    reward                      1 : *item
    is_adventure_box            2 : boolean # 是否探险宝箱
}

.play_dice_info {
    count                       0 : integer # 第几次
    points                      1 : integer # 投掷的点数
    cheque_id                   2 : integer # 达到的格子id
    reward                      3 : *item() # 奖励
    event_index                 4 : integer # 触发的事件索引
    start_trigger_cheque        5 : *start_trigger_cheque_info # 经过起点格触发的道具格和对应的奖励
    adventure_box_lst           6 : *adventure_box_info
    record_reward_lst           7 : *record_reward_info
}

.msg_result_info {
    uid 0 : integer
    code 1 : integer
    rtmcode 2 : integer
    mid 3 : string
    msg 4: string
    lv_limit 5 : integer # 对方设置的私聊等级, code=1819时, 此字段才有意义
    attrs 6 : string
}



.formation_soldier {        # 编队中的士兵
    id 0 : integer          # 士兵id
    count 1 : integer       # 健康士兵数量
    minor_wound 2 : integer # 轻伤士兵数量
}

.formation {                            # 编队
    id 0 : integer                      # 编队id
    soldier 1 : *formation_soldier(id)  # 士兵map
    hero_id 2 : *pair_int_int()         # 英雄map {[位置] = 英雄id}
}

.formation_build {                  # 创建编队数据
    hero_id 0 : *pair_int_int()     # 英雄map {[位置] = 英雄id}
    soldier 1 : *pair_int_int()     # 士兵map {[士兵id] = 数量}
}

.formation_build_with_name {                  # 创建编队数据
    hero_id 0 : *pair_int_int()     # 英雄map {[位置] = 英雄id}
    soldier 1 : *pair_int_int()     # 士兵map {[士兵id] = 数量}
    formation_name 2 : string                 # 编队名称
    formation_rate 3 : *pair_int_int()        # 编队按比例保存 {[士兵类型]=比例}（和数量保存互斥 不允许同时带数据上传）
}



.package {
	type 0 : integer
	session 1: integer
	.userdata {
		crypt_method 0 : integer
		crypt_length 1 : integer	# 加密后密文长度
	}
	ud 2 : userdata
}



.ice_chest {
    id 0 : integer      # 配置id
    item 1 : *item()       # 道具(打开之后才有)
}

.map_chest {
    idx 0 : integer     # 格子索引
    chest 1 : ice_chest
}


.abtest_info {
    id 0 : integer
    begin_ts 1 : integer # 开启时间
    end_ts 2 : integer # 结束时间
    .extra {
        str 0 : string # 额外参数
    }
    extra 3 : extra
}


.accumulative_activity {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    progress 3 : integer            # 积分进度
    received 4 : *integer           # 已领取奖励的阶段ID
    level 5 : integer               # 奖励等级
    serial_no 6 : integer           # 序列号
    final_stage_end_ts 7 : integer  # 结算阶段结束时间
    .s_stage_lattice {
        stage 0 : integer
        .s_lattice {
            lattice_id 0 : integer
            item_id 1 : integer
        }
        lattice 1 : *s_lattice()
    }
    lattices 8 : *s_stage_lattice() # 选择的格子奖励
}


.achievement_quest {
    id 0 : integer
    start_ts 1 : integer
    end_ts 2 : integer
    count 3 : integer # 累计的数量, 对于排名任务此字段无意义
    complete 4 : boolean # 是否完成
    received 5 : boolean # 奖励是否领取 
    complete_ts 6 : integer #完成时间
}



.active_recharge {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    score 3 : integer               # 积分数量
    scord_raward 4 : *pair_int_bool()        # 积分奖励领取情况 【idx】= true
    quests 5 :  *quest(id)    #今天任务中未领奖任务信息
    finishs 6 : *pair_int_bool()    #今天任务中已领奖任务 
}



.activity_base {
    id 0 : integer              # 活动id
    serial_no 1 : integer       # 活动序列号（同一个活动，每次开启序列号不同）
    cur_stage_idx 2 : integer   # 当前阶段idx
    stage_ts 3 : *integer(0)    # 活动阶段到期时间戳
}

.activity_drop {
    drop_id 0 : integer         # 掉落id
    record_value 1 : integer    # 积累数值
    history 2 : *pair_int_int() # 有限制的道具的掉落数量
}

.activity_exchange {
    exchange_times_map 0 : *pair_int_int() # 兑换次数
}


.calendar_schedule {
    begin_ts 0 : integer(0)
    end_ts 1 : integer(0)
    group_id 2 : integer # 奖励组ID
}

.calendar_entry {
	id 0 : integer # 活动ID
    schedule 1 : *calendar_schedule
}





.adgame_info {      # 游戏信息
    level 0 : integer  # 关卡
    # 其他小游戏的字段可在这里新增
}

.adgame_entity {
    type 0 : integer  # 小游戏类型, 1是兵临城下
    info 1 : adgame_info
}

.adgame_param {     # 小游戏提交参数
    type 0 : integer  # 小游戏类型, 1是兵临城下
    level 1 : integer # 关卡信息
}


.hungs_awards {
    id 0 : integer
	value 1 : integer(4)
}

.hero_attr {
    id 0 : integer #英雄ID
    position_id 1 :integer #站位ID
    #其余参数
}

.adventure_pve_info {
	pass_checkpoint 0 : integer    # 通过的最大关卡
    hang_start_time 1 : integer #开始挂机时间
}

.battle_hero_info { #英雄信息
    cid 0 : integer #战斗单位ID （客户端id battle_unit_id）
    atk 1 : integer #攻击力
    def 2 : integer #防御力
    hp 3 : integer #血量
    atksp 4 : integer #攻速（毫秒/次）
    movesp 5 : integer #移动速度(毫米/秒),
    skills 6 : *integer #技能索引数组
}

.battle_soldier_info { #小兵信息
    cid 0 : integer #战斗单位ID （客户端id battle_unit_id）
    atk 1 : integer #攻击力
    def 2 : integer #防御力
    hp 3 : integer #血量
    atksp 4 : integer #攻速（毫秒/次）
    movesp 5 : integer #移动速度(毫米/秒),
    skills 6 : *integer #技能索引数组
    num 7 : integer # 数量
}

.team_effect_map {
    effect_type 0 : integer
    effect_map 1 : *expert_effect_source()
}

.battle_troops_info {
    .unin_troops {
        hero 0 :battle_hero_info
        soldier 1 :battle_soldier_info
    }
    .position_info {
        pid 0 : integer # 站位ID
        unin_troops 1 :unin_troops #部队单位信息
    }
    seed 0 : integer(0)  #随机种子
    limit_time 1 : integer # 本场战斗限时时间（毫秒）
    battle_type 2: integer #战斗类型 
    me 3 : *position_info() #我方队伍信息
    enemy 4 : *position_info() #敌方队伍信息
    id 5 : integer  # pve 关卡ID
    version 6 : integer # 战斗数据版本号
    me_expert_effect_map 7 : *team_effect_map() # 我方的专家效果
    enemy_expert_effect_map 8 : *team_effect_map() # 敌方的专家效果
    me_expression_info 9 : *pair_int_int() # 我方的表情数据 {[type]=表情id}
    enemy_expression_info 10 : *pair_int_int() # 敌方的表情数据 {[type]=表情id}
}

.operatedata {
    key 0 : integer
    .value {
        key 0 : integer
        value 1 : boolean
    }
    value 1 : *value()
}

.fight_heros_data {
    source 0 : integer #小队ID
    fight_heros 1 : *integer  #参战英雄列表
}


.advertising_act_reward_mark {
    finish 1 : boolean #观看结束
    received 2 : boolean #奖励是否被领取, true表示奖励已领取
    special_received 3 : boolean #累积奖励是否被领取, true表示已领取
}

.advertising_act {
    id 0 : integer                  # 活动id
    start_ts 1 : integer            # 活动开始时间
    end_ts 2 : integer              # 活动结束时间
    serial_no 3 : integer           # 活动序列号
    skip 4 : boolean                # 玩家是否可以跳过广告
    reward_mark 5 : *advertising_act_reward_mark # 数组下标为当日第n次奖励的数据, 完成一次广告观看时此数组元素+1，初始时数组为空
    last_end_ts 6 : integer # 上一次观看结束时间, 对于付费玩家, 这个时间就是领奖时间
}



.notice_like_data {
	like 0: integer
	unlike 1: integer
}

.history_notice {	# 历史公告数据
	notice 0 : string
	uid 1 : integer
	ts 2 : integer(0)
	like_data 3: notice_like_data
	uuid 4: string
	star 5: boolean	# 是否加星
	open_like 6 : boolean   # true/nil=点赞为打开  false=点赞为关闭
	star_ts 7: integer(0)  # 加入星标的时间, 如果没有在星标中，此字段为nil
}

.alliance_rank_name { # 阶级名称
	rank 0 : integer
	name 1 : string
}

.alliance_resource_exchange { # 资源兑换信息
	count 0 : integer(0) # 已兑换数量
	time 1 : integer(0) # 兑换时间
}

.set_uid {
	uid 0 : integer
	b 1 : boolean
}
.map_id_set {
	fort_id 0 : integer
	uids 1 : *set_uid()
}
.alliance_blocked_param {
	flag 0 : integer # flag 不是nil 表示禁娱
	end_time 1 : integer(0) # 前提有flag，禁娱过期时间，如果没有表示永久
}

.alliance { 	# 联盟
	.condition { # 加入条件
		level 0 : integer # 加入等级
		power 1 : integer(0) # 加入战斗力
	}
	aid 0 : integer(0)
	name 1 : string # 名称
	abbr 2 : string # 简称
	flag 3 : *integer # 旗帜ID
	flag_bg 4 : *integer # 旗帜背景
	lv 5 : integer # 等级
	exp 6 : integer # 经验
	public 7 : boolean # 是否公开招募
	count 8 : integer # 成员数量
	notice 9 : string # 公告
	manifesto 10 : string # 宣言
	condition 11 : condition
	language 12 : integer # 语言类型
	leader 13 : integer # 盟主uid
	rank_names 14 : *alliance_rank_name(rank) # 阶级名称
	leader_name 15 : string # 盟主名称
	power 16 : integer(0) # 战斗力
	power_rank 17 : integer # 战斗力
	notice_uid 18 : integer # 发布公告的玩家uid
	apply_num 19 : integer # 申请人数
	member_max 20 : integer # 成员上限
	resource 21 : *item() # 联盟资源
	resource_produce 22 : *item() # 联盟资源产量
	resource_exchange 23 : alliance_resource_exchange
	notice_time 24 : integer(0) # 发布公告的时间
	active_time 25 : integer(0) # 活跃时间(nil表示永久活跃)
	honor_level 26 : integer # 荣誉等级(QQ等级)
	fort_pro_uids 27 : *map_id_set() # 已废弃
	duel_grade 28 : integer # 联盟对决星级
	last_apply_time 29 : integer # 最新申请时间, 没有申请时此字段为nil
	block_param 30 :alliance_blocked_param # 禁娱数据
	top_history_notice 31: history_notice # 置顶联盟历史公告
	notice_open_like 32 : boolean   # true/nil=点赞为打开  false=点赞为关闭
	notice_top 33: boolean # 当前公告置顶状态  true=打开  false/nil=关闭
	notice_star 34: boolean # 当前公告星标状态 true=打开  false/nil=关闭
}

.alliance_cover {
	.condition { # 加入条件
		level 0 : integer # 加入等级
		power 1 : integer(0) # 加入战斗力
	}
	

	aid 0 : integer(0)
	name 1 : string # 名称
	abbr 2 : string # 简称
	flag 3 : *integer # 旗帜ID
	flag_bg 4 : *integer # 旗帜背景
	lv 5 : integer # 等级
	exp 6 : integer # 经验
	public 7 : boolean # 是否公开招募
	count 8 : integer # 成员数量
	condition 9 : condition
	language 10 : integer # 语言类型
	leader 11 : integer # 盟主uid
	leader_name 12 : string # 盟主名称
	power 13 : integer(0) # 战斗力
	power_rank 14 : integer # 战斗力
	apply_num 15 : integer # 申请人数
	member_max 16 : integer # 成员上限
	active_time 17 : integer(0) # 活跃时间(nil表示永久活跃)
	last_apply_time 18 : integer # 最新申请时间, 没有申请时此字段为nil
	block_param 19 :alliance_blocked_param # 禁娱数据
}

.user_alliance { # 玩家联盟信息
	.invite {
		aid 0 : integer(0) # 联盟ID
		time 1 : integer # 邀请时间
	}
	.donate {
		diamond_count 0 : integer 			# 钻石捐献次数
		diamond_expired_time 1 : integer 	# 钻石捐献次数过期时间
		resource_count 3 : integer			# 资源捐献次数
	}

	.trap_extra {
		aid 0 : integer(0) # 联盟ID
	}

	aid 0 : integer(0) # 联盟ID
	first 1 : boolean # 未加入过任何联盟
	rank 2 : integer # 联盟阶级
	invites 3 : *invite # 联盟邀请(未加盟时发送)
	applys 4 : *integer(0) # 已申请联盟ID列表(未加盟时发送)
	donate 5 : donate
	day_receive_time 7 : integer # 每日排行领取时间
	week_receive_time 8 : integer # 每周排行领取时间
	anonymity 9 : boolean # 是否匿名
	join_time 10 : integer
	trap_time 11 : integer # 参与陷阱时间
	trap_extra 12 : trap_extra # 陷阱额外信息
	fort_list 13 : *integer # 有资格参与的堡垒id
	auto_move_end 14 : boolean # 加入联盟那一刻, 自动迁移特权是否结束, nil时表示可以触发自动迁城
}

.alliance_apply {
	uid 0 : integer
	msg 1 : string # 申请宣言
	time 2 : integer # 申请时间
}

.alliance_member { # 联盟成员
	uid 0 : integer
	rank 1 : integer # 联盟阶级
}

.alliance_setting { # 联盟设置信息
	abbr_count 0 : integer # 修改简称次数
	name_count 1 : integer # 修改名称次数
}

.help {
	.extra_data {
		id 0 : integer # 建筑ID/科技ID
		lv 1 : integer # 等级
		help_id 2 : integer # 帮助随机id
	}

	uid 		0 : integer # 玩家ID
	qid 		1 : integer # 队列ID
	helpers 	2 : *integer # 已帮助玩家uid列表
	qtype 		3 : integer # 队列类型 1.建筑 2.研究
	extra 		4 : extra_data
	endtime 	5 : integer
	max 		6 : integer # 最大可被帮助次数
	helptime    7 : integer # 被帮助减少的时间
	help_time 	8 : integer # 单次被帮助时间
}

.member_pos {
	uid 		0 : integer
	x 			1 : integer
	y 			2 : integer
	is_leader 	3 : boolean
	kid			4 : integer
}

.alliance_brief_info { # 联盟简要
    aid 0 : integer(0)
    name 1 : string # 名称
    abbr 2 : string # 简称
    flag 3 : integer # 旗帜ID
    flag_bg 4 : integer # 旗帜背景
	kid 5 : integer
}

.alliance_notice_like_data { # 联盟公告点赞数据
	like  0: integer
	unlike 1: integer
	type 2 : integer	# 0-未赞 1-点赞 2-倒赞
}

.reserve_notice_info {		# 预约公告数据
	uid 0: integer			# 公告最近修改人
	notice 1: string		# 公告内容
	create_ts 2: integer	# 创建时间
	publish_ts 3: integer	# 发布时间
	uuid 4: string			# 公告唯一id
	open_like 5: boolean	# 是否开启点赞  true/nil=打开点赞  false=关闭点赞
	top 6: boolean			# 是否置顶：true=是    false/nil=否
	star 7: boolean			# 是否星标：true=是    false/nil=否
}



.alliance_bomb {
    use_count 0 : integer           # 使用次数
    last_reset_time 1 : integer(0)  # 上次重置时间
}

.building_simple {
	.resource_info {
        end_time   0 : integer  # 联盟资源中心到期时间
	}

	id 		0 : integer
	x 		1 : integer
	y 		2 : integer
	bid 	3 : integer
	blv 	4 : integer
	resource_info 	5 : resource_info 	# 安全矿额外信息
}

.alliance_building {
	.trap_info {
		mass_start_time 0 : integer     # 开启时间
        mass_end_time   2 : integer     # 活动结束时间
        cool_end_time   3 : integer     # 冷却结束时间
	}

	.resource_info {
        end_time   0 : integer  # 联盟资源中心到期时间
	}

	id 				0 : integer
	x 				1 : integer
	y 				2 : integer
	bid 			3 : integer
	hp 				4 : integer
	blv 			5 : integer 	# 荣誉建筑有建筑等级，其它建筑为nil
	# 旗帜、主殿属性
	is_finish		6 : boolean 	# true：已完成、false/nil 未完成
	is_active 		7 : boolean		# is_finish=true的情况下，true：有效的、false/nil：失效的
	occupy_aid 		8 : integer(0) 	# 占领者aid
	is_join 		9 : boolean		# 自己是否入驻建筑中
	# 根据类型自行判断是否有以下数据
	trap_info 		10 : trap_info
	resource_info 	11 : resource_info # 联盟资源中心信息
	alliance_skin 	12 : *alliance_skin(skin_type) # 联盟建筑皮肤
}


.alliance_chest { # 联盟宝箱
	id 0 : integer # 唯一ID
	cid 1 : integer # 宝箱ID
	endtime 2 : integer # 过期时间
	receive 3 : boolean # 是否领取过
	name 4 : string # 赠送者名称(无为匿名)
	giftid 5 : integer # 礼包ID
	rewards 6 : *item # 领取到的奖励
	gift_name 7 : string # 来源礼包名称(默认为nil)
}



.alliance_duel_activity {                   # 活动数据
    id 0 : integer                          # 活动id
    stage_ts 1 : *integer(0)                # 活动阶段时间 预告:（阶段1）[1]-[2] 正式:（阶段2）[2]-[3]、（阶段3）[3]-[#stage_ts-1] 展示:[#stage_ts-1]-[#stage_ts]
    group 2 : integer                       # 活动开始时确定的组id
    warzone_day 3 : integer                 # 活动开始时确定的战区天数
    stage 4 : integer                       # 当前阶段
}

.alliance_duel_alliance {                   # 当前所在联盟数据
    is_can 0 : boolean                      # 是否有资格
    is_bye 1 : boolean                      # 是否轮空
    grade 2 : integer                       # 联盟等级
    .target_info {
        kid 0 : integer
        aid 1 : integer(0)
        grade 2 : integer                   # 联盟等级
    }
    target 3 : target_info                  # 对手数据            
}

.alliance_duel_player_info {                # 玩家数据
    aid 0 : integer(0)                      # 活动开始时加入的联盟id 空代表活动开始时没有资格
    is_bye 1 : boolean                      # 联盟是否轮空
}

.alliance_duel_player_stage {               # 玩家阶段数据
    score 0 : integer                       # 玩家个人积分
    received_box 1 : *pair_int_bool()       # 领取宝箱记录 {[score]=true}
    stove_lv 2 : integer                    # 阶段开始时确定的熔炉等级
}

.alliance_duel_stat_info {                  # 联盟统计数据
    aid 0 : integer(0)
    stage_score 1 : integer                 # 联盟阶段积分
}

.alliance_duel_group_info {                 # 联盟赛程数据
    .score_info {                           
        aid 0 : integer(0)
        score 1 : integer                   # 当前联盟总的结算积分（每天胜负得到的积分）
    }
    score_settle 0 : *score_info()

    .stage_result {                         # 每个阶段结果
        stage 0 : integer                   # 阶段
        .group_result {                      
            aid 1 : integer(0)              # 胜利的联盟id，平局是空
            mvp 2 : integer                 # mvp玩家id，平局是空
        }
        result 1 : group_result
    }
    stage_result_info 1 : *stage_result()
}

.alliance_duel_settlement_info {            # 联盟结算数据
    aid 0 : integer(0)
    .result {
        score 1 : integer                   # 联盟结算积分
        is_win 2 : boolean                  # 是否赢
        grade 3 : integer                   # 联盟等级
        change 4 : integer                  # 星级变化量
    }
    settle 1 : result
}


.alliance_help_data {
	.help_list {
		uid 			0 : integer
		helps 			1 : *help(qid)
	}
	help_data  			0 : *help_list(uid)
}

.alliance_help { # 联盟帮助
	help_list 		0 : *help
	day_glory 		1 : integer # 当日获得的荣耀值
    help_num 	2 : integer # 自动帮助个数
}


.alliance_log { # 联盟日志
	id 0 : integer
	type 1 : integer
	time 2 : integer
	data 3 : *string
}

.alliance_battle_log { # 联盟战斗日志
	id 0 : integer  # 日志ID
	type 1 : integer # 日志类型
	time 2 : integer # 时间
	.player {
		uid 1 : integer
		name 2 : string
		abbr 3 : string
	}
	
	atk 3 : player # 攻击方
	def 4 : player # 防守方
	maptype 5 : integer # 地图类型
	.point {
	    x 0: integer
	    y 1 :integer
	}

	point 6 : point # 坐标
	atk_win 7 : boolean # 攻打是否成功
	.extra_data {
		targetid 0 : integer # 对象ID
        # 联盟建筑战斗
        aid 1 : integer(0) # 目标所属联盟id
        abbr 2 : string # 目标所属联盟简称
        aname 3 : string # 目标所属联盟名称
	}
	extra 8 : extra_data # 额外信息 

	.showdown_data {
		abbr 0 : string # 目标联盟简称
		aname 1 : string # 目标联盟名称
	}
	showdown 9 : showdown_data # 联盟争霸赛type: 215 216 217 
	kid 10 : integer # 坐标点所在的王国(旧数据nil为本王国)
}

.alliance_activity_log { # 联盟活动日志
	id 0 : integer  # 日志ID
	type 1 : integer # 日志类型
	time 2 : integer # 时间

	.monster_siege {
		id 0 : integer # 黑骑士难度
		uid 1 : integer # 玩家
		name 2 : string # 昵称
		# 战斗数据
		win 3 : boolean # 防守成功/失
		target_type 4 : integer # 目标类型
		.point {
			x 0: integer
			y 1 :integer
		}
		point 5 : point # 坐标
		targetid 6 : integer # 目标ID
		waveid 7 : integer # 波次ID
	}
	monster_siege 3 : monster_siege

	.alliance_trap {
		uid 0 : integer
		name 1 : string
	}
	alliance_trap 4 : alliance_trap

	.arsenal_war {
		.sign_up {
			uid 0 : integer # 报名uid
			rank 1 : integer # 报名R级
			name 2 : string # 报名玩家
		}
		sign_up 0 : sign_up # 报名信息 

		.target {
			aid 1 : integer(0) # 目标联盟id
			abbr 2 : string # 目标联盟简称
			name 3 : string # 目标联盟名称
			legion_id 4 : integer # 军团ID
		}
		target 1 : target # 胜利失败对手信息 
		legion_id 2 : integer # 军团ID
	}
	arsenal_war 5 : arsenal_war

	.fort_war { # 堡垒战
		id 0 : integer # 堡垒ID
		uid 1 : integer # 玩家
		name 2 : string # 昵称
		times 3 : *integer(0)
	}

	fort_war 6 : fort_war # 堡垒战 type: 1301

	.triangle_war_result {
		rank 0 : integer # 自己联盟的排名
		legion 1 : integer # 军团

		.target {
			aname 1 : string # 联盟名称
			abbr 2 : string # 联盟简称
		}

		other_alliance 2 : *target
	}

	triangle_war_result 7 : triangle_war_result # 三盟战斗结果

}

.alliance_log_set {
	type 0 : integer # 合集日志的类型
	last_log_ts 1 : integer(0) # 最后一条日志的时间戳
}



.alliance_science {
	id 0 : integer # 科技ID
	lv 1 : integer # 当前等级
	donate 2 : integer # 当前捐献值
}

.alliance_research {
	id 0 : integer # 科技ID
	lv 1 : integer # 等级
	starttime 2 : integer # 当前经验
	endtime 3 : integer # 结束时间
}


.showdown_kingdom_activity { # 王国活动数据(入口展示)
	id 0 : integer # 活动ID 
	starttime 1 : integer # 开始时间
	endtime 2 : integer # 赛季结束时间
}

.showdown_activity { # 全局服活动数据
	# id 0 : integer # 待定 
	season 1 : integer # 赛季
	stage 2 : integer # 阶段 # 1.报名 2.匹配 3.整备 4.战斗 5.结算(展示)
	round 3 : integer # 回合
	starttime 4 : integer # 开始时间(赛季)
	stagetime 5 : integer # 阶段结束时间
	endtime 6 : integer # 赛季结束时间
}

.showdown_group_player { # 玩家信息
	uid 0 : integer # uid
    type 1 : integer # 分路类型
	power 2 : integer # 战力
}

.showdown_group_alliance { # 联盟组内信息
	aid 0 : integer(0) # 联盟ID
	star 1 : integer # 总星数
	score 2 : integer # 积分
	flag 3 : integer # 旗子数
	kill_count 4 : integer # 总杀部队数
	kill_power 5 : integer # 总击杀战力
}

.showdown_round_result { # 轮次结果
	.info {
		aid 0 : integer(0) # 联盟ID
		flag 1 : integer # 胜利次数
	}
	atk 0 : info # 攻击方
	def 1 : info # 防守
	report_id 2 : string # 战报
}

.showdown_group { # 分组信息
	pid 0 : integer # 分组ID
	alliances 1 : *showdown_group_alliance
	.round_info {
		index 0 : integer
		results 1 : *showdown_round_result
	}
	rounds 2 : *round_info()
	first_round_time 3 : integer(0) # 首回合整备开始时间
}

.showdown_way_map_cell { # 分路类型和简要 key-value
	.showdown_way { # 分路简要
		count 0 : integer # 人数
		power 1 : integer # 战力
	}
	type 0 : integer
	value 1 : showdown_way
}

.showdown_alliance { # 联盟分路信息
	list 0 : *showdown_way_map_cell() # 分路简要map
	order 1 : *integer # 分路顺序 为nil默认{1,2,3}
}

.showdown_battle_player { # 战斗玩家信息
    uid 0 : integer
    lv 1 : integer
    nickName 2 : string
    image 3 : integer
    power 4 : integer(0)
    custom_image 5 : string
}

.showdown_battle_alliance { # 联盟简要
    aid 0 : integer(0)
    name 1 : string # 名称
    abbr 2 : string # 简称
    flag 3 : integer # 旗帜ID
    flag_bg 4 : integer # 旗帜背景
	kid 5 : integer
	grade 6 : integer # 争霸赛等级
}

.showdown_round_report { # 轮次1v1战报
	.wave_info { # 波次信息
		.data {
			id 0 : integer # 玩家ID
			total 1 : integer # 总血条
			count 2 : integer # 当前
			last 3 : integer # 剩余
			num 4 : integer # 玩家第几次
			power 5 : integer # 开始战力
		}
		result 0 : integer # 结果 1.进攻胜利 2.防守胜利
		atk 1 : data # 进攻
		def 2 : data # 防守
	}
	.type_info { # 分路信息
		.list_data {
			id 0 : integer
			power 1 : integer
			playerinfo 2 : showdown_battle_player
		}
		atk_list 1 : *list_data # 进攻列表
		def_list 2 : *list_data # 防守列表
		waves 3 : *wave_info # 波次列表
		result 4 : integer # 结果: 1.攻方 2.防守方 3.平局
	}
	atk 0 : showdown_battle_alliance
	def 1 : showdown_battle_alliance
	mvp 2 : integer # mvp玩家uid  可能为nil
	round 3 : integer # 第几轮
	type_list 5 : *type_info  # 分路信息列表
}




.alliance_vote_player { # 投票记录玩家信息
    uid 0 : integer             # uid
    nickName 1 : string         # 昵称
    power 2 : integer(0)        # 威望
    stove_lv 3 : integer        # 火炉等级
    rank 4 : integer            # 联盟R级
}

.alliance_vote { # 投票
	id 0 : integer # 投票ID
    uid 1 : integer
    is_multi 2 : boolean # 是否多选
    st 3 : integer # 开始时间
    et 4 : integer # 结束时间
    title 5 : string # 标题
    options 6 : *string # 选项

    # 成员选择
    selects 7 : *pair_int_int() # 选择数据{[uid]=选择值, ...}, 选择值为(选择1|选择2|...), 选择n=(1<<(n-1))

    # 记录
    total 8 : integer # 联盟人数
    s_uname 9 : string # 发起者昵称
    e_uname 10 : string # 结束者昵称
}




.world_recon_report_cover { # 侦查报告封面
	id 0 : string # 战报key
    uid 1 : integer # 侦查玩家
    ts 2 : integer # 侦查时间
    soldier_cnt 3 : integer(0) # 士兵数量
    backpack_res_map 4 : *item_long()    # 可抢资源
}





.annual_stat_info {
    .s_cross_capital_war {
        count 0 : integer # 参与次数
        arms_race_max_score 2 : integer(0) # 军备阶段最高总分
        fight_max_score 3 : integer(0) # 战斗阶段最高分
    }
    .s_login {
        continuous_login_day 0 : integer # 连续登录天数
        login_day 1 : integer # 累计登录天数
        max_continuous_login_day 2 : integer # 最大连续登录天数
    }
    .s_res {
        consumption 0 : *pair_int_int() # 消耗资源
        production 1: *pair_int_int() # 生产资源
    }
    .s_soldier {
        count 0 : integer(0) # 训练量
        power 1 : integer(0) # 训练增加的战力
        soldiers 2 : *integer # 士兵ID数组
    }
    .s_monster {
        kill_count 0 : integer # 普通怪击杀数量
        kill_boss_count 1 : integer # boss击杀数量
    }
    .s_pvp {
        kill_count 0 : integer # 击杀数量
    }
    .rank_data {
        rank_type 0 : integer # 排行榜类型
        rank 1 : integer # 排名， -1时表示未上榜
        totoal_num 2 : integer(0) # 榜上人数
        value 3 : *integer(0)  # 排行榜的数据
        # value 第一个值为排序数值,第二个值为时间,第三个值为英雄ID(英雄版的情况下)
    }
    .s_alliance {
        aid 0 : integer(0)
        name 1 : string
		abbr 2 : string
		join_ts 3 : integer(0) # 已弃用
		showdown_grade 4 : integer
        flag 5 : integer # 旗帜ID
	    flag_bg 6 : integer # 旗帜背景
        total_ts 7 : integer(0) # 累计在盟时间
        join_ts_new 8 : integer(0) # 第一次加入该联盟的时间
    }
    .s_baseinfo {
        login_day 0 : integer      # 登陆天数
        continuous_login_day 1 : integer # 连续登录天数
        max_continuous_login_day 2 : integer # 最大连续登录天数
        power 3 : integer(0) # 归档时战力
        kid 4 : integer # 王国ID
        server_open_ts 5 : integer(0) # 服务器开启时间
    }

    .s_expert {
        travel_cnt 0 : integer # 游历次数（本次归档期间的游历次数）
        meet_expert_cnt 1 : integer # 结识的专家数（当前共结识多少位专家）
    }

    .s_power {
        power_change 0: integer # 战力提升值
    }

    stove_lv 0 : integer # 熔炉等级
    cw_win_count 1 : integer # 所在王国跨服国王战获胜次数
    alliance_info 2 : s_alliance # 当前联盟信息
    occupy_capital_count 3 : integer # 当前联盟普通国王战占领次数
    cw_occupy_capital_count 4 : integer # 当前联盟跨服国王战占领次数
    warzone_rank 5 : *rank_data(rank_type) # 战区排行榜的排名
    kingdom_rank 6 : *rank_data(rank_type) # 王国排行榜的排名
    cross_capital_war 7 : s_cross_capital_war # 跨服国王战数据
    login 8 : s_login # 登录数据
    resource 9 : s_res # 资源数据
    soldier 10 : s_soldier # 士兵数据
    monster 11 : s_monster # 怪物数据
    pvp 12 : s_pvp # pvp数据
    archive_ts 13 : integer(0) # 归档时间
    base_info 14 : s_baseinfo # 基础数据归档
    expert 15 : s_expert # 专家数据
    power 16 : s_power # 战力数据
}


.arena_hero {
    pos 0 : integer                 # 位置
    id 1 : integer
    lv 2 : integer                  # 等级
    star 3 : integer                # 星级
    training_lev 4 : integer        # 训练营等级
    arr_skill_lv 5 : *pair_int_int    # 技能
    hero_equipment 6 : recon_hero_equip_info  #英雄装备信息
    exclusive_equipemnt 7 : exclusive_equipment_info #专属装备信息
}

.arena_opponent {                   # 对手数据
    type 0 : integer                # 0.玩家 1.机器人   机器人只发id，其他数据不下发
    id 1 : integer                  # 对手id
    scores 2 : integer              # 分数
    player_info 3 : player_base     # 玩家信息
    defence_power 4 : integer       # 防守阵容战力
    no_opponent_info 5 : boolean    # 找不到排行榜信息
}

.arena_base {
    hero_array 0 : *integer         # 英雄id数组，空位置填0，未设置过的这个字段是nil
    free_times_use 1 : integer      # 已使用每日免费挑战次数
    buy_times 2 : integer           # 已购买挑战次数
    left_times 3 : integer          # 剩余的挑战次数
    last_reset_ts 4 : integer       # 挑战次数上次重置的时间
    challenge_hero 5 : *integer     # 挑战阵容英雄id数组
    read_report_id 6 : integer      # 已读战报最大id
    refresh_opponent_times 7 : integer # 已手动刷新对手次数
    refresh_opponent_ts 8 : integer # 上次手动刷新对手的时间
}

.arena_report {
    id 0 : integer                  # 战报id
    atk_id 1 : integer              # 攻击方uid
    atk_score_origin 2 : integer    # 攻击方原积分
    atk_score_new 3 : integer       # 攻击方战后积分
    def_type 4 : integer            # 0.玩家 1.机器人
    def_id 5 : integer              # 防守方，玩家uid，机器人id
    def_score_origin 6 : integer    # 防守方原积分
    def_score_new 7 : integer       # 防守方战后积分
    win 8 : boolean                 # 是否攻方胜利
    revenged 9 : boolean            # 是否已复仇
    atk_attack_power 10 : integer   # 攻方攻击阵容战力
    atk_defence_power 11 : integer  # 攻方防守阵容战力
    def_defence_power 12 : integer  # 守方防守阵容战力
    time 13 : integer               # 战斗时间
}

.pawn_status {
    index 0 : integer
    hp 1 : integer
}


.arsenal_league_legion { # 军团简要信息
    legion_id 0 : integer   # 军团id
    aid 1 : integer(0)      # 联盟id
    kid 2 : integer         # 王国id                
}

.arsenal_league_legion_detail { # 军团信息
    legion_id 0 : integer   # 军团id
    aid 1 : integer(0)      # 联盟id
	abbr 2 : string         # 联盟简称
    kid 3 : integer         # 王国id
    flag 4 : integer        # 联盟旗帜
    flag_bg 5 : integer     # 旗帜背景                  
}

.arsenal_league_match { # 对决场次信息
    .side_info {
        side 0 : integer # 阵营 1-蓝方 2-红方
        legion 1 : arsenal_league_legion    # 军团信息
        fight_cnt 2 : integer               # 参战人员数量
        substitute_cnt 3 : integer          # 替补人员数量
        power 4 : integer(0)                # 总战力
        avg_score 5 : integer(0)            # 平均分
        score 6 : integer(0)                # 当前得分
        mvp_uid 7 : integer                 # mvp玩家uid（获胜方才有）
    }

    match_id 0 : integer    # 场次id
    match_ts 1 : integer    # 开战时间
    sides 2 : *side_info(side) # 对阵信息
    win_side 3 : integer # 获胜方阵营
}

.arsenal_league_vote_info {
    uid 0 : integer			# 玩家id
    index 1 : *pair_int_bool() 		# 时间段索引号
}

.arsenal_league_legion_info {
    sign_indexes 0 : *integer 			# 报名的时间段索引号
    ask_for_battle 1 : *pair_int_bool()	        # 请战玩家
    forbid_for_battle 2 : *pair_int_bool()	    # 不参战玩家 
    fights 3 : *pair_int_bool()			# 参战成员
    substitutes 4 : *pair_int_bool()	# 替补成员
    battlefield_starttime 5 : integer(0)   # 战场开启时间
    battlefield_endtime 6: integer(0)      # 战场结束时间
    fight_index 7 : integer             # 最终参赛的时间段索引号
    match_count 8 : integer			    # 匹配时队伍的人数
    rank 9 : integer                    # 比赛名次
    match_state 10 : integer            # 匹配状态：1-已匹配 2-轮空 3-已完成 4-重赛匹配等待中
    id 11 : integer                     # 军团id
    match_id 12 : integer               # 场次id
    match_waiting_ts 13 : integer       # 重赛匹配等待倒计时
    permit 14 : boolean                 # 参赛资格：true-有参赛资格
    is_out 15 : boolean                 # 是否被淘汰: true-表示被淘汰（被淘汰的场次重赛时，状态会由true变成false）
}



.arsenal_league_act_info {
    season 0 : integer # 赛季
}



.arsenal_league_alliance_info {
    side 0 : integer
    aid 1 : integer(0)
    kid 2 : integer
    abbr 3: string
    aname 4 : string
    flag 5: integer
    flag_bg 6 : integer
    legion_id 7 : integer
}

.arsenal_league_alliance_stat {
    side 0 : integer # 阵营
    count 1 : integer # 参战人数
    .player_stat {
        uid 0 : integer
        score 1 : integer # 分数
        time 2 : integer(0) # 时间
    }
    .building {
        id 0 : integer
        .info {
            uid 0 : integer
            time 1 : integer # 开始计算积分时间
        }
        list 1 : *info()
    }
    players 2 : *player_stat # 本联盟玩家统计数据列表(无序)
    buildings 3 : *building() # 建筑玩家积分计算列表{[建筑ID] = {[uid] = 开始计算积分时间, ...}}
}

.arsenal_league_result_data {
    winner_side 0 : integer # 胜利阵营

    .side_data { #  攻防联盟数据
        aid 0 : integer(0)
        kid 1 : integer
        side 2 : integer # 攻防
        info 3 : alliance_brief_info
        .overview {
            score 0 : integer # 获得分数
            ctrl_time 1 : integer # 控制时间
            sum_kill_score 2 : integer # 总杀敌获得分数
            occupy_score 3 : integer # 控制获得积分
            pickup_score 4 : integer # 掠夺获得分数
            collect_score 5 : integer # 采集获得分数
            def_zombie_count 6 : integer # 防守次数
        }
        overview 4 : overview
        count 5 : integer # 参战人数
        legion_id 6 : integer # 军团编号
    }
    sides 1 : *side_data(side)
    .mvp_data {
