notify_slg_3_league_init 17680 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        start_ts 0 : integer(0)         # 活动开始时间戳
        #     阶段定义
        #     preview = 1, -- 预告
        #     apply = 2, -- 报名
        #     qualifiers = 3, -- 海选赛
        #     knockout = 4, -- 淘汰赛
        #     final = 5, -- 巅峰赛
        #     display = 6, -- 展示期
        stage_ts 1 : *integer(0)        # 阶段时间戳列表 [预告阶段结束时间, 报名阶段结束时间......]
        gid 2 : integer                 # 赛区ID
        season 3 : integer              # 赛季
        formation_prefab 4 : *formation_build_pair()
        is_apply 5 : boolean            # 是否报名
        manifesto 6 : string            # 个人宣言
        gid_set 7 : *pair_int_bool()       # 所有赛区ID
        match_info 8 : slg_3_league_match  # 最新这场的比赛信息
        out_stage 9 : integer # 在哪个阶段出局, 3=海选赛 4=淘汰赛 5=巅峰赛
        manifesto_ts 10 : integer(0)   # 个人宣言更新时间戳
        match_result 11 : *pair_int_bool() # 场次结果 [match_id] = true 表示场次结束/ false表示场次未结束
        reward_id 12 : integer # 奖励组ID activity_warzone_group 的group_id
        kids 13 : *integer # 自己赛区的王国ID列表
        fail_num 14 : integer # 海选失败次数
        champion_uids 15 : *pair_int_int() # 本赛区前三uid列表，冠军未产生时此字段为nil {[名次] = uid}
        qua_reward 16 : *pair_int_int() # 海选赛胜利奖励 1 表示领取了胜利奖励 2 表示领取了失败奖励
        match_result_map 17 : *pair_int_bool() # 场次结果 [match_id] = true 表示场次胜利/ false表示场次失败, 还没出结果nil
        qua_result 18 : slg_3_league_qua_result # 海选赛结果
        champion_like 19 : *pair_int_int()  # 自己点赞前三的次数  {[名次] = 点赞次数}
        formation_power 20 : *pair_int_int() # 编队战力 {[编队id] = 战力}
        troop_limit 21 : *pair_int_int() # 编队部队上限 {[编队id] = 部队上限}
        formation_extra_skill 22 : *slg_3_league_formation_skill()
    }
}

