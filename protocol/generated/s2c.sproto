notify_spectator_arsenal_league_battlefield_result 17360 { # 战场结果
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .result_data {
            winner_side 0 : integer # 胜利方 1.进攻 2.防守

            .side_data { #  攻防联盟数据
                aid 0 : integer(0)
                kid 1 : integer
                side 2 : integer # 攻防
                info 3 : alliance_brief_info
                .overview {
                    score 0 : integer # 获得分数
                    ctrl_time 1 : integer # 控制时间
                    sum_kill_score 2 : integer # 总杀敌获得分数
                    occupy_score 3 : integer # 控制获得积分
                    pickup_score 4 : integer # 掠夺获得分数
                    collect_score 5 : integer # 采集获得分数
                    def_zombie_count 6 : integer # 防守次数
                }
                overview 4 : overview
                count 5 : integer # 参战人数
                legion_id 6 : integer # 军团编号
            }
            sides 1 : *side_data(side)
            .mvp_data {
                uid 0 : integer
                score 1 : integer
                side 2 : integer
                name 3 : string
                image 4 : integer
                upload_image 5 : string
            }
            mvp 2 : mvp_data # mvp数据
        }
        result 0 : result_data # 战场结果
    }
}

