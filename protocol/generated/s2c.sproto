.homeland_recovery_building_info { # 回收返还的建筑信息
    point 0 : point             # 坐标点
    coin_count 1 : integer      # 伐木小屋或者伐木场回收获得的家园币数量
}

.homeland_player_homeland_info { # 玩家显示需要的家园信息
    uid 0 : integer                                 # uid
    life_tree_level 1 : integer                     # 家园生命树等级
    homeland_assist_info 2 : homeland_assist_info   # 家园互助信息
    total_belike_count 3 : integer                  # 总被点赞数量
}

.homeland_replace_building_info {
    bid 0 : integer                                 # 替换的目标建筑id
    points 1 : *point                               # 需要替换的坐标点
}

.homeland_belike_record_info {    # 被点赞记录信息
    uid 0 : integer         # 点赞者
    time 1 : integer        # 时间
}




.heal_data {
    soldiers 0 : *pair_int_int()    # 治疗中的士兵
    finish_ts 1 : integer           # 完成时间，时间戳
    total_time 2 : integer          # 总时长
}




.icefield_hunter_boss {
    x 0 : integer # 怪物坐标
    y 1 : integer
    clear_ts 2 : integer # 清除时间
    id 3 : integer # 怪物id
}

.icefield_hunter {
    base 0 : activity_base          # stage_ts [1]预告开始 [2]活动开始 [3]展示阶段开始 [4]活动结束
    master_win_times 1 : integer    # 作为队长胜利次数
    slave_win_times 2 : integer     # 作为队员胜利次数
    get_master_reward 3 : boolean   # 队长奖励领取状态
    exchange 4 : activity_exchange  # 兑换数据
}



.icefield_hunter2 {
    base 0 : activity_base          # stage_ts [1]预告开始 [2]活动开始 [3]展示阶段开始 [4]活动结束
    master_win_times 1 : integer    # 作为队长胜利次数
    slave_win_times 2 : integer     # 作为队员胜利次数
    master_reward_status 3 : *pair_int_bool()   # 队长奖励领取状态
    group 4 : integer               # 活动奖励组
    exchange 5 : activity_exchange  # 兑换数据
}



.infinite_box_info {
    id 0 : integer               # 活动ID
    start_ts 1 : integer         # 活动开始时间
    end_ts 2 : integer           # 活动结束时间
    serial_no 3 : integer        # 活动序列号
    cur_order 4 : integer        # 当前领奖次序
    reward_group 5 : integer     # 当前的奖励组ID, 索引infinite_box_gift的reward_group字段
    .mark {
        id 0 : integer
        value 1 : boolean
    }
    buy_gift_mark 6 : *mark()    # 购买标记, key=order, value=boolean true表示购买了对应次序的礼包
    reward_group_arr 7 : *integer # 奖励组数组
}



.event_info {
    id 0 : integer          # 唯一id
    event_id 1 : integer    # 事件id
    status 2 : integer      # 状态 1.空闲 2.完成 3.战斗中
    x 3 : integer           # 世界地图坐标
    y 4 : integer
    expire_ts 5 : integer   # 时间过期时间
    rewards 6 : *pair_int_int()      # 奖励
    played 7 : boolean      # 是否播放过动画
    tag 8 : integer        # 标签 1.专家模式
}



.interactive_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer
    
    free_gift_ts 4 : integer(0) # 免费奖励是否领取
}



.invitee {
	uid 0 : integer
    ts 1 : integer(0) # 绑定时间
}

.inviter {
    uid 0 : integer
    kid 1 : integer
    server_open_ts 2 : integer(0)
}




.join_game_hub_daily_task {
    quests 0 :  *quest      # 未领奖且有进度的任务
    finishs 1 : *finishs    # 已领奖任务
}

.join_game_hub_switch_info {  # 活动开关信息
    type 0 : integer # 开关类型 0-关闭 1-开启
}

.join_game_hub_info {  # 活动信息
    task_info 0 : join_game_hub_daily_task      # 任务
    switch_info 1 : join_game_hub_switch_info   # 开关信息
}




.door_info {
	id 0 : integer 					# 门的id 1-3
	uid 1 : integer					# 门的唯一id 用于验证门的有效性 每天刷新门后 该id会变动
	quality 2 : integer 			# 门的品质
	self_knock_nums 3: integer 		# 自己敲门次数
	other_knock_nums 4 : integer	# 别人敲门的次数
	alliance_share 5 : boolean		# 是否已进行过联盟分享
}

.special_event_param {
	type 0 : integer
	param 1 : integer
}

.special_event {
	stage 0 : integer			 		# 特殊事件阶段
	param 1 : *special_event_param()	# 事件参数列表，根据事件类型，不同类型的参数
}

.special_event_info {
	random_key 0 : string
	event 1 : *special_event()	
}

.knock_door_activity_info {
	id 0 : integer 								# 活动ID
    start_ts 1 : integer 						# 活动开启时间
    end_ts 2 : integer 							# 活动结束时间

	last_refresh_time 4 : integer 				# 上次刷新时间
	knock_other_nums 5 : integer 				# 敲其他人的门次数
	door_info 6 : *door_info(id)				# 门的数据

	special_event_in_progress 7 : boolean 		# 特殊事件是否在进行中，如果进行中，下面会有当前特殊事件信息
	event_info 8 : special_event_info			# 特殊事件数据
	random_key 9 : string         				# 随机key 结算时当做内容做加密使用
}

.visitor_info {
	id 0 : integer					# 唯一id
	visitor_id 1 : integer 			# 拜访者id
	visitor_reward 2 : *item() 		# 拜访者获取的奖励
	is_get_reward 3 : boolean		# 自己是否领取奖励
	visit_time 4 : integer			# 拜访时间 
	quality 5 : integer				# 门的品质
	is_trigger 6 : boolean			# 是否触发特殊事件
}

.share_door_info {
	owner 0 : integer 				# 门的拥有者
	id 1 : integer 					# 门的id
	uid 2 : integer 				# 门的唯一id
	quality 3 : integer				# 门的品质
	time 4 : integer				# 分享的时间
	knock_count 5 : integer			# 已敲门次数
	item_id 6 : integer				# 分享条目的序号
}


.law{
	id 0:integer
	value 1 : integer   
}

.law_time_info{
	id 0: integer
	enact 1 : integer
	work 2 : integer 
}

.law_info { 	# 法典信息
	law_time_info 0 : *law_time_info(id) #法典颁发时间
	law_clear_cd_times 1 : *law() #法典cd清除次数   map格式 ：[法典ID]：已清除次数
	last_clear_cd_time 2 : integer #最后一次清除法典cd时间
}

.law_extra {
	items 0 : *item()
}



.like_value_map {
    id 0 : integer # 选项ID
    value 1 : integer(0) # 点赞数
}



.limit_time_shop_item {
    id 0 : integer                              # 商品索引id
    buy_nums 1 : integer                        # 购买次数
}

.limit_time_shop_info {
    id 0 : integer                              # 活动id
    start_ts 1 : integer                        # 活动开始时间
    end_ts 2 : integer                          # 活动结束时间
    group 3 : integer                           # 根据开服天数确定的组id
    integral 4 : integer                        # 积分
    received_mark 5 : *pair_int_bool()          # 已领取宝箱 {[integral] = true}
    last_get_free_gift_ts 6 : integer           # 上次领取免费礼包的时间戳
    last_refresh_shop_ts 7 : integer            # 上次刷新商店的时间
    shop_item 8 : *limit_time_shop_item()       # 购买的商品数据
}



.limit_time_task {
    id 0 : integer                              # 活动id
    start_ts 1 : integer                        # 活动开始时间
    end_ts 2 : integer                          # 活动结束时间
    quests 3 :  *quest()                        # 任务中未领奖 有进度任务
    finishs 4 : *finishs()                      # 任务中已领奖任务 
}




# ====== 组队相关结构体 ======

.linkage_monopoly_team_member { # 队伍成员信息
    uid                    0 : integer         # 玩家 ID
    kid                    1 : integer         # 王国 ID
    join_ts                2 : integer         # 加入时间
    is_leader              3 : boolean         # 是否队长
    preset_expression_info 4 : *pair_int_int() # 联动大富翁预设表情 type_id -> expression_id
}

.linkage_monopoly_team_info { # 队伍信息
    team_id     0 : integer(0)    # 队伍 ID
    members     1 : *linkage_monopoly_team_member  # 成员列表
    apply_count 2 : integer       # 当前申请数
}

.linkage_monopoly_apply_info { # 申请信息
    uid         0 : integer       # 申请者 ID
    apply_ts    1 : integer       # 申请时间
}

.linkage_monopoly_recommend_team { # 推荐队伍
    team_id     0 : integer(0)
    members     1 : *linkage_monopoly_team_member
}

.linkage_monopoly_invite_list { # 邀请好友信息
    uid          0 : integer      # 玩家
    cooldown_ts  1 : integer      # 邀请冷却截止时间（0=可分享）
    m_count      2 : integer      # 成员数量
}

.linkage_monopoly_channel_invite_info { # 频道邀请信息
    type         0 : integer      # 邀请类型 1-联盟 2-群聊 4-王国
    param        1 : integer(0)   # 联盟ID/群聊ID/0
    cooldown_ts  2 : integer      # 邀请冷却截止时间（0=可分享）
}

# ====== 玩法相关结构体 ======

.linkage_monopoly_cheque_event_info { # 格子事件信息
    type        0 : integer       # 事件类型
    detail      1 : integer       # 事件效果
}

.linkage_monopoly_cheque_event_detail_info { # 格子事件详情
    cheque_type         0 : integer                              # 格子类型
    cheque_event_info   1 : *linkage_monopoly_cheque_event_info  # 事件列表
}

.linkage_monopoly_cheque_reward_info { # 格子奖励记录
    type        0 : integer       # 触发类型 1-道具格 2-事件格 3-起点格 4-探险宝箱 5-炮弹格 6-队友格 7-探险币
    reward      1 : *item()
}

.linkage_monopoly_quest_info { # 每日任务信息
    finishs     0 : *finishs()    # 已领奖任务
    quests      1 : *quest()      # 进行中任务
}

.linkage_monopoly_play_dice_info { # 每次投掷信息
    count                       0 : integer     # 第几次
    points                      1 : integer     # 投掷的点数
    cheque_id                   2 : integer     # 到达的格子id
    reward                      3 : *item()     # 道具格奖励
    event_index                 4 : integer     # 触发的事件索引
    start_trigger_cheque        5 : *start_trigger_cheque_info  # 经过起点格触发的道具格和对应的奖励
    adventure_box_lst           6 : *adventure_box_info
    atk_boss_count              7 : integer     # 攻击boss次数
    teammate_cannon             8 : boolean     # 是否触发炮弹格队友赠送
    teammate_dice               9 : boolean    # 是否触发队友格赠送
}

.linkage_monopoly_info { # 活动主信息
    id                          0 : integer     # 活动ID
    start_ts                    1 : integer     # 活动开启时间
    end_ts                      2 : integer     # 活动结束时间
    serial_no                   3 : integer     # 活动期数
    stage                       4 : integer     # 活动阶段 1-预告/组队 2-匹配 3-正式活动
    stage_begin_ts              5 : integer     # 阶段开始时间
    stage_end_ts                6 : integer     # 阶段结束时间
    
    total_points                7 : integer     # 总点数
    received_mark               8 : *pair_int_bool()  # 进度奖励已领取标记

    cheque_id                   9 : integer     # 当前所在的格子id
    adventure_box_cheque_id     10 : integer     # 探险宝箱所在的格子id
    cheque_info                 11 : *cheque_detail_info()  # 格子数据
    wait_trigger_event          12 : *linkage_monopoly_cheque_event_detail_info()  # 格子待触发的事件

    free_play_time              13 : integer    # 免费投掷时间

    group_id                    14 : integer

    record_cheque_reward_lst    15 : *linkage_monopoly_cheque_reward_info  # 最近100条格子奖励记录

    is_daily_task               16 : boolean    # 是否有每日任务
    quest_info                  17 : linkage_monopoly_quest_info  # 任务数据

    # ====== 联动专属字段 ======
    boss_total_damage           18 : integer(0) # boss 累计伤害
    boss_rewards_claimed        19 : *pair_int_bool()   # 已领取的 boss 奖励索引
    boss_extra_reward_count     20 : integer    # 额外奖励次数
    first_roll_done             21 : boolean    # 是否已完成首次投掷
    record_unique_id            22 : integer    # 记录到播放的id
    teammate_gifts              23 : *linkage_monopoly_teammate_gift()  # 待领取的队友奖励
    teammate_show_gift_lst      24 : *linkage_monopoly_show_gift # 队友赠送的展示奖励列表
    team_info                   25 : linkage_monopoly_team_info      # 组队信息
    mate_cheque_binds           26 : *pair_int_int()                # 绑定队友格 cheque_id: uid
    cutscene_played             27 : boolean                       # 客户端过场动画是否已播放
    has_opened                  28 : boolean # 是否打开过活动界面（req_linkage_monopoly_open_activity）
    last_free_gift_ts           29 : integer # 上次领取每日免费礼包时间戳
}

.linkage_monopoly_winning_record { # 大奖中奖记录
    uid         0 : integer       # 中奖者 ID
    item_id     1 : integer       # 道具 ID
    item_count  2 : integer       # 道具数量
    type        3 : integer       # 触发类型
    record_ts   4 : integer       # 中奖时间
    record_id   5 : integer       # 记录唯一 ID
    nick_name   6 : string        # 中奖者昵称
    abbr        7 : string        # 中奖者联盟简称
}

# ====== 队友互动相关结构体 ======

.linkage_monopoly_teammate_gift { # 队友赠送的待领取奖励
    from_uid    0 : integer       # 来源玩家 ID
    reward      1 : *item()       # 奖励
}

.linkage_monopoly_show_gift { # 队友赠送的展示奖励
    unique_id   0 : integer       # 奖励唯一id
    from_uid    1 : integer       # 来源玩家 ID
    reward      2 : *item()       # 奖励
}

.linkage_monopoly_assist_record { # 协助记录条目
    from_uid    0 : integer       # 赠送者 ID
    .info {
        to_uid      1 : integer   # 接收者 ID
        reward      2 : *item()   # 奖励
    }
    to_info 1 : *info()
    
}



.look_for_npc_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer

    reward_count 4 : integer # 领奖次数
}



.lords_equipment_map {
    e_pid 0 : integer # 装备位置ID
    lords_equipment 1 : lords_equipment # 领主装备信息
}

.lords_equipment { 	# 领主装备信息
	equipid 0 : integer  #装备ID
    gems 1 : *pair_int_int() #宝石id信息
}



.lost_treasure_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间

    daily_reward_get_ts 3 : integer # 每日奖励领取时间
    .mark {
        id 0 : integer
        value 1 : boolean
    }
    purchase_mark 4 : *mark() # 礼包购买标记 {[礼包ID]=true}
    group_id 5 : integer # 组ID
    receive_grand_reward 6 : integer # 大奖掉落ID,初始化时为0
    select_grand_reward_id 7 : integer # 选择的大奖掉落ID, 初始时为0
}



.magic_potion_round_data {
    round_id 0: integer  # 已经用掉的轮数
    position_data 1: *pair_int_intarray()  #  【位置id】= (棋子初始位置id, 摆放结果)    摆放结果：0=错误 1=正确 
}

.magic_potion_level { # 关卡数据
    round_data 0: *magic_potion_round_data()          # 之前的轮次数据，最多只保留100轮数据，所以轮次id不一定从1开始
    init_data 1: *integer                             # 初始棋子的颜色位置
}

.magic_potion_task_info {  # 任务数据
    quests 0 :  *quest()        # 未领奖且有进度的任务
    finishs 1 : *finishs()      # 已领奖任务
}



.mail_cover {   # 邮件封面
    mailid 0 : integer(0) #邮件id
    isread 1 : integer #是否已读
    send_time 2 : integer #时间
    first_type 3 : integer #邮件大类
    second_type 4 : integer #邮件小类
    attach_statue 5: integer #附件状态 0无附件可领 1有附件可领
    param 6 : binary #额外参数
    deadline 7 : integer #失效时间 0为不会失效
    iscollect 8 :integer #是否收藏邮件
    attach_deadline 9 : integer # 邮件附件失效时间 0为不会失效
    mailid_new 10 : string # 字符串的邮件id
}

.mail_type_info {
    type 0 : integer    #种类
    num 1 : integer     #数量 
    un_readnum 2 : integer #未读数量
    can_get_attach 3: integer #是否有附件可以领取
    read_time 4 : integer      # 最后阅读时间
    last_time 5 : integer      # 最后一封邮件的时间
    del_count 6 : integer      # 删除数量
}



.map_expression_slot_info { # 槽位信息
    id 0 : integer              # 槽位id 从1到6
    expression_id 1 : integer   # 对应的表情资源id
}

.map_expression_init_info { # 初始信息
    slot_infos 0 : *map_expression_slot_info # 已设置的槽位列表
    expression_infos 1 : *integer            # 拥有的表情id列表
    last_send_time 2 : integer               # 上次发送表情时间
}



.mercenary_player_monster {
    x 0 : integer # 怪物坐标
    y 1 : integer
    clear_ts 2 : integer # 清除时间
    monster_id 3 : integer # 怪物id
}

.mercenary_alliance_monster {
    x 0 : integer # 怪物坐标
    y 1 : integer
    clear_ts 2 : integer # 清除时间
    difficulty 3 : integer # 怪物难度
    cur_hp 4 : integer(0) # 剩余hp
}

.mercenary {
    base 0 : activity_base          # stage_ts [1]预告开始 [2]活动开始 [3]展示阶段开始 [4]活动结束
    master_get_help_item_times 1 : integer    # 作为队长获得帮助道具次数
    player_monster_data 2 : mercenary_player_monster  # 怪物数据，没召唤时是nil
    difficulty 3 : integer  # 选择的难度，nil为未选择
    progress 4 : integer    # 个人怪物击杀进度
    help_count 5 : integer  # 帮助道具数量
    max_difficulty 6 : integer # 曾经通关的最高难度
    next_difficulty 7 : integer # 下一次活动可解锁的难度
    last_choose_difficulty 8 : integer # 上一次选择的难度
    version 9 : integer     # 版本号
}

.mercenary_member_data {    # 联盟成员数据
    uid 0 : integer         # uid
    difficulty 1 : integer  # 难度
    progress 2 : integer    # 进度
    call_help 3 : boolean   # 请求帮助
    x 4 : integer           # x，如果没请求帮助这个字段是nil
    y 5 : integer           # y，如果没请求帮助这个字段是nil
    clear_ts 6 : integer    # 怪物过期时间
    monster_id 7 : integer  # 怪物id
}



.merge_milestone_quest {
    id 0 : integer
    start_ts 1 : integer
    end_ts 2 : integer
    count 3 : integer # 累计的数量
    complete 4 : boolean # 是否完成
    received 5 : boolean # 奖励是否领取 
    complete_ts 6 : integer #完成时间
}


.migrant_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer #活动开启时间
    end_ts 2 : integer #活动结束时间
    serial_no 3 : integer
}

.migrant_application { # 申请表
    uid 0 : integer # 申请人uid
    ts 1 : integer # 申请时间
    kid 2 : integer # 要进入的王国
    status 3 : integer # 0 未处理, 1 已拒绝 2 已同意
    power 4 : integer(0) # 申请时的战斗力
}

.migrant_invitation { # 邀请表
    uid 0 : integer # 邀请对象uid
    kid 1 : integer # 要进入的kid
    type 2 : integer   # 类型 0 普通， 1 特殊
    status 3 : integer # 0 未处理 1 已拒绝 2 已迁入
    # 未设置王国旗帜和名称时 这两字段都为nil
    # language也会为nil, 如 联盟排行榜为空时
    # 下述3个字段只会发给受邀者
    language 4 : integer # 王国语言
    flag 5 : integer # 王国旗帜
    name 6 : string # 王国名称
    ts 7 : integer(0) # 邀请时间
}

.migrant_kingdom_info { # 王国数据
    kid 0 : integer
    state 1 : integer # 0 普通、1 领先、2 不活跃
    migrant_num 2 : integer # 当前移民人数(普通邀请进入的人也包括在内
    normal_migrant_num 3 : integer # 普通邀请移民的人数
    special_invite_count 4 : integer # 特殊邀请次数
    power_limit 5 : integer #移入本王国的实力限制, 配置索引
    # 未设置王国旗帜和名称时 这两字段都为nil
    # language也会为nil, 如 联盟排行榜为空时
    language 6 : integer # 王国语言
    flag 7 : integer # 王国旗帜
    name 8 : string # 王国名称
    president 9 : integer # 国王uid
    aid 10 : integer(0) # 第一联盟ID
    super_count 11 : integer # 累计强盛王国次数
    conti_super_count 12 : integer # 连续强盛王国次数
    super_special_invite_count 13 : integer # 连续强盛王国的特殊邀请次数
}

.migrant_info {
    act_info 0 : migrant_act_info # 活动数据
    power_limit 1 : integer #移入本王国的实力限制, 配置索引
    president 2 : integer # 有权限设置实力限制的玩家uid
    standard_points 3 : integer(0) # 移民标准分
    personal_points 4 : integer(0) # 当前玩家的移民评分
    .president_data {
        application_list 0 : *migrant_application # 收到的申请表, 最多20条, 后续通过notify发送
        invitation_list 1 : *migrant_invitation # 已发出的邀请表, 最多20条, 后续通过notify发送
    }
    president_data 5 : president_data #国王数据, 只有president_uid所指的玩家会收到此字段

    .civilian_data {
        application_list 0 : *migrant_application # 已发出的申请, 最多20条, 后续通过notify发送
        invitation_list 1 : *migrant_invitation # 收到的邀请表, 最多20条, 后续通过notify发送
    }
    civilian_data 6 : civilian_data #平民数据, 只有非president_uid所指的玩家会收到此字段
    state 7 : integer # 当前王国状态 0 普通、1 领先、2 不活跃
    gid 8 : integer # 赛区ID
    last_migrant_ts 9 : integer # 上次移民时间, 初始化时为0
    aid 10 : integer(0) # 该第一联盟ID
    kid_set 11 : *pair_int_int() # 赛区内的王国ID map, key=王国ID, value=开服时间
    room_id 12 : integer(0) # 赛区同语言聊天频道

    .transfer_data {
        uid 0 : integer # 转让对象uid
        ts 1 : integer(0) # 转让开始时间
        status 2 : integer # 转让状态 0 待处理 1 已拒绝 2 已同意 3 已取消
    }
    transfer_data 13 : transfer_data # 国王转让数据, president和转让对象会收到此字段, 没有转让数据时为nil
    cw_lose 14 : boolean # 跨服国王战失败, true时表示跨服国王战失败
    super_count 15 : integer # 累计强盛王国次数
    conti_super_count 16 : integer # 连续强盛王国次数
}

.migrant_act_history {
    state 0 : integer # 王国状态 0 普通、1 领先 2 不活跃 客户端需要把不活跃的显示为普通
    ts 1 : integer(0) # 活动开始时间
}



.mobilization_activity { # 活动数据
    id 0 : integer              # 活动id
    stage_ts 1 : *integer(0)    # 活动阶段开始时间 1.预告,2.开启,3.结算
	# season 2 : integer 			# 赛季
    # cur_stage_idx 3 : integer   # 当前阶段idx(阶段变化不更新)
}

.mobilization_position { # 位置
	id 0 : integer # 任务ID
	time 1 : integer # 刷新时间 默认为nil
	is_pick 2 : boolean # 是自选的个人任务
}

.mobilization_receive_info { # 任务接取信息
	uid 0 : integer # 玩家uid
	id 1 : integer # 任务ID
	time 2 : integer # 时间
}

.mobilization_alliance { # 联盟数据
	grade 0 : integer # 联赛等级
	score 1 : integer # 积分
	is_join 2 : boolean # 联盟是否参与(开始/结算阶段使用)
	# positions 3 : *mobilization_position # 联盟任务列表
	# receive_list 4 : *mobilization_receive_info # 领取列表
	grade_old 5 : integer # 旧的联赛等级
	max_grade 6 : integer # 最大联赛等级
}

.mobilization_quest { # 任务结构
	id 0 : integer # 任务ID
	progress 1 : integer # 进度
	endtime 2 : integer # 任务结束时间
    pos 3 : integer # 个人任务需记录位置
	starttime 4 : integer # 开始时间
}

.mobilization_day_data { # 每日数据
	count 0 : integer # 购买次数
	time 1 : integer # 时间(判断是否同一天)
	finish_map 2 : *pair_int_int() # 专属位置任务完成次数{[位置]=次数}
	finish_high 3 : boolean # 是否完成高级任务
}

.mobilization_gift { # 礼包数据
	id 0 : integer # 礼包ID
	count 1 : integer # 购买次数
	ts 2 : integer # 时间(判断是否同一天)
}

.mobilization_player { # 玩家参与数据
	score 0 : integer # 玩家获取的积分
	count 1 : integer # 任务剩余接取次数
	quest 2 : mobilization_quest # 接取的任务
	received 3 : *pair_int_int() # 已领取阶段{[阶段]=值,...} 值:1.联盟(0x01) 2.个人(0x02) 3.联盟和个人
    positions 4 : *mobilization_position # 专属任务
	day_data 5 : mobilization_day_data # 每日数据
	aid 6 : integer(0) # 参与的联盟ID
	buy_count 7 : integer # 总的购买次数
	group_id 8 : integer # 里程碑奖励分组ID
	unlimited_reward_count 9 : integer # 无限宝箱已领取次数
	week_count 10 : integer # 赛季周数(用于个人任务)
	gifts 11 : *mobilization_gift(id) # 礼包数据
	gift_group_id 12 : integer # 礼包分组ID
	score_reward_lst 13 : *integer # 已领取的个人积分奖励
}



.cheque_event_info { #格子事件信息
    type                        0 : integer # 事件类型
    detail                      1 : integer # 事件效果
}

.cheque_event_detail_info {
    cheque_type                 0 : integer # 格子类型
    cheque_event_info           1 : *cheque_event_info # 事件列表
}

.cheque_reward_info {
    type                        0 : integer # 触发类型 1-道具格 2-事件格 3-起点格 4-宝箱 5-宝藏格
    reward                      1 : *item() 
}

.monopoly_quest_info {
    finishs 0 : *finishs()                      # 已领奖任务
    quests 1 : *quest()                         # 进行中任务
}

.monopoly_info {
    id                          0 : integer # 活动ID
    start_ts                    1 : integer # 活动开启时间
    end_ts                      2 : integer # 活动结束时间
    serial_no                   3 : integer
    
    total_points                4 : integer # 总点数
    received_mark               5 : *pair_int_bool() # 已领奖标记
    buy_gift_id                 6 : *pair_int_bool() # 已购买的礼包ID

    ring                        7 : integer # 圈数
    cheque_id                   8 : integer # 当前所在的格子id
    adventure_box_cheque_id     9: integer # 探险宝箱所在的格子id
    cheque_info                 10: *cheque_detail_info() # 格子数据
    wait_trigger_event          11: *cheque_event_detail_info() # 格子待触发的事件

    free_play_time              12: integer # 免费投掷时间

    group_id                    13: integer
    gift_group_id               14: integer

    record_reward_lst           15: *item # 活动期间投掷获取到的最近5条奖励列表
    record_cheque_reward_lst    16: *cheque_reward_info # 活动期间最近100条道具格及探险宝箱奖励格的获取奖励列表

    is_daily_task               17 : boolean # 是否有任务
    quest_info                  18 : monopoly_quest_info # 任务数据
}


.monopoly_winning_record { # 中奖记录
	uid                         0 : integer
	item_id                     1 : integer
	item_count                  2 : integer
    type                        3 : integer # 触发类型 1-道具格 2-事件格 3-起点格 4-宝箱 5-宝藏格
	record_ts                   4 : integer # 中奖时间
	record_id                   5 : integer # 记录唯一ID
	nick_name                   6 : string  # 中奖者昵称
	abbr                        7 : string  # 中奖者联盟简称
}



.alliance_ms_monster { # 召唤数据
	id 0 : integer # 怪物难度
	time 1 : integer(0) # 召唤时间
	finish 2 : boolean # 是否提前结束
	endtime 3 : integer(0) # 最后一波的行军结束时间（默认为nil）
}

.alliance_ms_timer { # 定时器
	id 0 : integer # 怪物难度
	time 1 : integer(0) # 时间
	uid 2 : integer # 预约召唤的玩家
}

.alliance_ms_player { # 玩家赛季数据
	score 0 : integer # 当前分
	received 1 : *pair_int_bool() # 已领取
	season 2 : integer # 所属赛季
	fail_count 3 : integer # 失败次数 
	max_score 4 : integer # 本赛季最高分
	received_count 5 : integer # 已领取的专家奖励次数
}

.alliance_ms_info { # 联盟赛季数据
	score 0 : integer # 赛季分数
	max_score 1 : integer # 历史最高分
	monster 2 : alliance_ms_monster # 赛季召唤数据
	timer 3 : alliance_ms_timer # 赛季预约数据
	season 4 : integer # 所属赛季
	fail_set 5 : *pair_int_int() # 玩家失败次数
	difficulty 6 : integer # 已解锁的难度
}

.alliance_ms_activity { # 活动数据
    id 0 : integer              # 活动id
    stage_ts 1 : *integer(0)    # 活动阶段开始时间 1.预告,2.开启,3.结算,4.预告,5.开启,6.结算
	season 2 : integer 			# 赛季
	group_id 3 : integer        # 奖励组ID
}



.month_card {
    card_type 0 : integer             # 月卡type
    validity_period 1 : integer                 # 有效期到期时间
    daily_reaward_time 2 : integer              # 每日奖励领取情况
    id 3 : integer                           #月卡ID
}



.mood_base {
    icon_id 0 : integer    # 心情id
    des_id  1 : integer    # 描述id
    endtime 2 : integer(0) # 结束时间戳, 无值为永久
}



.most_lords_info {
    id 0 : integer
    cur_stage 1 : integer # 当前阶段
    cur_integral 2 : integer(0) #当前阶段积分
    total_integral 3 : integer(0) #总积分

    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 4 : *received_mark() # 当前阶段已领取的奖励
    cur_stage_end_ts 5 : integer #当前阶段结束时间
    stove_lv 6 : integer #活动开启时的熔炉等级
    warzone_day 7 : integer #活动开启时服务器的战区天数
    start_ts 8 : integer #活动开启时间(不包含预告)
    end_ts 9 : integer #活动结束时间(不包含结算)
}



.multiple_choice_pack {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    buy_info 3 : *pair_int_intarray()    # 购买情况 【礼包组id】= {idx1,idx2..} (购买礼包索引id)
    free_box_get_time 4 : integer   # 免费宝箱领奖时间 nil未领取
}



.new_server_sprint_info {
    id 0 : integer # 活动ID
    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 1 : *received_mark() # 已领取的奖励
    start_ts 2 : integer
    end_ts 3 : integer
    cursor 4 : integer #当前可领取的最大档位
}



.new_soldier_bp {
    start_ts 0 : integer(1)             # 活动开始时间
    end_ts 1 : integer(1)               # 活动结束时间
    score 2 : integer                   # 积分
     .reward_mark {
        id 0 : integer # 阶段ID
        mark 1 : boolean # 是否被领取
    }
    free_reward 3 : *reward_mark()      # 已领取的免费奖励id
    buy_reward 4 : *reward_mark()       # 已领取的免费奖励id
    buy 5 : boolean                     # 是否已购买
}



# 民意信件
.opinion {
    id              0 : integer     # 实例id
    type            1 : integer     # 信件类型(建筑、心情...)
    sid             2 : integer     # 信件来源幸存者
    img_id          3 : integer     # 幸存者形象id
    name_id         4 : integer     # 幸存者名称id
    content_id      5 : integer     # 信件内容配置表id
    is_anonymity    6 : boolean     # 是否匿名

    # 紧急事件特殊
    choice_id       7 : integer     # 紧急信件选项id
    select_id       8 : integer     # 紧急信件选择id
}



.optional_gift_pack {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(1)         # 活动开始时间
    end_ts 2 : integer(1)           # 活动结束时间
    buy_info 3 : *pair_int_intarray()    # 购买情况 【礼包组id】= {idx1,idx2..} (购买礼包索引id)
    free_box_get_time 4 : integer   # 免费宝箱领奖时间 nil未领取
}



.pachinko_route { # 弹珠轨迹
    time 0 : double
    enter 1 : integer
    exit 2 : integer
    hit1 3 : integer
    hit2 4 : integer
    paths 5 : *double
}

.pachinko_info {
    left 0 : integer # 左缓冲器计数
    right 1 : integer # 右缓冲器计数
    progress 2 : integer # 进度
    free_times 3 : integer # 剩余免费次数
}





.personal_7days {
    start_ts 0 : integer(1)         # 活动开始时间
    end_ts 1 : integer(1)           # 活动结束时间
    score 2 : integer               # 积分数量
    scord_raward 3 : *pair_int_bool()        # 积分奖励领取情况 【idx】= true
    quests 4 :  *quest(id)    #今天任务中未领奖任务信息
    finishs 5 : *pair_int_bool()    #今天任务中已领奖任务 
}



.pet_attr {                     # 宠物属性
	id 0 : integer              # 属性
	value 1 : integer           # 属性值 万分比
}

.pet_skill {
	use_time 0 : integer		# 使用时间
	use_skill_lv 1 : integer 	# 使用时技能的等级	
}

.pet_skill_info {
	skill_id 0 : integer
	skill_info 1 : pet_skill
}

.pet_domestication_info { # 宠物驯化信息
	type 0 : integer			# 驯化类型 1-骑乘 2-生肉
	last_time 1 : integer 		# 上次驯化时间
	count 2 : integer 			# 当天驯化次数
	value 3 : integer 			# 数值 当前亲密度或者饱食度
	total_count 4 : integer 	# 累计驯化次数
}

.pet {
	id 0 : integer
	lv 1 : integer 		        # 宠物等级
	break_lv 2 : integer 		# 突破等级
    attr 3 : *pet_attr()    	# 属性列表
    wash_attr 4 : *pet_attr()   # 洗炼属性列表
	is_unlock 5 : boolean 		# 是否驯化解锁, 解锁才可以升级
	pet_domestication_info 6 : pet_domestication_info # 驯化信息
}

.skill_event {
	type 0 : integer
	param 1 : *integer			# 技能效果多个参数
	skill_id 2 : integer		# 技能id
}

.pet_ex_info { # 宠物额外信息
    play_time 0 : integer       # 交互时间
    play_nums 1 : integer       # 交互次数
	show_pet_id 2 : integer		# 展示的宠物
	skill_event_info 3 : *skill_event(skill_id)	# 使用技能的事件
	use_skill_info 4 : *pet_skill_info()	# 技能使用情况
	is_get_upgrade_item 5 : boolean	# 是否领取升级道具
	wash_count 6 : integer		# 洗炼次数
}



.pet_adventure_area {           # 宠物探险区域
	id 0 : integer              # 区域id
	index 1 : integer			# 宠物探险表索引
	pet_id 2 : integer			# 探险的宠物id
	start_time 3 : integer		# 探险的开始时间
	finish_time 4 : integer		# 探险的完成时间
	refresh_time 5 : integer	# 刷新时间
}

.pet_adventure_alliance_reward { # 联盟奖励
	id 0 : integer				# 奖励唯一id
	share_id 1 : integer		# 分享id 当存在分享id时 说明分享了
	expire_time 2 : integer		# 过期时间
	pet_id 3 : integer			# 派遣的宠物id
	del_time 4 : integer		# 显示删除时间 
	index 5 : integer			# pet_adventure配置的index 
}

.pet_adventure_info {
	area_info 0 : *pet_adventure_area(id) 	# 探险区域数据
	daily_adventure_nums 1 : integer		# 今日探险次数
	daily_get_share_nums 2 : integer		# 今日领取分享奖励次数
	alliance_reward 3 : *pet_adventure_alliance_reward(id) # 自己的分享列表数据
}

.pet_adventure_alliance_share_reward_user_info { # 已领联盟分享奖励玩家信息
	uid 0 : integer				# 玩家id
	reward 1 : *item()			# 奖励
	time 2 : integer			# 领取时间
}

.pet_adventure_alliance_share_reward_info { # 联盟分享奖励信息
	uid 0 : integer																# 分享者id
	share_id 1 : integer														# 分享id
	reward_user_infos 2 : *pet_adventure_alliance_share_reward_user_info		# 已领联盟分享奖励玩家信息
	expire_time 3 : integer 													# 过期时间
	item_id 4 : integer															# 分享条目的序号
}


.pet_recharge_info {
    start_ts 0 : integer                # 开始时间
    end_ts 1 : integer                  # 结束时间
    progress 2 : integer                # 进度
    received 3 : *pair_int_bool()       # 已领取奖励的阶段ID
    level 4 : integer                   # 奖励等级
}



.pick_one_gift_info {
    id 0 : integer               # 活动ID
    start_ts 1 : integer         # 活动开始时间
    end_ts 2 : integer           # 活动结束时间
    serial_no 3 : integer        # 活动序列号
    reward_group 5 : integer     # 当前的奖励组ID, 索引pick_one_gift的reward_group字段
    reward_group_arr 6 : *integer # 奖励组数组
    buy_gift_id 7 : integer      # 购买的礼包ID, pick_one_gift表的索引
}



.pin_game {
    id 0 : integer                  # 活动id
    start_ts 1 : integer(0)         # 活动开始时间
    end_ts 2 : integer(0)           # 活动结束时间
    version 3 : integer             # 期数

    mission 4 : integer             # 已通关关卡

    .pin_game_task {
        quests 0 :  *quest()      # 未领奖且有进度的任务
        finishs 1 : *finishs()    # 已领奖任务
    }
    tasks 5 : pin_game_task
}



.pitch_pot_info { # [玩家活动信息]
    id                    0 : integer # 活动ID
    start_ts              1 : integer # 活动开启时间
    end_ts                2 : integer # 活动结束时间
    serial_no             3 : integer # 活动序列号
    warzone_group         4 : integer # 战区奖励组
    main_data             5 : pitch_pot_main_data
}

.pitch_pot_main_data {
    level                 0 : integer # 当前关卡（结算后+1递增 最后一关无限）
    started               1 : boolean # 当前关卡已消耗次数（结算后清除标记）
    ticket                2 : integer # 可用的游戏次数
    max_score             3 : integer # 单个关卡的最高分数记录

    # 总成就达成次数（1=壶口/2=贯耳/3=有初/4=连中/5=连贯/6=有终/7=全壶）

    history               4 : *pair_int_int() # 单个关卡历史成就
}

.pitch_pot_achieve {
    type        0 : integer
    value       1 : integer
    received    2 : *pair_int_bool() # 是否领取 achievement_index: has_receive
}

.pitch_pot_task { # 寻物活动任务列表
    quests              0 : *quest()      # 未领奖且有进度的任务
    finishs             1 : *finishs()    # 已领奖任务
}


.merge_kingdom_info {  #合服数据
    merge_map 0 : *pair_int_int() # 合服预告map<src, dst>: 从src合并到dst
    merge_ts 1 : integer(0) #合服时间
}



.pe_team_info { # 队列数据
    id 0 : integer # 队列ID
    state 1 : integer # 队列状态 0 空闲 1 探险中 2 待领奖
    end_ts 2 : integer(0) # 探险完成时间
    item_map 3 : *pair_int_int() # 探险获得的物品, state = 2时有效, 其他状态下为空
}

.pe_act_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer(0) #活动开启时间
    end_ts 2 : integer(0) #活动结束时间
    serial_no 3 : integer #活动序列号
    stage 4 : integer # 当前阶段, 3是结算阶段
    num 5 : integer # 探险次数
    receive_set 6 : *pair_int_bool() # 次数奖励领取标记
    team_infos 7 : *pe_team_info
    group 8 : integer # 奖励组ID
    daily_reward_ts 9 : integer(0) # 每日免费奖励领取时间
    cur_stage_end_ts 10 : integer(0) #当前阶段结束时间
    gift_group 11 : integer # 礼包组ID
}



.ps_give_record {   # 送礼记录
    id 0 : integer # 记录id
    uid 1 : integer # 玩家uid
    item_id 2 : integer # 道具id
    count 3 : integer # 道具数量
    time 4 : integer(0) # 时间
    target 5 : integer # 收礼人，战区记录用到该字段
