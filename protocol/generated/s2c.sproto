notify_alliance_arsenal_war_info 11951 {	# 同步联盟跨服战信息
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		.set {
			i 0 : integer			# 时间段索引号
			b 1 : boolean
		}
    	.vote_info {
			uid 0 : integer			# 玩家id
			index 1 : *set() 		# 时间段索引号
		}
		vote 0 : *vote_info()		# 投票信息
		is_notice 1 : boolean		# 是否发过投票通知
		sign_indexes 2 : *integer 			# 报名的时间段索引号
		.fight_info {
			uid 0 : integer			# 玩家id
			v 1 : boolean			# 标识(无用)
		}
		fights 3 : *fight_info()			# 参战成员
		substitutes 4 : *fight_info()	# 替补成员
		battle_index 5 : integer	# 战斗的时间段索引号
		ask_for_battle 6 : *set()	# 请战玩家
		can_sign 7 : boolean		# 是否能报名

		state 8 : integer # 活动状态 1=投票, 2=报名, 3=匹配, 4=战斗
		state_begin_ts 9 : integer # 状态开始时间
		state_end_ts 10 : integer # 状态结束时间

		#battlefield_starttime 11: integer # 战场开启时间（废弃，移到军团数据
		#battlefield_endtime 12: integer # 战场结束时间 （废弃，移到军团数据

		fraction 13 : integer # 积分(评级根据配置读取)
		match_res_avaiable 14 : boolean # 存在匹配结果
		count_reward_avaiable 15 : boolean # 倒数奖励(true表示可领取)
		max_grade 16 : integer # 最高评级
		kingdom_phase 17 : integer # 国王期数
		.legion_info {
			sign_indexes 0 : *integer 			# 报名的时间段索引号
			fights 1 : *fight_info()			# 参战成员
			substitutes 2 : *fight_info()	# 替补成员
			ask_for_battle 3 : *set()	# 请战玩家
			battlefield_starttime 4 : integer # 战场开启时间
			battlefield_endtime 5: integer # 战场结束时间
			fight_index 6 : integer          # 最终参赛的时间段索引号
			match_count 7 : integer			# 匹配时队伍的人数
			forbid_for_battle 8 : *set()	# 不参战玩家 
		}
		.map_legions {
			id 0 : integer					# 军团id
			info 1 : legion_info
		}
		legions 18 : *map_legions()
		login_count 19 : integer			# 每周登入人数
		group_id 20 : integer # 奖励组ID
    }
}



