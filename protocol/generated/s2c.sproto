# 家具通用结构
.furniture {
    .base {
        conf_fid    0 : integer     # 家具配置表的fid
        type        1 : integer     # 家具类型
        lv          2 : integer     # 家具等级
    }

    fid             0 : integer     # 家具id，服务器生成
    base            1 : base        # 基础数据

    #sid             2 : integer     # 该家具工位工作的幸存者
    work_endtime    3 : integer     # 工作结束时间(猎人工具才有，每个work周期只能工作一次)
    remaining_mti   4 : integer     # 工作时长剩余不够生产一个单元资源的部分(毫秒)
    sid_list        5 : *integer    # 宿舍-床 的幸存者
    output_after_buff 6 : integer   # 单位时长产出
}

# 建筑通用结构
.building {
    .base {
        lv          0 : integer     # 建筑等级
        status      1 : integer     # 建筑状态
        furniture   2 : *furniture(fid) # 建筑家具数据
    }

    bid         0 : integer     # 建筑地块id
    base        1 : base        # 基础数据
    qid         2 : integer     # 建造或升级队列id

    # 特定建筑数据，大熔炉数据
    switch      4 : integer     # 燃烧开关设置 0:关闭 1:打开
    overdrive   5 : integer     # 过载开关设置 0:关闭 1:打开
    # 厨房数据
    foods       6 : *integer    # 现有食物id数组
    production_food_id 7 : integer  # 制作的食物
}



.goods {                    # 商品
    id 0 : integer          # 商品id
    conf_id 1 : integer     # 商品配置id
    buy_count 2 : integer   # 已购买数量
    tag 3 : integer         # 商品标签  1.专家技能
    grid_id 4 : integer     # 商品真实的格子id
    unlock_ts 5 : integer   # 商品首次刷新时间，用于 NEW 标签展示
}

.shop { 	                    # 商店
	id 0 : integer
    goods 1 : *goods(id)        # 商品列表
    last_refresh_ts 2 : integer # 上次自动刷新时间
    refresh_times 3 : integer   # 已刷新次数
    first_refresh_time 4 : integer #刷新周期内 第一次刷新时间
    expert_count 5 : integer # 专家刷新次数
}


.showcase_data {
    lv              0 : integer   # 等级
    point           1 : integer   # 总分
    level_rewarded  2 : *integer  # 已领取的奖励对应的level列表 
    show            3 : boolean   # 是否允许别人观察
    skin            4 : *integer  # 永久装扮列表
    expression      5 : *integer  # 表情列表
    furniture       6 : *pair_int_int()  # 家具列表 k:id, v:最高等级
}



.sign_draw_info {
