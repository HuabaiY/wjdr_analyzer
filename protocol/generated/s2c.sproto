        kingdom_reward_record 7: *kingdom_reward_record()  # 王国奖励领取记录，字段为空时表示冠军还未产生  {[赛区id] = { [排名1] = true, [排名2] = false}}，  true=已领取  false = 可领取但未领取
    }
}

