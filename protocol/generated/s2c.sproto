notify_capital_war_init 10951{ #
	request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		state 0 : integer #活动状态
		endtime 1 : integer #当前状态结束时间

		president_data 2 : president_data #仅下发给总统和内政部长的数据

		is_winner 3: boolean #获胜联盟标记
		elect_endtime 4 : integer #选举结束时间(仅下发给获胜联盟)

		show_state 5 : integer #显示的活动阶段
		show_endtime 6 : integer #显示的活动阶段结束时间
		is_first 7 : boolean #是否首次

		buff_map 8: *capital_war_buff_cell() #国王技能发动的buff
		president 9 : integer #总统uid（仅下发给获胜联盟）
		is_cross_mode 10 : boolean #是否跨服模式
		vassal_kid 11 : integer # 附属国kid, president_data中含有相同的字段,后续可优化
		buff_office 12 : integer # 当前官职buff的官职ID
		buff_change_ts 13 : integer(0) # 上次修改官职buff的时间
		group 14 : integer # 奖励组ID
		ban_office_apply 15 : *integer(0) # 禁止申请官职的uid列表, 国王会收到完整的列表. 被禁止的玩家会收到一个仅包含自身uid的列表
		ban_apply 16 : boolean # 是否被禁止申请官职, true时表示被禁止申请官职

		office_mode 17 : integer # 官职模式
		office_mode_ts 18 : integer(0) # 官职模式开始时间
		apply_slot 19 : *capital_war_apply_slot_info(office) # 报名的时段信息
		term_info 20 : capital_war_term_info # 任期信息
	}
}

