notify_supremacy_war_guess_info 16725 { # 登录推送个人数据
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        id 0 : integer # 活动id
        start_ts 1 : integer(0)
        end_ts 2 : integer(0)

        group_id 3 : integer  # 赛区

        .support_alliance {
            aid 0 : integer(0)
            ts 1 : integer
        }
        .choose_question {
            id 0 : integer
            option 1 : integer
            ts 2 : integer
        }

        supports 4 : *support_alliance(aid) # 支持的联盟
        choose 5 : *choose_question(id)  # 每道题目选择的选项
        result 6 : supremacy_war_guess_result # 竞猜/答题结果
        stage 7 : integer
    }
}

