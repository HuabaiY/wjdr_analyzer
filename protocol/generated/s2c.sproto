notify_opinion_info 8551 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        opinion_list                0 : *opinion    # 信件
        emergency_opinion_list      1 : *opinion    # 紧急求助信件
        satisfaction                2 : integer     # 满意度
        max_satisfaction            3 : integer     # 最高满意度
        emergency_end_cd            4 : integer     # 紧急事件cd结束时间(仅该事件cd是针对大类，且由服务端决定)
        last_max_satisfaction       5 : integer     # 可领取奖励的最高满意度
        satisfaction_history        6 : *integer    # 满意度历史记录(下标1、2、3分别表示距今天前1、2、3天的最高满意度)
    }
}

notify_opinion_update 8552 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        opinion                     0 : opinion     # 信件
        satisfaction                1 : integer     # 满意度
        max_satisfaction            2 : integer     # 最高满意度
        emergency_end_cd            3 : integer     # 紧急事件cd结束时间(其它类型无值)
        satisfaction_history        4 : *integer    # 满意度历史记录(下标1、2、3分别表示距今天前1、2、3天的最高满意度)
    }
}




