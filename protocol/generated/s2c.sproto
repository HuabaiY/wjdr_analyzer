    count 2 : integer # 完成次数
    receive_count 3 : integer # 已领取次数
}

.spar_laboratory_exchange { # 兑换
    id 0 : integer # 兑换ID
    count 1 : integer # 兑换次数
}

.spar_laboratory_activity { # 活动数据
	id 0 : integer # 活动ID 
	starttime 1 : integer # 开始时间
	endtime 2 : integer # 赛季结束时间
    quests 3 : *spar_laboratory_quest(id) # 任务数据
    gifts 4 : *spar_laboratory_gift(id) # 礼包购买信息
    exchanges 5 : *spar_laboratory_exchange(id) # 兑换信息
}







.spring_couplets_data { # 春联信息
    actid       0  : integer                     # 活动id
    suit_data   1  : *suit                       # 套装
    comp_data   2  : *pair_int_int()             # 组件(组件id，多余组件数量)  数量>=0表示组件已激活
    apply_data  3  : spring_couplets_apply_data  # 申请数据
    box_num     4  : integer                     # 宝箱数量（1个宝箱获得1个组件）
    act_endtime 5  : integer(0)                  # 活动结束时间
}

.suit { # 套装信息
    suitid 0 : integer # 套装id
    reward 1 : boolean # 是否领取奖励
}

.spring_couplets_apply_data { # 捐赠信息
    apply_expire_time   0 : integer(0) # 当前申请过期时间
    component_id        1 : integer    # 当前申请组件
    donator_uid         2 : integer    # 当前捐赠玩家id
    receive_times       3 : integer    # 领取次数
}


.gift_group_data {
    group_id     0 : integer       # 礼包组id
    expire_ts    1 : integer       # 礼包过期时间戳（活动过期时间）
}


.subscribe_reward_info {
    is_unlock 0 : boolean                       # 是否解锁
    is_subscribe 1 : boolean                    # 是否订阅
    is_reward 2 : boolean                       # 是否领奖

    subscribe_type 3 : *pair_int_bool()         # 订阅的类型 1:抖音
    subscribe_reward 4 : *pair_int_bool()       # 订阅的类型是否领奖
}



.birthday_customize_item {
    boxid           0 : integer   #格子id  
    items           1 : *item()
}

.birthday_reward_info { # 生日奖励数据
    year            0 : integer # 生日年
    stove_lv        1 : integer # 生日时的熔炉等级
    reward_id       2 : integer # 奖励id
    expire_time     3 : integer # 过期时间
    privilege_mark  4 : *pair_int_bool() # {[奖励类型]=true} 标示玩家当前有哪些奖励 奖励类型：1-免费 2-自选
    is_get          5 : *pair_int_bool() # 是否领取 奖励类型：1-免费 2-自选
    customize_item  6 : *birthday_customize_item() # 自选道具
}

.super_vip {
    join_time               0 : integer # 加入会员的时间
    join_reward_expire_time 1 : integer # 加入会员的奖励过期时间
    is_get_join_reward      2 : boolean # 是否领取加入奖励
    last_birthday_gift_time 3 : integer # 生日礼包上次触发时间
    next_birthday_gift_time 4 : integer # 下次生日礼包触发时间
    is_vip                  5 : boolean # 是否会员
}

.super_vip_set_info {
    is_set                  0 : boolean # 是否设置过 只要设置过 玩家无法修改生日和邮箱

    set_time                1 : integer # 设置的时间 只要不是同一天 设置次数就可以重置
    today_set_count         2 : integer # 今日设置次数

    .birthday_date {
        month               0 : integer
        day                 1 : integer
    }

    birthday                3 : birthday_date
    mail                    4 : string
    discord                 5 : string
    gender                  6 : integer # 1-男性 2-女性 3-第三性别
    wechat                  7 : string # 微信号
    telephone               8 : string # 电话
}


