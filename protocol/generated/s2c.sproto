	}
}

notify_capital_war_new_application 10961 { # 新的官职申请或者自动同意状态变化 只有国王和内政部长会收到
	request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		office 0 : integer
		new 1 : capital_war_application_info # 新的申请
		auto_agree 2 : boolean # 此字段存在时,表示自动同意状态发生变化
		# 当前存在的最新申请(注: 申请过期删除时不会发这个字段), 申请列表为空时, 此字段内容为{ ts = 0}
		change 3 : capital_war_application_info
        only_native 4 : boolean # 是否仅同意本国
		lv_limit 5 : integer # 自动同意的条件, nil时取默认值
	}
}

notify_capital_war_office_watch_data 10962 { # 官职watch数据
	request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		is_full 0 : boolean # 是否全量
		uid 1 : integer # 当前任职玩家
		appoint_ts 2 : integer(0) # 最近一次任职时间

		.info {
			uid 0 : integer
			ts 1 : integer(0) # 加入排队的时间
		}
		list 3 : *info # 全量时此字段才有意义

		.change_info {
			uid 0 : integer
			opt 1 : integer  #0 新增, 1 删除, 2 置顶
			# 在队列中的位置
			# 新增时: 表示插入到队列后的位置, 即末尾
			# 删除时: 表示删除前所在的位置
			# 置顶时: 表示置顶前所在的位置
			idx 2 : integer 
			ts 3 : integer(0) # 加入排队的时间, 新增时自字段才有意义
		}
		change 4 : change_info
		dismiss 5 : boolean # 解雇当前玩家
		office 6 : integer # 官职ID

		.slot_info {
			idx 0 : integer # 时段id
			apply_num 1 : integer # 申请人数
			order_uid 2 : integer # 内定人选uid
			apply_ts 3 : integer(0) # 最新一个申请的时间戳
		}
		slot_map 7 : *slot_info(idx) # 未来n个时段的数据, 仅在full=true时下发
        slot_change 8 : slot_info # 时段数据变化, 客户端直接覆盖对应时段数据即可
		cur_slot 9 : integer # 当前任职中的时段
