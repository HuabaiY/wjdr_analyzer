notify_puzzle_item_info 17401 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .puzzle_photo {
            theme_id 0 : integer
            value 1 : integer(0)
        }

        photo_map 0: *puzzle_photo()                     #照片解锁情况, 每张照片在 value 占一位，1=解锁，0=为解锁
        fragment_map 1: *pair_int_intarray()             #碎片数量情况  （【theme_id】 = （ 【simple_idx】 = count ）） 二维数组, theme_id和simple_idx 都是从1开始自增
        box_map 2: *item()                               #卡包数据 （【item_id】 = count）
    }
}

notify_puzzle_item_update 17402 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        photo 0: *item()                                #新解锁的照片列表
        fragment 1: *item()                             #碎片数量情况 （【item_id】 = count）  count正数为加，负数为减
        box 2: *item()                                  #卡包变化数据 （【item_id】 = count）  count正数为加，负数为减
    }
}

