notify_arsenal_league_act_info 30600 { # 通知联赛活动数据
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        act_id 0 : integer # 活动id
        act_begin_ts 1 : integer(0) # 活动开始时间戳
        act_end_ts 2 : integer(0) # 活动结束时间戳
        stage 3 : integer # 活动阶段 1=预告, 2=投票, 3=报名, 4=匹配, 5=淘汰赛, 6=争霸赛,
        stage_begin_ts 4 : integer(0) # 阶段开始时间戳
        stage_end_ts 5 : integer(0) # 阶段结束时间戳
        group_id 6 : integer # 赛区id
        login_count 8 : integer	# 每周登入人数
        season 9 : integer # 赛季
        vote 10 : *arsenal_league_vote_info()		# 投票信息
        is_notice 11 : boolean      # 是否发过投票通知
		legions 12 : *arsenal_league_legion_info(id)             # 军团列表
        
        .division_info {
            group_id 0 : integer # 赛区id
            min_kid 1 : integer # 最小王国id
            max_kid 2 : integer # 最大王国id
            is_idle 3 : boolean # 是否轮空
        }
        division_infos 13 : *division_info(group_id) # 赛区信息
        reward_group_id 14: integer # 奖励组id

        .group_match_ts {
            group_id 0 : integer # 赛区id
            today_match_ts_list 1: *integer # 今日未完赛的比赛时段
        }
        group_match_info 15 : *group_match_ts() # 赛区比赛时段
    }
}



