notify_triangle_war_map_update 16027 { # 战场地图对象更新
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .triangle_war_mapobjs_update {
            point 0: point
            type 1 : integer
            change 2 : world_mapobj
            del 3 : world_mapobj_del_keys
        }
        .triangle_war_march_update {
            id 0 : integer #出征id
            owner 1 : integer #部队拥有者
            change 2 : triangle_war_march #更新信息
            del 3 : triangle_war_march_del_keys #删除信息
        }
        mapobj_update 0 : *triangle_war_mapobjs_update
        march_update 1 : *triangle_war_march_update
    }
}

