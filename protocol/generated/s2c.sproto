notify_snow_clean_info 30261 {    # 活动数据推送
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        id 0 : integer                  # 活动id
        stage_ts 1 : *integer           # 阶段时间戳列表 [预告时间戳,开始时间戳,结束时间戳,结算时间戳]
        round 2 : integer               # 期数
        mission 3 : integer             # 当前关卡进度
        power 4 : integer               # 吸雪能量（未加上自然恢复量）
        ts 5 : integer                  # 自然恢复计算起始时间戳
        mission_cost_power 6 : integer  # 当前关卡消耗能量值
                                        # 客户端显示的能量值=power+自然恢复量-mission_cost_power
        point 7 : integer               # 积分
        equipment 8 : *integer          # 装备等级列表

        .snow_clean_task {
            quests 0 : *quest()         # 未领奖且有进度的任务
            finishs 1 : *finishs()      # 已领奖任务
        }
        tasks 9 : snow_clean_task    # 每日任务列表

        .snow_clean_handbook {
            illusts 0 : *integer                # 已经获得的图鉴
            star_reward_info 1 : *integer       # 星星已领奖信息 id为星星配置id
            single_reward_info 2 : *integer     # 单图鉴已领奖信息 id为物件id
            whole_reward_info 3 : *integer      # 全图鉴已领奖信息 id为物件类型
        }
        handbook 10 : snow_clean_handbook # 图鉴信息
        day 11 : integer # 战区天数
        progress 12 : integer # 关卡进度 万分比
        random_key 13 : string

        gift_group_id 14 : integer      # 礼包组id
        gift_expire_ts 15 : integer     # 礼包过期时间戳
        exchanged_count 16 : integer    # 本期兑换过的火箭数量
        highest_mission 17 : integer    # 历史最高关卡
        can_sweep 18 : boolean          # 是否可以扫荡
    }
}

