notify_chat_init 3401 { 	# 通知
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        endpoint 0: string # rtm client addr(<sdk 2.7.0)
        pid 1 : integer #
        token 2 : string # rtm token
        blocklist 3 : *chat_u2t() # 屏蔽map
        kingdom_rid 4 : integer # 王国GROUP ID
        alliance_rid 5 : integer # 联盟GROUP ID
        broadcast_local_kin_gid 6 :integer #本服广播组ID

        cross_capital_war_rid 7: integer #跨服GROUP ID（最强王国战）
        endpoint_2_7_0 8: string # rtm client addr(>=sdk 2.7.0)
        expression_map 9 : *pair_int_bool() # 拥有的聊天表情
        temporary_blocklist 10 : *temporary_block(uid)
        reddot_ts 11 : integer # 红点时间
        websocket_endpoint 12: string # rtm websocket addr(>=sdk 2.7.0)
        broadcast_ts 13 : integer #上次发送广播时间戳
        p2p_his_del 14 : *p2p_history_del()
        stranger_lv_limit 15 : integer # 陌生人私聊等级限制
        recent_contact 16 : *pair_int_bool() # 最近联系人
        group_read_mark 17 : *chat_read_mark() # 已读标记
        is_show_self_skin 18 : boolean # 是否优先显示自己的私聊背景装扮
        ban_stranger 19 : boolean # 是否设置屏蔽陌生人
        endpoint_bak 20 : string # rtm client 备用addr
        websocket_endpoint_bak 21 : string # rtm websocket 备用addr
        p2p_unread_mark 22 : *p2p_mark() # 私聊未读标记
        room_unread_mark 23 : *room_mark() # 房间未读标记
        is_hugegame_server 24: boolean # 是否直播活动王国， nil/false时表示不是直播王国
        hugegame_channel 25: integer(0) # 为空时表示当前未开放直播活动
        hugegame_account 26: boolean
    }
}

