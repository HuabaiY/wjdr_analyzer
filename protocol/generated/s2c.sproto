notify_paid_sprint_info 21250 { # 全量同步（登录/变更时下发）
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        max_single_amt   0 : integer  # 历史最大单笔储值积分（客户端据此+配置阈值算单笔领奖权限）
        max_daily_amt    1 : integer  # 历史最大单日累计储值积分（客户端据此+配置阈值算当日领奖权限）
        today_daily_amt  2 : integer  # 今日已累计储值积分（进度展示）
        single_claimed   3 : *integer # 已领奖的单笔任务id列表
        daily_claimed    4 : *integer # 已领奖的当日累计任务id列表
        last_recharge_success_ts 5 : integer  # 最近一次成功充值时间戳（客户端据此+配置阈值算当日领奖权限）
    }
}

