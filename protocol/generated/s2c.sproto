notify_alliance_relationship 5187 { # 联盟关系更新, 登录初始化也是这条通知
	request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
		full 0 : boolean # true时表示全量数据
		.relation_info {
			aid 0 : integer(0)
			type 1 : integer # 1-友好 2-敌对
			power 2 : integer(0) # 战斗力
		}
		relationships 1 : *relation_info(aid) # full为true时, 此字段才有值
		change_count 2 : integer # 今日关系变更次数
		.relationship {
			aid 0 : integer(0)
			type 1 : integer # 1-友好 2-敌对
			del 2 : boolean # true时表示删除关系. 对方联盟解散时己方也会收到删除
			power 3 : integer(0) # 战斗力
		}
		update 3 : relationship # 变动值
		change_ts 4 : integer(0) # 关系变更时间
		.change_count_info {
			aid 0 : integer(0)
			count 1 : integer
		}
		change_count_map 5 : *change_count_info() # 关系变更次数map, key为aid, value为今日变更次数(解除关系不计数), 每日重置
		close_mail 6 : boolean # true时表示关闭邮件通知
		mail_rank_limit 7 : integer # 邮件排名限制, 当对方联盟排名大于该值时, 不发送邮件
	}
}

notify_alliance_delta_data 5188 { # 联盟增量数据变化
	request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
