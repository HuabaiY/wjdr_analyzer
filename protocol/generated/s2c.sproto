    get_daily_gift_ts 4 : integer       # 每日免费礼物领取时间
    uncollected_daily_gift 5 : *pair_int_int() # 未收取的每日免费礼物，只有非当前等级的部分，当前等级的判断照旧
    vip_init_time 6 : integer # vip1级初始的时间
    vip_upgrade_time 7 : integer # vip升级的时间
}



.puzzle_info {
