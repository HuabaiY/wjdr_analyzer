        uid 4 : integer    # 队长
        .map_score {
            aid 0 : integer(0) # 联盟id
            score 1 : integer   # 分数
        }
        scores 5 : *map_score() # 联盟分数
        persons_max 6 : integer # 最大集结人数
        score_begin 7 : integer # 分数开始时间
        .map_buff {
            id 0 : integer
            .map_buff_value {
                value 0 : integer
                time 1 : integer(0) # 有效期
            }
            value 1 : map_buff_value
        }
        buffs 8 : *map_buff() # 默认nil

        call_zombie_time 9 : integer(0) # 上次召唤怪物时间(type = 205)
        zombie_count 10 : integer # 已召唤怪物次数(type = 205)
        overflow 11 : integer   # 占领联盟被击败时的溢出分数(仅在有溢出分数时才发送)
        .first_occupy_info {
            aid 0 : integer(0)
            tag 1 : boolean
        }
        first_occupy 12 : *first_occupy_info() # 首次占领信息
        side 13 : integer # 占领者阵营
    }

    .map_arsenal_weapon_workshop {
        id 0 : integer      # 资源配置的id
        uid 1 : integer         # 占领者id
        aid 2 : integer(0)         # 占领者联盟id
        march_id 3 : integer    # 队列id
        begin_time 4 : integer  # 采集开始
        count 5 : integer       # 剩余资源
        side 6 : integer # 占领者阵营
    }

    .map_arsenal_crumb {
        parent_id 0 : integer # 所属建筑的ID
        integral 1 : integer # 积分值
    }

    .map_frostfire_sub_res {        # 燃霜资源掉落
        count 0 : integer       # 资源数量
        create_time 1 : integer # 矿出现的时间
        parent_pos 2 : point    # 矿点坐标
    }

    .map_frostfire_burst_res {      # 燃霜迸发矿
        uid 0 : integer     # 占领者uid
        march_id 1 : integer    # 占领者队列id
        count 2 : integer       # 资源点剩余数量
        create_time 3 : integer # 矿出现的时间
        recover_ts 4 : integer    # 恢复时间
        abbr 5 : string       # 联盟简称
        nick_name 6 : string    # 占领者名字
    }

    .map_frostfire_resource {
        id 0 : integer              # 资源配置的id
        uid 1 : integer             # 占领者id
        march_id 2 : integer        # 队列id
        recover_ts 3 : integer      # 恢复时间
        monster_dead 4 : boolean    # 怪是否死亡
        atk_point 5 : point
        win 6 : boolean # 玩家是否胜利
        time 7 : integer # 发生战斗时间
        abbr 8 : string       # 联盟简称
        nick_name 9 : string    # 占领者名字
    }

    .map_frostfire_center {         # 燃霜中心建筑
        uid 0 : integer         # 占领者id
        march_id 1 : integer        # 队列id
        begin_time 2 : integer      # 坐下时间
        recover_ts 3 : integer    # 恢复时间
        abbr 4 : string       # 联盟简称
        nick_name 5 : string    # 占领者名字
        stand_time 6 : integer  # 站起时间
    }

    .map_dinner_table {
        aid 0 : integer(0)         # 联盟id
        .uid_bool {
            uid 0 : integer
            b 1 : boolean
        }
        invitation 1 : *uid_bool()      # 能参加的uid
        satiated 2 : *uid_bool()        # 已经参加的uid
        over_time 3 : integer(0)        # 到期时间
        pname 4 : string          # 玩家名字
        abbr 5 : string                 # 联盟简称
        aname 6 : string        # 联盟名字
        parent_point 7 : point  # 父建筑坐标
        cfg_id 8 : integer      # 配置id
        id 9 : integer(0)          # 餐桌id
        uid 10 : integer        # 创建者id
        gift_id 11 : integer    # 礼包id
    }

    .map_alliance_feast { # 联盟宴会建筑
        aid 0 : integer(0)
        id 1 : integer
        build_finish 2 : boolean
        build_start_ts 3 : integer
        build_finish_ts 4 : integer
        hp 5 : double
        conf_id 6 : integer
        abbr 7 : string
        max_hp 8 : integer
        occupy_order 9 : integer
        flag 10 : integer
        flag_bg 11 : integer
        .act_info {
            feast_start_ts 0 : integer(0) #宴会开启时间, 不为nil即表示宴会已开启
            reserve_ts 1 : integer(0) #宴会预约时间, 开启后为nil
        }
        round 12 : integer # 第n波生成
        act_info 13 : act_info # 活动数据
        feast_finish 14 : boolean # 宴会是否结束
        table_gift_id 15 : integer # 礼包ID
        table_host_name 16 : string # 餐桌主人名字
    }

    .map_triangle_building {
        .march_info {
            uid 0 : integer                     # 玩家id
            march_id 1 : integer                # 队列id
            is_monster 2 : boolean              # 是否怪物,true为怪物
        }
        defenses 1 : *march_info                # 防守队列
        attacks 2 : *march_info                 # 进攻队列
        monsters_list 3 : *world_march_detail   # 怪物队列
        monsters_lounge 4 : *integer            # 怪物等待复活
        next_battle_time 5 : integer(0)         # 战斗结束时间,下一场战斗开始时间
        is_monster 6 : boolean                  # 对手是否怪物
        monster_revive_time 7 : integer(0)      # 怪物复活时间
        .triangle_war_soldier_change {
            old_count 0 : integer(0)
            new_count 1 : integer(0)
            old_power 2 : integer(0)
            new_power 3 : integer(0)
            march_id 4 : integer
        }
        atk_change 8 : triangle_war_soldier_change  # 进攻方战斗变化
        def_change 9 : triangle_war_soldier_change  # 防守方战斗变化
        aid 10 : integer(0)                        # 联盟id
        defense_begin_time 11 : integer(0)         # 占领开始时间
        lord 12 : integer                       # 城主
    }

    .map_supremacy_guard {  # 霸主战守护建筑
        aid 0 : integer(0)          # 联盟id
        state 1 : integer           # 当前状态 1-可争夺 2-保护
