notify_pachinko_info 20441 {  # 活动数据
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        id 0 : integer                  # 活动id
        start_ts 1 : integer(0)         # 活动开始时间
        end_ts 2 : integer(0)           # 活动结束时间
        info 3 : pachinko_info
        progress_rewarded 4 : *integer  # 已领取的进度奖励索引
        day 5 : integer                 # 战区天数
        buffer1_conf_id 6 : integer     # 左缓冲器配置id
        buffer2_conf_id 7 : integer     # 右缓冲器配置id

        .pachinko_task {
            quests 0 : *quest()      # 未领奖且有进度的任务
            finishs 1 : *finishs()   # 已领奖任务
        }
        tasks 8 : pachinko_task         # 任务数据
    }
}

