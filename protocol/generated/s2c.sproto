notify_alliance_triangle_war_info 15961 {	# 同步联盟跨服战信息
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        .set {
            i 0 : integer			# 时间段索引号
            b 1 : boolean
        }
        .vote_info {
            uid 0 : integer			# 玩家id
            index 1 : *set() 		# 时间段索引号
        }
        vote 0 : *vote_info()		# 投票信息
        is_notice 1 : boolean		# 是否发过投票通知
        sign_indexes 2 : *integer 			# 报名的时间段索引号
        .fight_info {
            uid 0 : integer			# 玩家id
            v 1 : boolean			# 标识(无用)
        }
        can_sign 3 : boolean		# 是否能报名

        state 4 : integer # 活动状态 1=投票, 2=报名, 3=匹配, 4=战斗
        state_begin_ts 5 : integer # 状态开始时间
        state_end_ts 6 : integer # 状态结束时间

        match_res_avaiable 7 : boolean # 存在匹配结果

        .legion_info {
            sign_indexes 0 : *integer 			# 报名的时间段索引号
            fights 1 : *fight_info()			# 参战成员
            substitutes 2 : *fight_info()	# 替补成员
            ask_for_battle 3 : *set()	# 请战玩家
            warzone_starttime 4 : integer # 战场开启时间
            warzone_endtime 5: integer # 战场结束时间
            fight_index 6 : integer          # 最终参赛的时间段索引号
            match_count 7 : integer			# 匹配时队伍的人数
			forbid_for_battle 8 : *set()	# 不参战玩家
            commanders 9 : *triangle_war_commander_info(slot_id)  # 指挥官列表 
        }
        .map_legions {
            id 0 : integer					# 军团id
            info 1 : legion_info
        }
        legions 8 : *map_legions()
        login_count 9 : integer			# 每周登入人数

        kingdom_phase 10 : integer
    }
}



notify_truck_escort_info 16461 {
    request {  # 只读数据请勿修改!;插入key需符合命名规范[__client_xxx];
        base 0 : activity_base          # 活动通用数据
        plunder_count 1 : integer       # 掠夺次数
        count_refresh_stage 2 : integer   # 上次刷新的阶段
        truck_infos 3 : *truck_escort_truck_info(slot_id) # 货车列表
        group_id 4 : integer            # 组id
        send_truck_info 5 : truck_escort_send_truck_info # 已发车信息
        .enemy_pair {
            uid 0 : integer
            info 1 : truck_enemy
        }
        enemy 6 : *enemy_pair()              # 仇人
        assist_info 7 : truck_assist_info    # 援助信息
        last_refresh_list 8 : integer(0)
        group_kids 9 : *integer                 # 分组的王国
        exist_assist 10 : boolean   # 是否发布过协助部队 true时表示发布过
        is_finish_refresh_quality_guide 11 : boolean   # 是否已完成刷新品质引导
        assisting_issued 12 : boolean # 是否发布过协助部队
        last_plunder_time 13 : integer(0)       # 上次掠夺失败时间
        last_refresh_enemy_list 14 : integer(0)   # 上次刷新仇人时间
        .redpoint_info {
            uid 0 : integer
            truck_id 1 : integer(0)
        }
        redpoint_info 15 : *redpoint_info # 货车红点信息
        expert_total_take_truck_reward_count 16 : integer   # 专家累计的货车领奖次数
        expert_refresh_quality_count 17 : integer           # 专家累计的可刷新红车次数
    }
}

